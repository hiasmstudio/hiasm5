{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "qt69-native-debug",
            "displayName": "HiAsm Qt 6.9 Debug (LLVM-MinGW)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Windows_LLVM-MinGW-x64-Debug",
            "cacheVariables": {
                "HIASM_BUILD_RTCG_ONLY": "OFF",
                "BUILD_TESTING": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "C:/Qt/Tools/llvm-mingw1706_64/bin/clang++.exe",
                "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/Ninja/ninja.exe",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.9.3/llvm-mingw_64",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "environment": {
                "PATH": "C:/Qt/6.9.3/llvm-mingw_64/bin;C:/Qt/Tools/llvm-mingw1706_64/bin;C:/Qt/Tools/Ninja;$penv{PATH}"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "qt69-native-release",
            "displayName": "HiAsm Qt 6.9 Release (LLVM-MinGW)",
            "inherits": "qt69-native-debug",
            "binaryDir": "${sourceDir}/build/Windows_LLVM-MinGW-x64-Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "qt69-native-debug",
            "configurePreset": "qt69-native-debug"
        },
        {
            "name": "qt69-native-release",
            "configurePreset": "qt69-native-release"
        }
    ],
    "testPresets": [
        {
            "name": "qt69-native-debug",
            "configurePreset": "qt69-native-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "qt69-native-release",
            "inherits": "qt69-native-debug",
            "configurePreset": "qt69-native-release"
        }
    ]
}
