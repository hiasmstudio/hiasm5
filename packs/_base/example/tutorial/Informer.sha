Make(cpp)
Add(InfoTip,900,24,18)
{
 @Width=680
 @Height=145
 Info=#17:Пояснения и вывод|0:|120:InfoTip оформляет схему в редакторе и не генерирует исполняемый код. Print выводит информационное сообщение при запуске.|
 HAlign=0
 Margin=12
}
Add(Entry,1,42,196)
{
 link(onStart,2:doPrint,[])
}
Add(Print,2,196,196)
{
 Text=information
}
