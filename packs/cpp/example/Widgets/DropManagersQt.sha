Make(cpp)
Add(MainForm,1,28,28)
{
 Backend=1
 Caption="Drop text or files"
 Width=400
 Height=220
 link(onCreate,4:doListen,[])
}
Add(Label,2,224,84)
{
 Name="textTarget"
 Hint="Drop plain text here"
 HintManager="dropHints"
 Left=16
 Top=16
 Width=360
 Height=55
 AutoSize=1
 Caption="Drop text here"
}
Add(Label,3,224,140)
{
 Name="fileTarget"
 Hint="Enable file drops first"
 HintManager="fileHints"
 Left=16
 Top=78
 Width=360
 Height=55
 AutoSize=1
 Caption="Drop a file here"
}
Add(DropTextManager,4,112,84)
{
 ControlManager="textTarget"
 link(onDrop,2:doText,[])
}
Add(DropFileManager,5,112,140)
{
 ControlManager="fileTarget"
 link(onDrop,3:doText,[])
}
Add(Button,6,28,140)
{
 Left=16
 Top=145
 Width=165
 Height=28
 Caption="Enable file drops"
 link(onClick,5:doListen,[])
}
Add(HintManager,7,224,196)
{
 Name="dropHints"
 HintDelay=120
 HintMargin=4
}
Add(UserHintManager,8,112,196)
{
 Name="fileHints"
 link(onShow,9:doText,[])
}
Add(Label,9,224,252)
{
 Left=16
 Top=181
 Width=360
 Height=24
 AutoSize=1
 Caption="Hover over the file area for a hint"
}
