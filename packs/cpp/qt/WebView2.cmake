function(hiasm_webview2 target)
    if(DEFINED ENV{HIASM_WEBVIEW2_SDK_DIR} AND NOT "$ENV{HIASM_WEBVIEW2_SDK_DIR}" STREQUAL "")
        file(TO_CMAKE_PATH "$ENV{HIASM_WEBVIEW2_SDK_DIR}" sdk)
    else()
        set(version "1.0.3650.58")
        set(cache "${HIASM_WEBVIEW2_CACHE}/webview2-${version}")
        if(NOT HIASM_WEBVIEW2_CACHE)
            set(cache "${CMAKE_CURRENT_BINARY_DIR}/webview2-${version}")
        endif()
        set(sdk "${cache}/sdk")
        file(MAKE_DIRECTORY "${cache}")
        file(LOCK "${cache}/lock" GUARD FUNCTION TIMEOUT 180)
        if(NOT EXISTS "${cache}/ready")
            set(archive "${cache}/sdk.nupkg")
            file(DOWNLOAD
                "https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/${version}/microsoft.web.webview2.${version}.nupkg"
                "${archive}" TLS_VERIFY ON TIMEOUT 90
                EXPECTED_HASH SHA256=911a472128c82ac8baa0c486c23342cc9dd6e7dc50d754e676726642ca065c60)
            file(MAKE_DIRECTORY "${sdk}")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${sdk}")
            file(TOUCH "${cache}/ready")
        endif()
    endif()

    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^([Aa][Rr][Mm]64|aarch64)$")
        set(arch arm64)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(arch x64)
    else()
        set(arch x86)
    endif()
    set(native "${sdk}/build/native")
    set(loader "${native}/${arch}/WebView2Loader.dll")
    if(NOT EXISTS "${native}/include/WebView2.h" OR NOT EXISTS "${loader}")
        message(FATAL_ERROR "WebView2 SDK is incomplete. HIASM_WEBVIEW2_SDK_DIR must name the extracted NuGet package.")
    endif()
    target_include_directories(${target} SYSTEM PRIVATE "${native}/include")
    target_link_libraries(${target} PRIVATE ole32 shlwapi uuid)
    if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND NOT MSVC)
        target_compile_options(${target} PRIVATE -fms-extensions)
    endif()
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${loader}" "$<TARGET_FILE_DIR:${target}>"
        VERBATIM)
endfunction()
