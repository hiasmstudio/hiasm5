func doStart
  if(is_qt_project())
    qtSplitter()
  end
end

func DockSide(align)
  switch(align)
    case 'caLeft': return(1)
    case 'caTop': return(2)
    case 'caRight': return(3)
    case 'caBottom': return(4)
    case 'caClient': return(5)
  end
  return(0)
end

func qtSplitter
  println('{')
  qtSplitterClass()
  println('auto *splitter = new Splitter(widgetParent, ', DockSide(get('Align')), ', ', get('Beveled') == 0, ');')
  println('splitter->setObjectName(QStringLiteral("Splitter', _id_, '"));')
  println('splitter->setGeometry(', Left, ', ', Top, ', ', Width, ', ', Height, ');')
  if(isndef(Color))
    println('if (const auto color = QColor::fromString(qt_text(', cstr(d('Color')), ')); color.isValid()) {')
    println('  auto palette = splitter->palette();')
    println('  palette.setColor(QPalette::Window, color);')
    println('  splitter->setPalette(palette);')
    println('}')
  end
  println('splitter->setEnabled(', get('Enabled') == 'True', ');')
  if(get('Visible') == 'False')
    println('splitter->hide();')
  end
  if(isndef(Hint))
    println('splitter->setToolTip(qt_text(', cstr(d('Hint')), '));')
  end
  qtSplitterSiblings()
  println('QTimer::singleShot(0, splitter, [splitter] { splitter->dock(); });')
  println('}')
end

// Read alignment from the scheme because the other Qt templates use absolute geometry.
func qtSplitterSiblings
  fvar(layer, i, sibling, align)
  // RTCG only exposes properties of initialized elements. Initialize this
  // layer without calling doStart again or loading transparent containers.
  sys.run_all('splitterMetadata')
  layer = this.parent
  for(i = 0; i < layer.numelements; i++)
    sibling = layer.child(i)
    if(len(sibling.name) > 0 and sibling.name != 'MainForm')
      align = string(sibling.props('Align'))
      if(align == 'caNone' or DockSide(align) > 0)
        println('splitter->siblings.append({QStringLiteral("', sibling.codename, '"), ', DockSide(align), '});')
      end
    end
  end
end

// KOL uses live resizing for all three values of ResizeStyle.
func qtSplitterClass
  println('class Splitter : public QWidget {')
  println('public:')
  println('  enum Side { None, Left, Top, Right, Bottom, Client };')
  println('  struct Sibling { QString name; int side; };')
  println('  QList<Sibling> siblings;')
  println('  Splitter(QWidget *parent, int alignment, bool beveled)')
  println('    : QWidget(parent), side(alignment), bevel(beveled) {')
  println('    setCursor(verticalDrag() ? Qt::SizeVerCursor : Qt::SizeHorCursor);')
  println('    parent->installEventFilter(this);')
  println('  }')
  println('  void dock() {')
  println('    QRect rest = parentWidget()->contentsRect();')
  println('    // KOL docks top/bottom first, then left/right, then client controls.')
  println('    for (int pass = 0; pass < 3; ++pass) {')
  println('      for (const auto &entry : siblings) {')
  println('        if (entry.side == None || pass != dockPass(entry.side)) continue;')
  println('        auto *widget = findSibling(entry.name);')
  println('        if (!widget || widget->isHidden()) continue;')
  println('        QRect area = rest;')
  println('        switch (entry.side) {')
  println('        case Top: area.setHeight(widget->height()); rest.setTop(area.bottom() + 1); break;')
  println('        case Bottom: area.setTop(rest.bottom() - widget->height() + 1); rest.setBottom(area.top() - 1); break;')
  println('        case Left: area.setWidth(widget->width()); rest.setLeft(area.right() + 1); break;')
  println('        case Right: area.setLeft(rest.right() - widget->width() + 1); rest.setRight(area.left() - 1); break;')
  println('        }')
  println('        widget->setGeometry(area.x(), area.y(), qMax(0, area.width()), qMax(0, area.height()));')
  println('      }')
  println('    }')
  println('  }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    painter.fillRect(rect(), palette().window());')
  println('    if (bevel) qDrawShadeRect(&painter, rect(), palette(), true);')
  println('  }')
  println('  void mousePressEvent(QMouseEvent *event) override {')
  println('    if (event->button() != Qt::LeftButton) { event->ignore(); return; }')
  println('    // NewSplitter uses the previous control, or itself if first.')
  println('    targetName = objectName();')
  println('    for (const auto &entry : siblings) {')
  println('      if (entry.name == objectName()) break;')
  println('      if (findSibling(entry.name)) targetName = entry.name;')
  println('    }')
  println('    auto *target = findSibling(targetName);')
  println('    if (!target || target->isHidden()) return;')
  println('    startPosition = axisPosition(event->globalPosition().toPoint());')
  println('    startSize = axisSize(target);')
  println('    dragging = true;')
  println('    qApp->installEventFilter(this);')
  println('  }')
  println('  void mouseMoveEvent(QMouseEvent *event) override {')
  println('    if (!dragging) return;')
  println('    int delta = axisPosition(event->globalPosition().toPoint()) - startPosition;')
  println('    if (side == Right || side == Bottom) delta = -delta;')
  println('    const auto *target = findSibling(targetName);')
  println('    if (!target) { finishDrag(); return; }')
  println('    int available = axisSize(parentWidget());')
  println('    for (const auto &entry : siblings) {')
  println('      if (entry.side == None || entry.side == Client || dockPass(entry.side) != (verticalDrag() ? 0 : 1)) continue;')
  println('      const auto *other = findSibling(entry.name);')
  println('      if (other && other != target && !other->isHidden()) available -= axisSize(other);')
  println('    }')
  println('    if (target != this && (side == None || side == Client)) available -= axisSize(this);')
  println('    resizeTarget(qBound(0, startSize + delta, qMax(0, available)));')
  println('  }')
  println('  void mouseReleaseEvent(QMouseEvent *event) override {')
  println('    if (event->button() == Qt::LeftButton) finishDrag();')
  println('    else event->ignore();')
  println('  }')
  println('  bool eventFilter(QObject *watched, QEvent *event) override {')
  println('    if (dragging && event->type() == QEvent::KeyPress && static_cast<QKeyEvent *>(event)->key() == Qt::Key_Escape) {')
  println('      resizeTarget(startSize);')
  println('      finishDrag();')
  println('      return true;')
  println('    }')
  println('    if (dragging && ((watched == this && (event->type() == QEvent::Hide || event->type() == QEvent::UngrabMouse)) ||')
  println('                     (watched == window() && event->type() == QEvent::WindowDeactivate))) finishDrag();')
  println('    if (watched == parentWidget() && (event->type() == QEvent::Resize || event->type() == QEvent::Show)) dock();')
  println('    return QWidget::eventFilter(watched, event);')
  println('  }')
  println('private:')
  println('  int side;')
  println('  bool bevel, dragging = false;')
  println('  QString targetName;')
  println('  int startPosition = 0, startSize = 0;')
  println('  bool verticalDrag() const { return side == Top || side == Bottom; }')
  println('  int axisSize(const QWidget *widget) const { return verticalDrag() ? widget->height() : widget->width(); }')
  println('  int axisPosition(QPoint point) const { return verticalDrag() ? point.y() : point.x(); }')
  println('  static int dockPass(int alignment) { return alignment == Top || alignment == Bottom ? 0 : alignment == Client ? 2 : 1; }')
  println('  QWidget *findSibling(const QString &name) const {')
  println('    return parentWidget()->findChild<QWidget *>(name, Qt::FindDirectChildrenOnly);')
  println('  }')
  println('  void resizeTarget(int extent) {')
  println('    if (auto *target = findSibling(targetName)) {')
  println('      if (verticalDrag()) target->resize(target->width(), extent);')
  println('      else target->resize(extent, target->height());')
  println('      dock();')
  println('    }')
  println('  }')
  println('  void finishDrag() {')
  println('    if (!dragging) return;')
  println('    dragging = false;')
  println('    qApp->removeEventFilter(this);')
  println('  }')
  println('};')
end
