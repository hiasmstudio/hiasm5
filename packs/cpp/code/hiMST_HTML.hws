include('qtMstClient')

func HTMLTab()
  return('form.property("mstHtml' && _id_ && '").toString()')
end

func doTabToHTML(_data)
  MstBegin()
  println('QString html = QStringLiteral("<!doctype html><meta charset=\"utf-8\">");')
  println('const auto title = qt_text(', cstr(get('TitleText')), ');')
  println('const auto note = qt_text(', cstr(get('NoteText')), ');')
  println('if (!title.isEmpty()) html += QStringLiteral("<h2>") + title.toHtmlEscaped() + QStringLiteral("</h2>");')
  println('html += QStringLiteral("<table style=\"border-collapse:collapse;border:%1px solid %2\">")')
  println('    .arg(qMax(0, int(', TabBorderWeight, '))).arg(qt_led_color(qt_text(', cstr(get('TabBorderColor')), '), Qt::black).name());')
  println('html += QStringLiteral("<thead><tr>");')
  println('for (int column = 0; column < ', MstLocal(), '->columnCount(); ++column) {')
  println('  const auto *header = ', MstLocal(), '->horizontalHeaderItem(column);')
  println('  html += QStringLiteral("<th>") + (header ? header->text().toHtmlEscaped() : QString()) + QStringLiteral("</th>");')
  println('}')
  println('html += QStringLiteral("</tr></thead><tbody>");')
  println('for (int row = 0; row < ', MstLocal(), '->rowCount(); ++row) {')
  println('  html += QStringLiteral("<tr>");')
  println('  for (int column = 0; column < ', MstLocal(), '->columnCount(); ++column)')
  println('    html += QStringLiteral("<td>") + ', MstLocal(), '->text(row, column).toHtmlEscaped() + QStringLiteral("</td>");')
  println('  html += QStringLiteral("</tr>");')
  println('}')
  println('html += QStringLiteral("</tbody></table>");')
  println('if (!note.isEmpty()) html += QStringLiteral("<p>") + note.toHtmlEscaped() + QStringLiteral("</p>");')
  println('form.setProperty("mstHtml', _id_, '", html);')
  event(onTabToHTML, 'html')
  println('}')
end
