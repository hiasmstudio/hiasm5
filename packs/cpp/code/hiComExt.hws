func doStart
  block.reg("result")
  block.select("result")
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#endif')
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  if(TargetPlatform > 1)
    println('#error "ComExt is a Windows-only project type; select the Windows target"')
  end
  println('#include <windows.h>')
  println('#include <cwchar>')
  println('')
  println('static const char *hiasm_clsid = ', ClassId, ';')
  println('static const char *hiasm_description = ', Description, ';')
  println('')
  println('static HINSTANCE hiasm_module = NULL;')
  println('static std::wstring hiasm_widen(const char *value)')
  println('{')
  println('  if(!value) return std::wstring();')
  println('  int length = MultiByteToWideChar(CP_UTF8, 0, value, -1, NULL, 0);')
  println('  if(length <= 1) return std::wstring();')
  println('  std::vector<wchar_t> result(static_cast<size_t>(length));')
  println('  MultiByteToWideChar(CP_UTF8, 0, value, -1, result.data(), length);')
  println('  return std::wstring(result.data(), static_cast<size_t>(length - 1));')
  println('}')
  println('')
  println('extern "C" __declspec(dllexport) HRESULT __stdcall DllGetClassObject(REFCLSID clsid, REFIID iid, void **object)')
  println('{')
  println('  (void)clsid; (void)iid;')
  println('  if(object) *object = NULL;')
  println('  return CLASS_E_CLASSNOTAVAILABLE;')
  println('}')
  println('')
  println('extern "C" __declspec(dllexport) HRESULT __stdcall DllCanUnloadNow(void)')
  println('{')
  println('  return S_OK;')
  println('}')
  println('')
  println('extern "C" __declspec(dllexport) HRESULT __stdcall DllRegisterServer(void)')
  println('{')
  println('  std::wstring clsid = hiasm_widen(hiasm_clsid);')
  println('  std::wstring description = hiasm_widen(hiasm_description);')
  println('  std::wstring base = L"CLSID\\\\" + clsid;')
  println('  HKEY key = NULL;')
  println('  if(RegCreateKeyExW(HKEY_CLASSES_ROOT, base.c_str(), 0, NULL, 0, KEY_WRITE, NULL, &key, NULL) != ERROR_SUCCESS) return E_FAIL;')
  println('  RegSetValueExW(key, NULL, 0, REG_SZ, reinterpret_cast<const BYTE *>(description.c_str()), static_cast<DWORD>((description.size() + 1) * sizeof(wchar_t)));')
  println('  RegCloseKey(key);')
  println('  std::wstring inproc = base + L"\\\\InprocServer32";')
  println('  if(RegCreateKeyExW(HKEY_CLASSES_ROOT, inproc.c_str(), 0, NULL, 0, KEY_WRITE, NULL, &key, NULL) != ERROR_SUCCESS) return E_FAIL;')
  println('  wchar_t module[1024] = {};')
  println('  // The server path is the DLL that contains this object, not the host program.')
  println('  GetModuleFileNameW(hiasm_module, module, 1024);')
  println('  RegSetValueExW(key, NULL, 0, REG_SZ, reinterpret_cast<const BYTE *>(module), static_cast<DWORD>((wcslen(module) + 1) * sizeof(wchar_t)));')
  println('  const wchar_t *threading = L"Apartment";')
  println('  RegSetValueExW(key, L"ThreadingModel", 0, REG_SZ, reinterpret_cast<const BYTE *>(threading), static_cast<DWORD>((wcslen(threading) + 1) * sizeof(wchar_t)));')
  println('  RegCloseKey(key);')
  println('  return S_OK;')
  println('}')
  println('')
  println('extern "C" __declspec(dllexport) HRESULT __stdcall DllUnregisterServer(void)')
  println('{')
  println('  std::wstring base = L"CLSID\\\\" + hiasm_widen(hiasm_clsid);')
  println('  std::wstring inproc = base + L"\\\\InprocServer32";')
  println('  RegDeleteKeyW(HKEY_CLASSES_ROOT, inproc.c_str());')
  println('  RegDeleteKeyW(HKEY_CLASSES_ROOT, base.c_str());')
  println('  return S_OK;')
  println('}')
  println('')
  println('BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved)')
  println('{')
  println('  (void)reserved;')
  println('  if(reason == DLL_PROCESS_ATTACH) { hiasm_module = instance; DisableThreadLibraryCalls(instance); }')
  println('  return TRUE;')
  println('}')
end
