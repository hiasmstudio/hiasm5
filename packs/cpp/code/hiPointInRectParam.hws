func Arg(name, fallback)
  if(linked(name))
    return(d(name))
  else
    return(cstr(fallback))
  end
end

func Offset()
  if(get('Point2AsOffset') == "True")
    return(1)
  else
    return(0)
  end
end

func doCheck(_data)
  println('{')
  block.inclvl()
  println('const int hiasm_px', _id_, ' = static_cast<int>(', Arg('X', get('X')), ');')
  println('const int hiasm_py', _id_, ' = static_cast<int>(', Arg('Y', get('Y')), ');')
  println('const std::string hiasm_list', _id_, ' = std::string(', Arg('Parameters', get('Parameters')), ');')
  println('const char hiasm_delim', _id_, ' = std::string(', cstr(get('Delimiter')), ').empty() ? static_cast<char>(44) : std::string(', cstr(get('Delimiter')), ')[0];')
  println('const int hiasm_offset', _id_, ' = ', Offset(), ';')
  println('int hiasm_idx', _id_, ' = -1;')
  println('int hiasm_line', _id_, ' = 0;')
  println('std::size_t hiasm_start', _id_, ' = 0;')
  println('while(hiasm_start', _id_, ' <= hiasm_list', _id_, '.size()) {')
  block.inclvl()
  println('const std::size_t hiasm_nl', _id_, ' = hiasm_list', _id_, '.find(static_cast<char>(10), hiasm_start', _id_, ');')
  println('std::string hiasm_text', _id_, ' = hiasm_list', _id_, '.substr(hiasm_start', _id_, ', hiasm_nl', _id_, ' == std::string::npos ? std::string::npos : hiasm_nl', _id_, ' - hiasm_start', _id_, ');')
  println('if(!hiasm_text', _id_, '.empty() && hiasm_text', _id_, '.back() == static_cast<char>(13)) hiasm_text', _id_, '.pop_back();')
  println('std::vector<int> hiasm_nums', _id_, ';')
  println('std::size_t hiasm_pos', _id_, ' = 0;')
  println('while(hiasm_pos', _id_, ' <= hiasm_text', _id_, '.size()) {')
  block.inclvl()
  println('const std::size_t hiasm_found', _id_, ' = hiasm_text', _id_, '.find(hiasm_delim', _id_, ', hiasm_pos', _id_, ');')
  println('const std::string hiasm_token', _id_, ' = hiasm_text', _id_, '.substr(hiasm_pos', _id_, ', hiasm_found', _id_, ' == std::string::npos ? std::string::npos : hiasm_found', _id_, ' - hiasm_pos', _id_, ');')
  println('if(!hiasm_token', _id_, '.empty()) hiasm_nums', _id_, '.push_back(std::atoi(hiasm_token', _id_, '.c_str()));')
  println('if(hiasm_found', _id_, ' == std::string::npos) break;')
  println('hiasm_pos', _id_, ' = hiasm_found', _id_, ' + 1;')
  block.declvl()
  println('}')
  println('if(hiasm_nums', _id_, '.size() >= 4) {')
  block.inclvl()
  println('int hiasm_x1', _id_, ' = hiasm_nums', _id_, '[0];')
  println('int hiasm_y1', _id_, ' = hiasm_nums', _id_, '[1];')
  println('int hiasm_x2', _id_, ' = hiasm_nums', _id_, '[2];')
  println('int hiasm_y2', _id_, ' = hiasm_nums', _id_, '[3];')
  println('if(hiasm_offset', _id_, ') { hiasm_x2', _id_, ' += hiasm_x1', _id_, '; hiasm_y2', _id_, ' += hiasm_y1', _id_, '; }')
  println('if(hiasm_px', _id_, ' >= hiasm_x1', _id_, ' && hiasm_px', _id_, ' <= hiasm_x2', _id_, ' && hiasm_py', _id_, ' >= hiasm_y1', _id_, ' && hiasm_py', _id_, ' <= hiasm_y2', _id_, ') { hiasm_idx', _id_, ' = hiasm_line', _id_, '; break; }')
  block.declvl()
  println('}')
  println('if(hiasm_nl', _id_, ' == std::string::npos) break;')
  println('hiasm_start', _id_, ' = hiasm_nl', _id_, ' + 1;')
  println('++hiasm_line', _id_, ';')
  block.declvl()
  println('}')
  println('hiasm_int_state(', _id_, ' * 10 + 1, -1) = hiasm_idx', _id_, ';')
  println('hiasm_str_state(', _id_, ' * 10 + 2) = hiasm_list', _id_, ';')
  println('if(hiasm_idx', _id_, ' >= 0) {')
  block.inclvl()
  event(onTrue, 'hiasm_idx' && _id_)
  block.declvl()
  println('} else {')
  block.inclvl()
  event(onFalse)
  block.declvl()
  println('}')
  block.declvl()
  println('}')
end

func IdxParam()
  return('hiasm_int_state(' && _id_ && ' * 10 + 1, -1)')
end

func TextParam()
  return('hiasm_str_state(' && _id_ && ' * 10 + 2)')
end
