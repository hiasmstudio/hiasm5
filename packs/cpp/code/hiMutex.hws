func Name()
  if(linked('Name'))
    return(d('Name'))
  else
    return(cstr(get('Name')))
  end
end

func Handle()
  return('reinterpret_cast<HANDLE>(static_cast<intptr_t>(hiasm_ll_state(' && _id_ && ', 0)))')
end

func Guard()
  println('#if !defined(_WIN32)')
  println('#error "Mutex is a Windows-only element"')
  println('#endif')
end

func doCreateMutex(_data)
  Guard()
  println('{')
  block.inclvl()
  println('HANDLE hiasm_mutex', _id_, ' = CreateMutexA(NULL, FALSE, std::string(', Name(), ').c_str());')
  println('const DWORD hiasm_err', _id_, ' = GetLastError();')
  println('if(!hiasm_mutex', _id_, ') {')
  block.inclvl()
  event(onError, 'static_cast<int>(hiasm_err' && _id_ && ')')
  block.declvl()
  println('} else {')
  block.inclvl()
  println('hiasm_ll_state(', _id_, ', 0) = static_cast<long long>(reinterpret_cast<intptr_t>(hiasm_mutex', _id_, '));')
  println('if(hiasm_err', _id_, ' == ERROR_ALREADY_EXISTS) {')
  block.inclvl()
  event(onAlreadyExists)
  block.declvl()
  println('} else {')
  block.inclvl()
  event(onCreated)
  block.declvl()
  println('}')
  block.declvl()
  println('}')
  block.declvl()
  println('}')
end

func doCreateAndRelease(_data)
  Guard()
  println('{')
  block.inclvl()
  println('HANDLE hiasm_mutex', _id_, ' = CreateMutexA(NULL, FALSE, std::string(', Name(), ').c_str());')
  println('if(hiasm_mutex', _id_, ') {')
  block.inclvl()
  event(onCreated)
  println('ReleaseMutex(hiasm_mutex', _id_, ');')
  println('CloseHandle(hiasm_mutex', _id_, ');')
  event(onReleased)
  block.declvl()
  println('} else {')
  block.inclvl()
  event(onError, 'static_cast<int>(GetLastError())')
  block.declvl()
  println('}')
  block.declvl()
  println('}')
end

func doReleaseMutex(_data)
  Guard()
  println('{')
  block.inclvl()
  println('HANDLE hiasm_mutex', _id_, ' = ', Handle(), ';')
  println('if(hiasm_mutex', _id_, ') {')
  block.inclvl()
  println('ReleaseMutex(hiasm_mutex', _id_, ');')
  event(onReleased)
  block.declvl()
  println('}')
  block.declvl()
  println('}')
end

func doOpenMutex(_data)
  Guard()
  println('{')
  block.inclvl()
  println('HANDLE hiasm_mutex', _id_, ' = OpenMutexA(SYNCHRONIZE | MUTEX_MODIFY_STATE, FALSE, std::string(', Name(), ').c_str());')
  println('if(hiasm_mutex', _id_, ') {')
  block.inclvl()
  println('hiasm_ll_state(', _id_, ', 0) = static_cast<long long>(reinterpret_cast<intptr_t>(hiasm_mutex', _id_, '));')
  event(onOpened)
  block.declvl()
  println('} else {')
  block.inclvl()
  event(onError, 'static_cast<int>(GetLastError())')
  block.declvl()
  println('}')
  block.declvl()
  println('}')
end
