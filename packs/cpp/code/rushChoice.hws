func RushChoice(kind, widgetType, selected)
  println('{')
  println('auto *choice = new ', widgetType, '(qt_text(', cstr(get('Caption')), '), widgetParent);')
  println('choice->setObjectName(QStringLiteral("', kind, _id_, '"));')
  println('choice->setGeometry(', Left, ', ', Top, ', ', Width, ', ', Height, ');')
  println('choice->setChecked(', selected, ');')
  println('choice->setEnabled(', get('Enabled') == 'True', ');')
  println('choice->setVisible(', get('Visible') == 'True', ');')
  println('choice->setToolTip(qt_text(', cstr(get('Hint')), '));')
  println('choice->transparent = ', get('Transparent') == 'True', ';')
  println('choice->checkMetric = ', CheckMetric, ';')
  println('choice->checkColor = qt_led_color(qt_text(', cstr(get('ColorCheck')), '), Qt::blue);')
  println('choice->textX = 0;')
  println('choice->setSkin(0, {qt_text(', cstr(get('ColorFrom')), '), qt_text(', cstr(get('ColorTo')), '), qt_text(', cstr(get('ColorText')), '), qt_text(', cstr(get('BorderColor')), '), qt_text(', cstr(get('ColorShadow')), '), QString::number(', get('GradientStyle'), '), QString::number(', get('BorderWidth'), '), QString::number(', get('ShadowOffset'), ')});')
  println('choice->setSkin(1, {qt_text(', cstr(get('ColorFromOver')), '), qt_text(', cstr(get('ColorToOver')), '), qt_text(', cstr(get('ColorTextOver')), '), qt_text(', cstr(get('BorderColorOver')), '), qt_text(', cstr(get('ColorShadowOver')), '), QString::number(', get('GradientStyleOver'), '), QString::number(', get('BorderWidthOver'), '), QString::number(', get('ShadowOffsetOver'), ')});')
  println('choice->setSkin(2, {qt_text(', cstr(get('ColorFromDown')), '), qt_text(', cstr(get('ColorToDown')), '), qt_text(', cstr(get('ColorTextDown')), '), qt_text(', cstr(get('BorderColorDown')), '), qt_text(', cstr(get('ColorShadowDown')), '), QString::number(', get('GradientStyleDown'), '), QString::number(', get('BorderWidthDown'), '), QString::number(', get('ShadowOffsetDown'), ')});')
  println('choice->setSkin(3, {qt_text(', cstr(get('ColorFromDis')), '), qt_text(', cstr(get('ColorToDis')), '), qt_text(', cstr(get('ColorTextDis')), '), qt_text(', cstr(get('BorderColorDis')), '), qt_text(', cstr(get('ColorShadowDis')), '), QString::number(', get('GradientStyleDis'), '), QString::number(', get('BorderWidthDis'), '), QString::number(', get('ShadowOffsetDis'), ')});')
end

func RushBool(value)
  if(len(value) > 0)
    return('([](auto input) { if constexpr (std::is_integral_v<decltype(input)>) return input != 0; else return true; }(' && value && '))')
  end
  return('true')
end
