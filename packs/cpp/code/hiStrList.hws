func Lines()
  return(split(get('Strings'), "\n"))
end

func Init()
  fvar(parts, i, items)
  parts = Lines()
  items = ''
  i = 0
  while(i < parts.size())
    if(i > 0)
      items = items && ', '
    end
    items = items && cstr(parts.get(i))
    i = i + 1
  end
  println('hiasm_list_init(', _id_, ', {', items, '});')
end

func Front()
  if(get('AddType') == 1)
    return(1)
  else
    return(0)
  end
end

func doAdd(_data)
  Init()
  if(Front() == 1)
    println('hiasm_list_ref(', _id_, ').insert(hiasm_list_ref(', _id_, ').begin(), std::string(', _data, '));')
  else
    println('hiasm_list_ref(', _id_, ').push_back(std::string(', _data, '));')
  end
  println('hiasm_list_ready[', _id_, '] = true;')
end

func doClear(_data)
  Init()
  println('hiasm_list_ref(', _id_, ').clear();')
  println('hiasm_list_ready[', _id_, '] = true;')
end

func doDelete(_data)
  Init()
  println('{')
  block.inclvl()
  println('const int hiasm_idx', _id_, ' = static_cast<int>(', _data, ');')
  println('if(hiasm_idx', _id_, ' >= 0 && hiasm_idx', _id_, ' < static_cast<int>(hiasm_list_ref(', _id_, ').size())) hiasm_list_ref(', _id_, ').erase(hiasm_list_ref(', _id_, ').begin() + hiasm_idx', _id_, ');')
  block.declvl()
  println('}')
end

func doText(_data)
  println('{')
  block.inclvl()
  println('std::string hiasm_text', _id_, ' = std::string(', _data, ');')
  println('std::vector<std::string> &hiasm_lines', _id_, ' = hiasm_list_ref(', _id_, ');')
  println('hiasm_lines', _id_, '.clear();')
  println('std::size_t hiasm_pos', _id_, ' = 0;')
  println('while((hiasm_pos', _id_, ' = hiasm_text', _id_, '.find(static_cast<char>(10))) != std::string::npos) {')
  block.inclvl()
  println('hiasm_lines', _id_, '.push_back(hiasm_text', _id_, '.substr(0, hiasm_pos', _id_, '));')
  println('hiasm_text', _id_, '.erase(0, hiasm_pos', _id_, ' + 1);')
  block.declvl()
  println('}')
  println('if(!hiasm_text', _id_, '.empty()) hiasm_lines', _id_, '.push_back(hiasm_text', _id_, ');')
  println('hiasm_list_ready[', _id_, '] = true;')
  block.declvl()
  println('}')
end

func doLoad(_data)
  println('{')
  block.inclvl()
  println('std::ifstream hiasm_file', _id_, '(std::string(', cstr(get('FileName')), '));')
  println('std::vector<std::string> &hiasm_lines', _id_, ' = hiasm_list_ref(', _id_, ');')
  println('hiasm_lines', _id_, '.clear();')
  println('std::string hiasm_line', _id_, ';')
  println('while(std::getline(hiasm_file', _id_, ', hiasm_line', _id_, ')) hiasm_lines', _id_, '.push_back(hiasm_line', _id_, ');')
  println('hiasm_list_ready[', _id_, '] = true;')
  block.declvl()
  println('}')
end

func doSave(_data)
  Init()
  println('{')
  block.inclvl()
  println('std::ofstream hiasm_file', _id_, '(std::string(', cstr(get('FileName')), '));')
  println('for(const std::string &hiasm_line', _id_, ' : hiasm_list_ref(', _id_, ')) hiasm_file', _id_, ' << hiasm_line', _id_, ' << static_cast<char>(10);')
  block.declvl()
  println('}')
end

func doAppend(_data)
  println('{')
  block.inclvl()
  println('std::ofstream hiasm_file', _id_, '(std::string(', cstr(get('FileName')), '), std::ios::app);')
  println('for(const std::string &hiasm_line', _id_, ' : hiasm_list_ref(', _id_, ')) hiasm_file', _id_, ' << hiasm_line', _id_, ' << static_cast<char>(10);')
  block.declvl()
  println('}')
end

func doSort(_data)
  Init()
  println('std::sort(hiasm_list_ref(', _id_, ').begin(), hiasm_list_ref(', _id_, ').end());')
end

func doInsert(_data)
  Init()
  println('hiasm_list_ref(', _id_, ').insert(hiasm_list_ref(', _id_, ').begin(), std::string(', _data, '));')
end

func doReplace(_data)
  Init()
  println('if(!hiasm_list_ref(', _id_, ').empty()) hiasm_list_ref(', _id_, ')[0] = std::string(', _data, ');')
end

func doMove(_data)
  println('/* move is not supported for a plain string list */')
end

func doSwap(_data)
  println('/* swap is not supported for a plain string list */')
end
