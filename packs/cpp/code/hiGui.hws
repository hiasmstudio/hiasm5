  println('static bool hiasm_is_number(const std::string &s)')
  println('{')
  println('  bool hsd_digit = false;')
  println('  for(std::size_t i = 0; i < s.size(); ++i) {')
  println('    char c = s[i];')
  println('    if(c == 32 || c == 9 || c == 10 || c == 13) continue;')
  println('    if((c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46) { hsd_digit = true; continue; }')
  println('    return false;')
  println('  }')
  println('  return hsd_digit;')
  println('}')
