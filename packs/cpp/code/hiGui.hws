  println('    double da = std::atof(a.c_str()), db = std::atof(b.c_str());')
  println('    return da < db ? -1 : (da > db ? 1 : 0);')
  println('  }')
  println('  if(a < b) return -1;')
  println('  if(a > b) return 1;')
  println('  return 0;')
