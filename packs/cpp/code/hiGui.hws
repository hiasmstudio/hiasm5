  println('static void hiasm_message_response(GtkDialog *dialog, int response, gpointer data)')
  println('{')
  println('  *static_cast<int*>(data) = response;')
  println('  GMainLoop *loop = static_cast<GMainLoop*>(g_object_get_data(G_OBJECT(dialog), "hiasm-message-loop"));')
  println('  if(loop) g_main_loop_quit(loop);')
  println('}')
  println('')
  println('static int hiasm_message(const char *text, const char *caption, int type, const char *icon)')
  println('{')
  println('  (void)icon;')
  println('  GtkButtonsType buttons = GTK_BUTTONS_OK;')
  println('  switch(type) {')
  println('    case 0: buttons = GTK_BUTTONS_NONE; break;')
  println('    case 1: buttons = GTK_BUTTONS_OK; break;')
  println('    case 2: buttons = GTK_BUTTONS_CLOSE; break;')
  println('    case 3: buttons = GTK_BUTTONS_CANCEL; break;')
  println('    case 4: buttons = GTK_BUTTONS_YES_NO; break;')
  println('    case 5: buttons = GTK_BUTTONS_OK_CANCEL; break;')
  println('  }')
  println('  GtkWidget *dialog = gtk_message_dialog_new(NULL, GTK_DIALOG_MODAL, GTK_MESSAGE_INFO, buttons, "%s", text ? text : "");')
  println('  gtk_window_set_title(GTK_WINDOW(dialog), caption ? caption : "");')
  println('  int response = 0;')
  println('  GMainLoop *loop = g_main_loop_new(NULL, FALSE);')
  println('  g_object_set_data(G_OBJECT(dialog), "hiasm-message-loop", loop);')
  println('  g_signal_connect(dialog, "response", G_CALLBACK(hiasm_message_response), &response);')
  println('  gtk_widget_set_visible(dialog, TRUE);')
  println('  g_main_loop_run(loop);')
  println('  gtk_window_destroy(GTK_WINDOW(dialog));')
  println('  g_main_loop_unref(loop);')
  println('  return response;')
  println('}')
  println('')
  println('static int hiasm_message(const char *text, const char *caption)')
  println('{')
  println('  return hiasm_message(text, caption, 1, "");')
  println('}')
  println('')
  println('struct HiasmClipboardState { GMainLoop *loop; std::string text; };')
  println('')
  println('static void hiasm_clipboard_done(GObject *source, GAsyncResult *result, gpointer user_data)')
  println('{')
  println('  HiasmClipboardState *state = static_cast<HiasmClipboardState*>(user_data);')
  println('  GError *error = NULL;')
  println('  char *text = gdk_clipboard_read_text_finish(GDK_CLIPBOARD(source), result, &error);')
  println('  if(text) { state->text = text; g_free(text); }')
  println('  if(error) g_error_free(error);')
  println('  if(state->loop) g_main_loop_quit(state->loop);')
  println('}')
  println('')
  println('static std::string hiasm_clipboard_text()')
  println('{')
  println('  GdkClipboard *clipboard = gdk_display_get_clipboard(gdk_display_get_default());')
  println('  HiasmClipboardState state;')
  println('  state.loop = g_main_loop_new(NULL, FALSE);')
  println('  gdk_clipboard_read_text_async(clipboard, NULL, hiasm_clipboard_done, &state);')
  println('  g_main_loop_run(state.loop);')
  println('  g_main_loop_unref(state.loop);')
  println('  return state.text;')
  println('}')
  println('')
  println('static bool hiasm_mask_match(const char *text, const char *mask, bool caseSensitive)')
  println('{')
  println('  const char *t = text ? text : "";')
  println('  const char *m = mask ? mask : "";')
  println('  while(*m) {')
  println('    if(*m == 42) {')
  println('      while(*m == 42) ++m;')
  println('      if(!*m) return true;')
  println('      for(const char *p = t; ; ++p) {')
  println('        if(hiasm_mask_match(p, m, caseSensitive)) return true;')
  println('        if(!*p) return false;')
  println('      }')
  println('    }')
  println('    if(!*t) return false;')
  println('    if(*m == 63) { ++t; ++m; continue; }')
  println('    if(*m == 35) {')
  println('      if(!std::isdigit(static_cast<unsigned char>(*t))) return false;')
  println('      ++t; ++m; continue;')
  println('    }')
  println('    char a = *t, b = *m;')
  println('    if(!caseSensitive) { a = static_cast<char>(std::tolower(static_cast<unsigned char>(a))); b = static_cast<char>(std::tolower(static_cast<unsigned char>(b))); }')
  println('    if(a != b) return false;')
  println('    ++t; ++m;')
  println('  }')
  println('  return *t == 0;')
  println('}')
  println('')
  println('static void hiasm_apply_frame(GtkWindow *window, int border)')
  println('{')
  println('#if defined(_WIN32)')
  println('  gtk_window_set_titlebar(window, NULL);')
  println('#endif')
  println('  gtk_window_set_decorated(window, border >= 1 && border <= 5);')
  println('  gtk_window_set_resizable(window, border == 2 || border == 5 || border == 7 || border == 9);')
  println('}')
  println('')
  println('static void hiasm_activate(GtkApplication *application, gpointer user_data)')
  println('{')
  block.inclvl()
  println('  (void)user_data;')
  println('#if defined(_WIN32)')
  println('  g_setenv("GTK_CSD", "0", TRUE);')
  println('#endif')
  println('  GtkWidget *window = gtk_application_window_new(application);')
  println('  hiasm_apply_frame(GTK_WINDOW(window), 2);')
  println('  gtk_window_set_title(GTK_WINDOW(window), "HiAsm application");')
  println('  gtk_window_set_default_size(GTK_WINDOW(window), 800, 600);')
  event(onStart)
  println('  gtk_widget_set_visible(window, TRUE);')
  println('  hiasm_form_ready = true;')
  block.declvl()
  println('}')
  println('')
  println('static int hiasm_application_run(int argc, char **argv)')
  println('{')
  println('  GtkApplication *application = gtk_application_new("com.hiasm.gui", G_APPLICATION_DEFAULT_FLAGS);')
  println('  g_signal_connect(application, "activate", G_CALLBACK(hiasm_activate), NULL);')
  println('  int status = g_application_run(G_APPLICATION(application), argc, argv);')
  println('  g_object_unref(application);')
  println('  return status;')
  println('}')
  println('')
  println('#if defined(_WIN32)')
  println('int WINAPI WinMain(HINSTANCE instance, HINSTANCE previous, LPSTR command, int show)')
  println('{')
  println('  (void)instance; (void)previous; (void)command; (void)show;')
  println('  return hiasm_application_run(__argc, __argv);')
  println('}')
  println('#else')
  println('int main(int argc, char **argv)')
  println('{')
  println('  return hiasm_application_run(argc, argv);')
