func Char()
  return(cstr(get('Char')))
end

func From()
  return(get('From'))
end

func RemaindStr()
  return('hiasm_str_state(' && _id_ && ' * 100)')
end

func SplitParts(_data)
  if(get('Direct') == 1)
    return('[](const std::string &s, const std::string &d) { std::vector<std::string> out; auto base = hiasm_str_split(s, d); if(!base.empty()) out.push_back(base.back()); for(std::size_t i = base.size() - 1; i > 0; --i) out.push_back(base[i - 1]); return out; }(std::string(' && _data && '), std::string(' && Char() && '))')
  else
    return('hiasm_str_split(std::string(' && _data && '), std::string(' && Char() && '))')
  end
end

func doSplit(_data)
  println('{')
  block.inclvl()
  println('const auto hiasm_parts', _id_, ' = ', SplitParts(_data), ';')
  println('const int hiasm_from', _id_, ' = std::max(0, ', From(), ');')
  println('std::string hiasm_rest', _id_, ';')
  println('for(std::size_t hiasm_i', _id_, ' = 0; hiasm_i', _id_, ' < hiasm_parts', _id_, '.size(); ++hiasm_i', _id_, ') {')
  block.inclvl()
  println('if(hiasm_i', _id_, ' < static_cast<std::size_t>(hiasm_from', _id_, ') || hiasm_i', _id_, ' >= static_cast<std::size_t>(hiasm_from', _id_, ' + std::max(1, ', get('Count'), '))) {')
  block.inclvl()
  println('if(!hiasm_rest', _id_, '.empty()) hiasm_rest', _id_, ' += std::string(', Char(), ');')
  println('hiasm_rest', _id_, ' += hiasm_parts', _id_, '[hiasm_i', _id_, '];')
  block.declvl()
  println('}')
  block.declvl()
  println('}')
  println('hiasm_str_state(', _id_, ' * 100) = hiasm_rest', _id_, ';')
  fvar(i)
  i = 1
  while(i <= get('Count'))
    println('hiasm_str_state(', _id_, ' * 100 + ', i, ') = hiasm_from', _id_, ' + ', i - 1, ' < static_cast<int>(hiasm_parts', _id_, '.size()) ? hiasm_parts', _id_, '[static_cast<std::size_t>(hiasm_from', _id_, ' + ', i - 1, ')] : std::string();')
    println('if(hiasm_from', _id_, ' + ', i - 1, ' < static_cast<int>(hiasm_parts', _id_, '.size())) {')
    block.inclvl()
    event('onPart' && i, 'hiasm_str_state(' && _id_ && ' * 100 + ' && i && ')')
    block.declvl()
    println('}')
    i = i + 1
  end
  block.declvl()
  println('}')
end
