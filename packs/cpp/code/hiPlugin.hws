func doStart
  block.reg("result")
  block.select("result")
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#endif')
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  println('#include <cstdint>')
  println('')
  println('#if defined(_WIN32)')
  println('#define HIASM_EXPORT extern "C" __declspec(dllexport)')
  println('#else')
  println('#define HIASM_EXPORT extern "C" __attribute__((visibility("default")))')
  println('#endif')
  println('')
  println('struct HiasmPluginInfo')
  println('{')
  println('  std::uint32_t abi;')
  println('  const char *name;')
  println('  const char *version;')
  println('  const char *description;')
  println('};')
  println('')
  println('static const HiasmPluginInfo hiasm_plugin_description = {')
  println('  1u, ', PluginName, ', "1.0", "HiAsm plugin"')
  println('};')
  println('')
  println('HIASM_EXPORT const HiasmPluginInfo *hiasm_plugin_info(void)')
  println('{')
  println('  return &hiasm_plugin_description;')
  println('}')
  println('')
  println('HIASM_EXPORT int hiasm_plugin_run(void)')
  println('{')
  block.inclvl()
  event(onStart)
  println('  return 0;')
  block.declvl()
  println('}')
end
