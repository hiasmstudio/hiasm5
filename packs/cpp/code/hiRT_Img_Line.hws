func doDraw(_data)
  println('#if !defined(_WIN32)')
  println('#error "RT_Img_Line is a Windows-only drawing element"')
  println('#endif')
  println('HDC hiasm_dc', _id_, ' = reinterpret_cast<HDC>(static_cast<intptr_t>(Bitmap));')
  println('if(std::string("', DrawSource, '") == "Handle") hiasm_dc', _id_, ' = GetDC(reinterpret_cast<HWND>(static_cast<intptr_t>(Bitmap)));')
  println('if(std::string("', DrawSource, '") == "Bitmap") { static HDC hiasm_mem', _id_, ' = CreateCompatibleDC(NULL); SelectObject(hiasm_mem', _id_, ', reinterpret_cast<HBITMAP>(static_cast<intptr_t>(Bitmap))); hiasm_dc', _id_, ' = hiasm_mem', _id_, '; }')
  println('int hiasm_x1_', _id_, ' = LOWORD(static_cast<DWORD>(', Point1, '));')
  println('int hiasm_y1_', _id_, ' = HIWORD(static_cast<DWORD>(', Point1, '));')
  println('int hiasm_x2_', _id_, ' = LOWORD(static_cast<DWORD>(', Point2, '));')
  println('int hiasm_y2_', _id_, ' = HIWORD(static_cast<DWORD>(', Point2, '));')
  println('if(std::string("', Point2AsOffset, '") == "True") { hiasm_x2_', _id_, ' += hiasm_x1_', _id_, '; hiasm_y2_', _id_, ' += hiasm_y1_', _id_, '; }')
  println('MoveToEx(hiasm_dc', _id_, ', hiasm_x1_', _id_, ', hiasm_y1_', _id_, ', NULL);')
  println('LineTo(hiasm_dc', _id_, ', hiasm_x2_', _id_, ', hiasm_y2_', _id_, ');')
  event(onDraw)
end
