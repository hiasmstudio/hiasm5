func doStart
  // The MainForm of a ChildForm is an additional window of the program; the project form writes the program.
  if(is_qt_project())
    if(sys.inner_parent())
      qtChildStart()
    else
      qtStart()
    end
  elseif(sys.inner_parent())
    childStart()
  else
    mainStart()
  end
end

