  println('')
  println('static void hiasm_restore_size(GtkWindow *window, int width, int height)')
  println('{')
  println('  std::string file, section;')
  println('  hiasm_split_save_spec(file, section);')
  println('  if(!file.empty()) {')
  println('    const std::string w = hiasm_ini_get(file, section, "Width");')
  println('    const std::string h = hiasm_ini_get(file, section, "Height");')
  println('    if(!w.empty() && !h.empty()) { width = std::atoi(w.c_str()); height = std::atoi(h.c_str()); }')
  println('  }')
  println('  gtk_window_set_default_size(window, width, height);')
  println('}')
  println('')
  println('static void hiasm_restore_position(GtkWindow *window)')
  println('{')
  println('  std::string file, section;')
  println('  hiasm_split_save_spec(file, section);')
  println('  if(file.empty()) return;')
  println('  const std::string left = hiasm_ini_get(file, section, "Left");')
  println('  const std::string top = hiasm_ini_get(file, section, "Top");')
  println('  if(!left.empty() && !top.empty()) hiasm_win_move(window, std::atoi(left.c_str()), std::atoi(top.c_str()));')
  println('}')
  println('')
  println('static void hiasm_store_geometry(GtkWindow *window)')
  println('{')
  println('  std::string file, section;')
  println('  hiasm_split_save_spec(file, section);')
  println('  if(file.empty()) return;')
  println('  hiasm_ini_set(file, section, "Width", std::to_string(gtk_widget_get_width(GTK_WIDGET(window))));')
  println('  hiasm_ini_set(file, section, "Height", std::to_string(gtk_widget_get_height(GTK_WIDGET(window))));')
  println('  int left = 0, top = 0;')
  println('  if(hiasm_win_get_pos(window, left, top)) {')
  println('    hiasm_ini_set(file, section, "Left", std::to_string(left));')
  println('    hiasm_ini_set(file, section, "Top", std::to_string(top));')
  println('  }')
  println('}')
  println('')
  println('static void hiasm_apply_state(GtkWindow *window, int state, int position, int clientSize, int width, int height)')
  println('{')
  println('  if(clientSize == 0) hiasm_win_client_size(window, width, height);')
  println('  if(position == 1) hiasm_win_center(window);')
  println('  hiasm_restore_position(window);')
  println('  if(state == 1) gtk_window_minimize(window);')
  println('  else if(state == 2) gtk_window_maximize(window);')
  println('}')
