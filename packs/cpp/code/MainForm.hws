  println('  return std::string("Linux");')
  println('#endif')
  println('}')
  println('')
  println('static bool hiasm_mask_match(const char *text, const char *mask, bool caseSensitive)')
  println('{')
  println('  const char *t = text ? text : "";')
  println('  const char *m = mask ? mask : "";')
  println('  while(*m) {')
  println('    if(*m == 42) {')
  println('      while(*m == 42) ++m;')
  println('      if(!*m) return true;')
  println('      for(const char *p = t; ; ++p) {')
  println('        if(hiasm_mask_match(p, m, caseSensitive)) return true;')
  println('        if(!*p) return false;')
  println('      }')
  println('    }')
  println('    if(!*t) return false;')
  println('    if(*m == 63) { ++t; ++m; continue; }')
  println('    if(*m == 35) {')
  println('      if(!std::isdigit(static_cast<unsigned char>(*t))) return false;')
  println('      ++t; ++m; continue;')
  println('    }')
  println('    char a = *t, b = *m;')
  println('    if(!caseSensitive) { a = static_cast<char>(std::tolower(static_cast<unsigned char>(a))); b = static_cast<char>(std::tolower(static_cast<unsigned char>(b))); }')
  println('    if(a != b) return false;')
  println('    ++t; ++m;')
  println('  }')
  println('  return *t == 0;')
  println('}')
  println('')
  println('static GtkWidget *hiasm_form = NULL;')
  println('// Client areas of panels (ChildPanel) and additional forms (ChildForm) while their elements are created.')
  println('static std::vector<GtkWidget*> hiasm_parents;')
  println('static GtkWidget *hiasm_parent() { return hiasm_parents.empty() ? hiasm_form : hiasm_parents.back(); }')
  println('static std::map<std::string, GtkWidget*> hiasm_widgets;')
