  println('static std::string hiasm_read_file(const char *name)')
  println('{')
  println('  std::ifstream file(name ? name : "");')
  println('  std::string line;')
  println('  std::string out;')
  println('  while(std::getline(file, line)) {')
  println('    if(!out.empty()) out += static_cast<char>(10);')
  println('    out += line;')
  println('  }')
  println('  return out;')
  println('}')
