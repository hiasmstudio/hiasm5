  println('static std::vector<std::string> hiasm_text_lines(GtkTextView *view)')
  println('{')
  println('  std::vector<std::string> result;')
  println('  std::string text = hiasm_view_text(view);')
  println('  std::size_t start = 0;')
  println('  while(true) {')
  println('    std::size_t end = text.find(static_cast<char>(10), start);')
  println('    result.push_back(text.substr(start, end == std::string::npos ? std::string::npos : end - start));')
  println('    if(end == std::string::npos) break;')
  println('    start = end + 1;')
  println('  }')
  println('  return result;')
  println('}')
  println('')
  println('static void hiasm_text_set(GtkTextView *view, const char *text)')
  println('{')
  println('  gtk_text_buffer_set_text(gtk_text_view_get_buffer(view), text ? text : "", -1);')
  println('}')
  println('')
  println('static void hiasm_text_add(GtkTextView *view, const char *text, gboolean first)')
  println('{')
  println('  GtkTextBuffer *buffer = gtk_text_view_get_buffer(view);')
  println('  GtkTextIter iter;')
  println('  if(first) {')
  println('    gtk_text_buffer_get_start_iter(buffer, &iter);')
  println('    gtk_text_buffer_insert(buffer, &iter, text ? text : "", -1);')
  println('    gtk_text_buffer_insert(buffer, &iter, "\\n", -1);')
  println('  }')
  println('  else {')
  println('    gtk_text_buffer_get_end_iter(buffer, &iter);')
  println('    if(gtk_text_buffer_get_char_count(buffer)) gtk_text_buffer_insert(buffer, &iter, "\\n", -1);')
  println('    gtk_text_buffer_insert(buffer, &iter, text ? text : "", -1);')
  println('  }')
  println('}')
  println('')
  println('static void hiasm_text_remove(GtkTextView *view, int index)')
  println('{')
  println('  std::vector<std::string> lines = hiasm_text_lines(view);')
  println('  if(index >= 0 && index < static_cast<int>(lines.size())) lines.erase(lines.begin() + index);')
  println('  hiasm_text_set(view, hiasm_join_lines(lines).c_str());')
  println('}')
  println('')
  println('static void hiasm_text_replace_selection(GtkTextView *view, const char *text)')
  println('{')
  println('  GtkTextBuffer *buffer = gtk_text_view_get_buffer(view);')
  println('  GtkTextIter start, end;')
  println('  if(gtk_text_buffer_get_selection_bounds(buffer, &start, &end)) {')
  println('    gtk_text_buffer_delete(buffer, &start, &end);')
  println('    gtk_text_buffer_insert(buffer, &start, text ? text : "", -1);')
  println('  }')
  println('}')
