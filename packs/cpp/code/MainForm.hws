  println('static QColor qt_led_color(QString color, const QColor &fallback) {')
  println('  if (color.startsWith(QStringLiteral("cl"), Qt::CaseInsensitive)) color.remove(0, 2);')
  println('  const auto named = QColor::fromString(color.toLower());')
  println('  if (named.isValid()) return named;')
  println('  bool ok = false;')
  println('  const auto value = color.toUInt(&ok);')
  println('  return ok ? QColor(value & 255, (value >> 8) & 255, (value >> 16) & 255) : fallback;')
  println('}')
  println('class HiasmLed : public HiasmClickable<QWidget> {')
  println('public:')
  println('  using HiasmClickable<QWidget>::HiasmClickable;')
  println('  bool lit = false, circle = true, highlight = true;')
  println('  QColor litColor = Qt::red, dimColor = QColor(128, 0, 0), shine = Qt::white;')
  println('  std::function<void(int)> changed;')
  println('  void setLit(bool state) { if (lit == state) return; lit = state; update(); if (changed) changed(lit); }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    painter.setRenderHint(QPainter::Antialiasing);')
  println('    const QRectF area = QRectF(rect()).adjusted(1, 1, -1, -1);')
  println('    const auto color = lit ? litColor : dimColor;')
  println('    painter.setPen(color.darker());')
  println('    painter.setBrush(color);')
  println('    if (circle) painter.drawEllipse(area); else painter.drawRect(area);')
  println('    if (highlight) {')
  println('      painter.setPen(Qt::NoPen);')
  println('      painter.setBrush(shine);')
  println('      painter.setOpacity(0.65);')
  println('      painter.drawEllipse(QRectF(area.left() + area.width() * 0.23, area.top() + area.height() * 0.20, area.width() * 0.28, area.height() * 0.17));')
  println('    }')
  println('  }')
  println('};')
  println('template<class T> static QString qt_text(T value) { return QString::number(value); }')
  println('static bool qt_flag(const QString &value) { return value.compare(QStringLiteral("true"), Qt::CaseInsensitive) == 0 || value.toInt() != 0; }')
  qtPlotRuntime()
  println('class HiasmGrapher : public QWidget {')
  println('public:')
  println('  using QWidget::QWidget;')
  println('  QList<double> samples;')
  println('  double step = 1, minimumY = 0, maximumY = 100, firstX = 0;')
  println('  int limit = 0, grid = 10, penWidth = 1;')
  println('  QMargins margins{30, 15, 15, 15};')
  println('  QColor gridColor = Qt::lightGray, borderColor = Qt::black, axisColor = Qt::blue, penColor = Qt::red;')
  println('  void trim() {')
  println('    if (limit > 0 && samples.size() > limit) {')
  println('      const auto removed = samples.size() - limit;')
  println('      samples.remove(0, removed);')
  println('      firstX += removed * step;')
  println('    }')
  println('    update();')
  println('  }')
  println('  double extreme(bool maximum) const {')
  println('    if (samples.isEmpty()) return 0;')
  println('    double result = samples.first();')
  println('    for (double y : samples) result = maximum ? qMax(result, y) : qMin(result, y);')
  println('    return result;')
  println('  }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    painter.fillRect(rect(), palette().window());')
  println('    const QRectF area = rect().marginsRemoved(margins);')
  println('    if (area.isEmpty()) return;')
  println('    const int divisions = qBound(1, grid, 100);')
  println('    const double span = maximumY > minimumY ? maximumY - minimumY : 1;')
  println('    const auto intervals = qMax<qsizetype>(1, samples.size() - 1);')
  println('    for (int i = 0; i <= divisions; ++i) {')
  println('      const double fraction = double(i) / divisions;')
  println('      const double x = area.left() + area.width() * fraction;')
  println('      const double y = area.bottom() - area.height() * fraction;')
  println('      painter.setPen(gridColor);')
  println('      painter.drawLine(QPointF(x, area.top()), QPointF(x, area.bottom()));')
  println('      painter.drawLine(QPointF(area.left(), y), QPointF(area.right(), y));')
  println('      painter.setPen(axisColor);')
  println('      painter.drawText(QRectF(0, y - 8, area.left() - 3, 16), Qt::AlignRight | Qt::AlignVCenter, QString::number(minimumY + span * fraction));')
  println('      painter.drawText(QRectF(x - 25, area.bottom(), 50, 16), Qt::AlignHCenter, QString::number(firstX + step * intervals * fraction));')
  println('    }')
  println('    painter.setPen(borderColor);')
  println('    painter.drawRect(area);')
  println('    painter.setClipRect(area);')
  println('    painter.setPen(QPen(penColor, qMax(1, penWidth)));')
  println('    QPolygonF points;')
  println('    for (qsizetype i = 0; i < samples.size(); ++i)')
  println('      points.append(QPointF(area.left() + area.width() * i / intervals, area.bottom() - area.height() * (samples[i] - minimumY) / span));')
  println('    if (points.size() == 1) painter.drawPoint(points.first());')
  println('    else painter.drawPolyline(points);')
  println('  }')
  println('};')
  println('class HiasmLedLadder : public HiasmClickable<QWidget> {')
  println('public:')
  println('  using HiasmClickable<QWidget>::HiasmClickable;')
  println('  QColor background = Qt::black;')
  println('  QColor active[3] = {Qt::green, Qt::yellow, Qt::red};')
  println('  QColor inactive[3] = {Qt::darkGreen, Qt::darkYellow, Qt::darkRed};')
  println('  int count = 20, spacing = 2, maximum = 100, position = 0, minMid = 70, midMax = 95;')
  println('  bool vertical = false, gradient = true;')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    painter.fillRect(rect(), background);')
  println('    if (width() <= 2 || height() <= 2) return;')
  println('    const int total = qBound(2, count, 4096);')
  println('    const int max = qMax(1, maximum);')
  println('    const int lit = qRound(double(qBound(0, position, max)) * total / max);')
  println('    const int low = int(qint64(qBound(0, minMid, max)) * total / max);')
  println('    const int high = int(qint64(qBound(0, midMax, max)) * total / max);')
  println('    const double pitch = double((vertical ? height() : width()) - 2) / total;')
  println('    const double length = qMax(0.0, pitch - qMax(0, spacing));')
  println('    for (int i = 0; i < total; ++i) {')
  println('      const int band = i < low ? 0 : i < high ? 1 : 2;')
  println('      const auto &color = i < lit ? active[band] : inactive[band];')
  println('      const QRectF area = vertical ? QRectF(1, height() - 1 - i * pitch - length, width() - 2, length)')
  println('                                  : QRectF(1 + i * pitch, 1, length, height() - 2);')
  println('      if (gradient) {')
  println('        QLinearGradient fill(area.topLeft(), vertical ? area.topRight() : area.bottomLeft());')
  println('        fill.setColorAt(0, color);')
  println('        fill.setColorAt(1, color.darker(170));')
  println('        painter.fillRect(area, fill);')
  println('      } else painter.fillRect(area, color);')
  println('    }')
  println('  }')
  println('};')
  println('class HiasmLedNumber : public HiasmClickable<QWidget> {')
  println('public:')
  println('  using HiasmClickable<QWidget>::HiasmClickable;')
  println('  QString text;')
  println('  int alignment = 1;')
  println('  bool showLines = false, colorHover = false;')
  println('  QColor background = Qt::black, foreground = Qt::green, inactive = Qt::darkGreen;')
  println('  QColor hoverBackground = Qt::black, hoverForeground = Qt::red, hoverInactive = Qt::darkRed;')
  println('protected:')
  println('  void enterEvent(QEnterEvent *event) override { QWidget::enterEvent(event); update(); }')
  println('  void leaveEvent(QEvent *event) override { QWidget::leaveEvent(event); update(); }')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    const bool hover = colorHover && underMouse();')
  println('    painter.fillRect(rect(), hover ? hoverBackground : background);')
  println('    if (text.isEmpty() || width() < 3 || height() < 3) return;')
  println('    const auto active = hover ? hoverForeground : foreground;')
  println('    const auto off = hover ? hoverInactive : inactive;')
  println('    const double scale = qMin((height() - 2) / 20.0, (width() - 2) / (12.0 * text.size()));')
  println('    const double gap = width() - 12 * text.size() * scale;')
  println('    painter.translate(alignment == 0 ? 1 : alignment == 2 ? gap / 2 : gap - 1, (height() - 20 * scale) / 2);')
  println('    painter.scale(scale, scale);')
  println('    static const QRectF segments[] = {{2,0,7,2},{9,2,2,7},{9,11,2,7},')
  println('        {2,18,7,2},{0,11,2,7},{0,2,2,7},{2,9,7,2}};')
  println('    static const unsigned digits[] = {63,6,91,79,102,109,125,7,127,111};')
  println('    for (const auto character : text) {')
  println('      const int digit = character.digitValue();')
  println('      const unsigned mask = digit >= 0 ? digits[digit] : character == QChar(45) ? 64 : character == QChar(95) ? 8 : 0;')
  println('      if (character == QChar(46) || character == QChar(58)) {')
  println('        painter.fillRect(QRectF(4, 14, 2, 2), active);')
  println('        if (character == QChar(58)) painter.fillRect(QRectF(4, 5, 2, 2), active);')
  println('      } else if (mask) {')
  println('        for (unsigned i = 0; i < 7; ++i) {')
  println('          const bool lit = mask & (1u << i);')
  println('          if (lit || showLines) painter.fillRect(segments[i], lit ? active : off);')
  println('        }')
  println('      }')
  println('      painter.translate(12, 0);')
  println('    }')
  println('  }')
  println('};')
  println('class HiasmPaintBox : public HiasmClickable<QWidget> {')
  println('public:')
  println('  using HiasmClickable<QWidget>::HiasmClickable;')
  println('  QColor background = palette().color(QPalette::Window);')
  println('  bool clearBeforeDraw = false;')
  println('  std::function<void()> beforeDraw;')
  println('  QImage &bitmap() {')
