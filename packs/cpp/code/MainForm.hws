  println('class HiasmIndexManager : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QList<int> indexes;')
  println('  QList<std::function<void()>> listeners;')
  println('  void load(const QString &values) {')
  println('    static const QRegularExpression item(QStringLiteral("=[[:space:]]*(-?[0-9]+)[[:space:]]*(?=,|[]]|$)"));')
  println('    indexes.clear();')
  println('    for (auto match = item.globalMatch(values); match.hasNext();) {')
  println('      bool valid = false;')
  println('      const int index = match.next().captured(1).toInt(&valid);')
  println('      indexes.append(valid ? index : -1);')
  println('    }')
  println('  }')
  println('  void refresh() { for (const auto &listener : listeners) listener(); }')
  println('  void remove(int index) { if (index >= 0 && index < indexes.size()) { indexes.removeAt(index); refresh(); } }')
  println('};')
  println('class HiasmIconsManager : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  int size = 16;')
  println('  QColor background;')
  println('  QList<QImage> icons;')
  println('  QList<std::function<void()>> listeners;')
  println('  void load(const QString &values) {')
  println('    static const QRegularExpression item(QStringLiteral("[[]ZIP[0-9A-Fa-f]+[]]"));')
  println('    for (auto match = item.globalMatch(values); match.hasNext();)')
  println('      icons.append(qt_bitmap(match.next().captured(), "ico"));')
  println('  }')
  println('  void refresh() { for (const auto &listener : listeners) listener(); }')
  println('};')
  println('static int qt_resource_icons(const QString &path, QList<QImage> *images = nullptr) {')
  println('#ifdef Q_OS_WIN')
  println('  using ExtractIcons = UINT (WINAPI *)(LPCWSTR, int, HICON *, HICON *, UINT);')
  println('  static QLibrary shell([] {')
  println('    wchar_t directory[MAX_PATH];')
  println('    const auto length = GetSystemDirectoryW(directory, MAX_PATH);')
  println('    if (!length || length >= MAX_PATH) return QString();')
  println('    return QString::fromWCharArray(directory, length) + QStringLiteral("/shell32.dll");')
  println('  }());')
  println('  static const auto extract = reinterpret_cast<ExtractIcons>(shell.resolve("ExtractIconExW"));')
  println('  if (!extract || path.isEmpty()) return 0;')
  println('  const auto native = QDir::toNativeSeparators(path);')
  println('  const auto file = reinterpret_cast<LPCWSTR>(native.utf16());')
  println('  const auto count = extract(file, -1, nullptr, nullptr, 0);')
  println('  if (count == UINT(-1)) return 0;')
  println('  if (!images) return int(qMin(count, UINT(INT_MAX)));')
  println('  if (!count || count > 1024) return 0;')
  println('  QList<HICON> handles(count, nullptr);')
  println('  const auto loaded = extract(file, 0, handles.data(), nullptr, count);')
  println('  images->clear();')
  println('  for (auto handle : handles) {')
  println('    if (!handle) continue;')
  println('    auto image = QImage::fromHICON(handle);')
  println('    DestroyIcon(handle);')
  println('    if (!image.isNull()) images->append(std::move(image));')
  println('  }')
  println('  return loaded == UINT(-1) ? 0 : int(images->size());')
  println('#else')
  println('  Q_UNUSED(path); Q_UNUSED(images);')
  println('  return 0;')
  println('#endif')
  println('}')
  println('static bool qt_load_icon_list(HiasmIconsManager &manager, const QString &path) {')
  println('  QImageReader reader(path, "ico");')
  println('  const int count = reader.imageCount();')
  println('  if (count < 1 || count > 1024) return false;')
  println('  QList<QImage> images;')
  println('  for (int index = 0; index < count; ++index) {')
  println('    if (!reader.jumpToImage(index)) return false;')
  println('    auto image = reader.read();')
  println('    if (image.isNull()) return false;')
  println('    images.append(std::move(image));')
  println('  }')
  println('  manager.icons = std::move(images);')
  println('  manager.refresh();')
  println('  return true;')
  println('}')
  println('static bool qt_save_icon_list(const HiasmIconsManager &manager, const QString &path) {')
  println('  const auto count = manager.icons.size();')
  println('  if (count < 1 || count > 1024) return false;')
  println('  QByteArray directory(6 + 16 * count, char(0)), payload;')
  println('  qToLittleEndian<quint16>(1, directory.data() + 2);')
  println('  qToLittleEndian<quint16>(quint16(count), directory.data() + 4);')
  println('  for (qsizetype index = 0; index < count; ++index) {')
  println('    QByteArray entry;')
  println('    QBuffer buffer(&entry);')
  println('    if (!buffer.open(QIODevice::WriteOnly) || !manager.icons[index].save(&buffer, "ICO") || entry.size() < 22) return false;')
  println('    const auto length = qFromLittleEndian<quint32>(entry.constData() + 14);')
  println('    const auto offset = qFromLittleEndian<quint32>(entry.constData() + 18);')
  println('    if (offset > entry.size() || length > entry.size() - offset || payload.size() + length > 64 * 1024 * 1024) return false;')
  println('    directory.replace(6 + index * 16, 12, entry.constData() + 6, 12);')
  println('    qToLittleEndian<quint32>(quint32(directory.size() + payload.size()), directory.data() + 18 + index * 16);')
  println('    payload.append(entry.constData() + offset, length);')
  println('  }')
  println('  QSaveFile output(path);')
  println('  return output.open(QIODevice::WriteOnly) && output.write(directory) == directory.size() &&')
  println('      output.write(payload) == payload.size() && output.commit();')
  println('}')
  println('template<class View> static void qt_list_icons(View *view, QWidget &form, const QString &iconName, const QString &indexName) {')
  println('  if (iconName.isEmpty()) return;')
  println('  auto *icons = dynamic_cast<HiasmIconsManager *>(form.findChild<QObject *>(iconName));')
  println('  if (!icons) return;')
  println('  auto *indexes = indexName.isEmpty() ? nullptr : dynamic_cast<HiasmIndexManager *>(form.findChild<QObject *>(indexName));')
  println('  view->setIconSize(QSize(icons->size, icons->size));')
  println('  const auto refresh = [target = QPointer<View>(view), icons = QPointer<HiasmIconsManager>(icons), indexes = QPointer<HiasmIndexManager>(indexes)] {')
  println('    if (!target || !icons) return;')
  println('    for (int row = 0; row < target->count(); ++row) {')
  println('      const int index = indexes ? indexes->indexes.value(row, -1) : row;')
  println('      const auto image = icons->icons.value(index);')
  println('      const QIcon icon(QPixmap::fromImage(image));')
  println('      if constexpr (std::is_base_of_v<QListWidget, View>) target->item(row)->setIcon(icon);')
  println('      else target->setItemIcon(row, icon);')
  println('    }')
  println('  };')
  println('  icons->listeners.append(refresh);')
  println('  if (indexes) indexes->listeners.append(refresh);')
  println('  auto *model = view->model();')
  println('  QObject::connect(model, &QAbstractItemModel::rowsInserted, view, [view, refresh] { QTimer::singleShot(0, view, refresh); });')
  println('  QObject::connect(model, &QAbstractItemModel::rowsRemoved, view, [view, refresh] { QTimer::singleShot(0, view, refresh); });')
  println('  QObject::connect(model, &QAbstractItemModel::layoutChanged, view, refresh);')
  println('  QObject::connect(model, &QAbstractItemModel::modelReset, view, refresh);')
  println('  refresh();')
  println('}')
  println('class HiasmDropManager : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  bool files = false;')
  println('  int mode = 1;')
  println('  std::function<void(const QString &)> dropped;')
  println('  std::function<void(int)> ended, entered, moved;')
  println('  std::function<void()> left;')
  println('  void listen(QWidget *widget) {')
  println('    if (!widget || target) return;')
  println('    target = widget;')
  println('    acceptedBefore = widget->acceptDrops();')
  println('    widget->setAcceptDrops(true);')
  println('    widget->installEventFilter(this);')
  println('  }')
  println('  void stopListening() {')
  println('    if (!target) return;')
  println('    target->removeEventFilter(this);')
  println('    target->setAcceptDrops(acceptedBefore);')
  println('    target = nullptr;')
  println('  }')
  println('protected:')
  println('  bool eventFilter(QObject *, QEvent *event) override {')
  println('    if (event->type() == QEvent::DragLeave) { if (left) left(); return false; }')
  println('    if (event->type() != QEvent::DragEnter && event->type() != QEvent::DragMove && event->type() != QEvent::Drop) return false;')
  println('    auto *drop = static_cast<QDropEvent *>(event);')
  println('    const auto action = mode == 1 ? Qt::CopyAction : mode == 2 ? Qt::MoveAction : mode == 3 ? Qt::LinkAction : Qt::IgnoreAction;')
  println('    if (action == Qt::IgnoreAction || !drop->possibleActions().testFlag(action)) return false;')
  println('    QStringList values;')
  println('    if (files) {')
  println('      for (const auto &url : drop->mimeData()->urls()) if (url.isLocalFile()) values.append(QDir::toNativeSeparators(url.toLocalFile()));')
  println('    } else if (drop->mimeData()->hasText()) values.append(drop->mimeData()->text());')
  println('    if (values.isEmpty()) return false;')
  println('    drop->setDropAction(action);')
  println('    drop->accept();')
  println('    const auto buttons = drop->buttons();')
  println('    const auto keys = drop->modifiers();')
  println('    const int state = (buttons.testFlag(Qt::LeftButton) ? 1 : 0) | (buttons.testFlag(Qt::RightButton) ? 2 : 0) |')
  println('      (keys.testFlag(Qt::ShiftModifier) ? 4 : 0) | (keys.testFlag(Qt::ControlModifier) ? 8 : 0) |')
  println('      (buttons.testFlag(Qt::MiddleButton) ? 16 : 0) | (keys.testFlag(Qt::AltModifier) ? 32 : 0);')
  println('    if (event->type() == QEvent::DragEnter) { if (entered) entered(state); }')
  println('    else if (event->type() == QEvent::DragMove) { if (moved) moved(state); }')
  println('    else {')
  println('      if (dropped) for (const auto &value : values) dropped(value);')
  println('      if (ended) ended(int(values.size()));')
  println('    }')
  println('    return true;')
  println('  }')
  println('private:')
  println('  QPointer<QWidget> target;')
  println('  bool acceptedBefore = false;')
  println('};')
  println('')
  qtCommandFamilyRuntime()
  qtEmitTreeViewTrainRuntime()
  qtMstRuntime()
