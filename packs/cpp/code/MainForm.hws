  println('static void hiasm_timer(const char *name, int interval, const char *enabled, gboolean (*callback)(gpointer))')
  println('{')
  println('  std::string flag = enabled ? enabled : "";')
  println('  if(flag == "False" || flag == "0" || interval <= 0) return;')
  println('  guint id = g_timeout_add(interval, callback, NULL);')
  println('  hiasm_timer_ids[name ? name : ""] = id;')
  println('}')
  println('')
  println('static void hiasm_timer_stop(const char *name)')
  println('{')
  println('  auto item = hiasm_timer_ids.find(name ? name : "");')
  println('  if(item == hiasm_timer_ids.end()) return;')
  println('  g_source_remove(item->second);')
  println('  hiasm_timer_ids.erase(item);')
  println('}')
