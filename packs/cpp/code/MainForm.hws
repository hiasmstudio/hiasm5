  println('static void hiasm_register(const char *name, GtkWidget *widget, GtkWidget *placed)')
  println('{')
  println('  if(name) hiasm_widgets[name] = widget;')
  println('  if(placed) gtk_fixed_put(GTK_FIXED(hiasm_parent()), placed, 0, 0);')
  println('}')
