  println('static void hiasm_list_move(GtkListBox *list, int delta)')
  println('{')
  println('  GtkListBoxRow *row = gtk_list_box_get_selected_row(list);')
  println('  if(!row) return;')
  println('  int index = gtk_list_box_row_get_index(row);')
  println('  int target = index + delta;')
  println('  if(target < 0 || target >= static_cast<int>(hiasm_list_lines(list).size())) return;')
  println('  std::string text = hiasm_list_row_text(row);')
  println('  gtk_list_box_remove(list, GTK_WIDGET(row));')
  println('  hiasm_list_insert(list, target, text.c_str());')
  println('  GtkListBoxRow *moved = gtk_list_box_get_row_at_index(list, target);')
  println('  if(moved) gtk_list_box_select_row(list, moved);')
  println('}')
