  println('  if(height != hiasm_list_heights.end() && height->second > 0) gtk_widget_set_size_request(label, -1, height->second);')
  println('  GtkWidget *row = gtk_list_box_row_new();')
  println('  gtk_list_box_row_set_child(GTK_LIST_BOX_ROW(row), label);')
