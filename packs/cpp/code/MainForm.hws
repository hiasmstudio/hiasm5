  println('#if defined(_WIN32)')
  println('static HWND hiasm_hwnd(GtkWindow *window)')
  println('{')
  println('  GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(window));')
  println('  return surface ? gdk_win32_surface_get_handle(surface) : NULL;')
  println('}')
  println('static bool hiasm_win_get_pos(GtkWindow *window, int &left, int &top)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  RECT rect;')
  println('  if(!hwnd || !GetWindowRect(hwnd, &rect)) return false;')
  println('  left = rect.left;')
  println('  top = rect.top;')
  println('  return true;')
  println('}')
  println('static void hiasm_win_move(GtkWindow *window, int left, int top)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(hwnd) SetWindowPos(hwnd, NULL, left, top, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);')
  println('}')
  println('static void hiasm_win_resize(GtkWindow *window, int width, int height)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(hwnd) SetWindowPos(hwnd, NULL, 0, 0, width, height, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);')
  println('}')
  println('static void hiasm_win_center(GtkWindow *window)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  RECT rect;')
  println('  if(!hwnd || !GetWindowRect(hwnd, &rect)) return;')
  println('  hiasm_win_move(window, (GetSystemMetrics(SM_CXSCREEN) - (rect.right - rect.left)) / 2, (GetSystemMetrics(SM_CYSCREEN) - (rect.bottom - rect.top)) / 2);')
  println('}')
  println('static void hiasm_win_client_size(GtkWindow *window, int width, int height)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  RECT rect = {0, 0, width, height};')
  println('  AdjustWindowRect(&rect, static_cast<DWORD>(GetWindowLongPtr(hwnd, GWL_STYLE)), FALSE);')
  println('  SetWindowPos(hwnd, NULL, 0, 0, rect.right - rect.left, rect.bottom - rect.top, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);')
  println('}')
  println('static void hiasm_win_exstyle(GtkWindow *window, LONG_PTR add, LONG_PTR remove)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  SetWindowLongPtr(hwnd, GWL_EXSTYLE, (GetWindowLongPtr(hwnd, GWL_EXSTYLE) | add) & ~remove);')
  println('}')
  println('static void hiasm_win_taskbar(GtkWindow *window, int index)')
  println('{')
  println('  if(index == 1) hiasm_win_exstyle(window, static_cast<LONG_PTR>(WS_EX_TOOLWINDOW), static_cast<LONG_PTR>(WS_EX_APPWINDOW));')
  println('}')
  println('static void hiasm_win_place_in_taskbar(GtkWindow *window)')
  println('{')
  println('  hiasm_win_exstyle(window, static_cast<LONG_PTR>(WS_EX_APPWINDOW), static_cast<LONG_PTR>(WS_EX_TOOLWINDOW));')
  println('}')
  println('static void hiasm_win_shadow(GtkWindow *window, bool enable)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  const LONG_PTR style = GetClassLongPtrA(hwnd, GCL_STYLE);')
  println('  SetClassLongPtrA(hwnd, GCL_STYLE, enable ? (style | 0x00020000) : (style & ~static_cast<LONG_PTR>(0x00020000)));')
  println('}')
  println('static void hiasm_win_flash(GtkWindow *window)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(hwnd) FlashWindow(hwnd, TRUE);')
  println('}')
  println('static int hiasm_win_size_header(GtkWindow *window)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  RECT rect;')
  println('  POINT point = {0, 0};')
  println('  if(!hwnd || !GetWindowRect(hwnd, &rect)) return 0;')
  println('  ClientToScreen(hwnd, &point);')
  println('  return point.y - rect.top;')
  println('}')
  println('static int hiasm_win_size_border(GtkWindow *window)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  RECT rect;')
  println('  POINT point = {0, 0};')
  println('  if(!hwnd || !GetWindowRect(hwnd, &rect)) return 0;')
  println('  ClientToScreen(hwnd, &point);')
  println('  return point.x - rect.left;')
  println('}')
  println('static void hiasm_win_set_icon(GtkWindow *window, GdkPixbuf *pixbuf)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd || !pixbuf) return;')
  println('  GdkPixbuf *scaled = gdk_pixbuf_scale_simple(pixbuf, 32, 32, GDK_INTERP_BILINEAR);')
  println('  if(!scaled) return;')
  println('  BITMAPINFO info;')
  println('  ZeroMemory(&info, sizeof(info));')
  println('  info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);')
  println('  info.bmiHeader.biWidth = 32;')
  println('  info.bmiHeader.biHeight = -32;')
  println('  info.bmiHeader.biPlanes = 1;')
  println('  info.bmiHeader.biBitCount = 32;')
  println('  info.bmiHeader.biCompression = BI_RGB;')
  println('  void *bits = NULL;')
  println('  HDC dc = GetDC(NULL);')
  println('  HBITMAP color = CreateDIBSection(dc, &info, DIB_RGB_COLORS, &bits, NULL, 0);')
  println('  ReleaseDC(NULL, dc);')
  println('  HBITMAP mask = CreateBitmap(32, 32, 1, 1, NULL);')
  println('  if(color && bits) {')
  println('    const guchar *pixels = gdk_pixbuf_get_pixels(scaled);')
  println('    const int stride = gdk_pixbuf_get_rowstride(scaled);')
  println('    const int channels = gdk_pixbuf_get_n_channels(scaled);')
  println('    DWORD *target = static_cast<DWORD*>(bits);')
  println('    for(int y = 0; y < 32; ++y) {')
  println('      for(int x = 0; x < 32; ++x) {')
  println('        const guchar *p = pixels + y * stride + x * channels;')
  println('        const DWORD a = channels == 4 ? p[3] : 255;')
  println('        target[y * 32 + x] = (a << 24) | (p[0] << 16) | (p[1] << 8) | p[2];')
  println('      }')
  println('    }')
  println('    ICONINFO iconInfo;')
  println('    iconInfo.fIcon = TRUE;')
  println('    iconInfo.xHotspot = 0;')
  println('    iconInfo.yHotspot = 0;')
  println('    iconInfo.hbmMask = mask;')
  println('    iconInfo.hbmColor = color;')
  println('    HICON icon = CreateIconIndirect(&iconInfo);')
  println('    if(icon) {')
  println('      SendMessage(hwnd, WM_SETICON, ICON_BIG, reinterpret_cast<LPARAM>(icon));')
  println('      SendMessage(hwnd, WM_SETICON, ICON_SMALL, reinterpret_cast<LPARAM>(icon));')
  println('    }')
  println('  }')
  println('  if(color) DeleteObject(color);')
  println('  if(mask) DeleteObject(mask);')
  println('  g_object_unref(scaled);')
  println('}')
  println('static COLORREF hiasm_color_key(const std::string &text)')
  println('{')
  println('  if(text == "clBlack") return RGB(0, 0, 0);')
  println('  if(text.empty() || text == "clWhite") return RGB(255, 255, 255);')
  println('  GdkRGBA rgba;')
  println('  if(gdk_rgba_parse(&rgba, text.c_str()))')
  println('    return RGB(static_cast<int>(rgba.red * 255 + 0.5), static_cast<int>(rgba.green * 255 + 0.5), static_cast<int>(rgba.blue * 255 + 0.5));')
  println('  const int value = std::atoi(text.c_str());')
  println('  return RGB(value & 255, (value >> 8) & 255, (value >> 16) & 255);')
  println('}')
  println('static bool hiasm_opaque_pixel(const guchar *row, int x, int channels, COLORREF key)')
  println('{')
  println('  const guchar *p = row + x * channels;')
  println('  if(channels == 4 && p[3] == 0) return false;')
  println('  return RGB(p[0], p[1], p[2]) != key;')
  println('}')
  println('static void hiasm_native_style(GtkWindow *window, int taskbar)')
  println('{')
  println('  GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(window));')
  println('  HWND hwnd = surface ? gdk_win32_surface_get_handle(surface) : NULL;')
  println('  if(!hwnd) return;')
  println('  // GTK rewrites the window style on layout, so the caption and frame bits are applied again.')
  println('  LONG_PTR style = GetWindowLongPtr(hwnd, GWL_STYLE);')
  println('  style |= WS_OVERLAPPEDWINDOW;')
  println('  style &= ~static_cast<LONG_PTR>(WS_CHILD | WS_POPUP);')
  println('  if(!gtk_window_get_resizable(window)) style &= ~static_cast<LONG_PTR>(WS_THICKFRAME | WS_MAXIMIZEBOX);')
  println('  SetWindowLongPtr(hwnd, GWL_STYLE, style);')
  println('  LONG_PTR ex = GetWindowLongPtr(hwnd, GWL_EXSTYLE);')
  println('  if(taskbar == 1) ex = (ex | static_cast<LONG_PTR>(WS_EX_TOOLWINDOW)) & ~static_cast<LONG_PTR>(WS_EX_APPWINDOW);')
  println('  else ex = (ex & ~static_cast<LONG_PTR>(WS_EX_TOOLWINDOW)) | static_cast<LONG_PTR>(WS_EX_APPWINDOW);')
  println('  SetWindowLongPtr(hwnd, GWL_EXSTYLE, ex);')
  println('  SetWindowPos(hwnd, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);')
  println('}')
  println('static void hiasm_win_shape(GtkWindow *window, GdkPixbuf *pixbuf)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  if(!pixbuf) { SetWindowRgn(hwnd, NULL, TRUE); return; }')
  println('  const COLORREF key = hiasm_color_key(hiasm_transparent_color);')
  println('  const int width = gdk_pixbuf_get_width(pixbuf);')
  println('  const int height = gdk_pixbuf_get_height(pixbuf);')
  println('  const int stride = gdk_pixbuf_get_rowstride(pixbuf);')
  println('  const int channels = gdk_pixbuf_get_n_channels(pixbuf);')
  println('  const guchar *pixels = gdk_pixbuf_get_pixels(pixbuf);')
  println('  HRGN region = CreateRectRgn(0, 0, 0, 0);')
  println('  for(int y = 0; y < height; ++y) {')
  println('    const guchar *row = pixels + y * stride;')
  println('    int x = 0;')
  println('    while(x < width) {')
  println('      while(x < width && !hiasm_opaque_pixel(row, x, channels, key)) ++x;')
  println('      const int start = x;')
  println('      while(x < width && hiasm_opaque_pixel(row, x, channels, key)) ++x;')
  println('      if(x > start) {')
  println('        HRGN part = CreateRectRgn(start, y, x, y + 1);')
  println('        CombineRgn(region, region, part, RGN_OR);')
  println('        DeleteObject(part);')
  println('      }')
  println('    }')
  println('  }')
  println('  SetWindowRgn(hwnd, region, TRUE);')
  println('}')
  println('#else')
  println('static bool hiasm_win_get_pos(GtkWindow *window, int &left, int &top) { (void)window; (void)left; (void)top; return false; }')
  println('static void hiasm_win_move(GtkWindow *window, int left, int top) { (void)window; (void)left; (void)top; }')
  println('static void hiasm_win_resize(GtkWindow *window, int width, int height) { (void)window; (void)width; (void)height; }')
  println('static void hiasm_win_center(GtkWindow *window) { (void)window; }')
  println('static void hiasm_win_client_size(GtkWindow *window, int width, int height) { (void)window; (void)width; (void)height; }')
  println('static void hiasm_win_taskbar(GtkWindow *window, int index) { (void)window; (void)index; }')
  println('static void hiasm_win_place_in_taskbar(GtkWindow *window) { (void)window; }')
  println('static void hiasm_win_shadow(GtkWindow *window, bool enable) { (void)window; (void)enable; }')
  println('static void hiasm_win_flash(GtkWindow *window) { (void)window; }')
  println('static int hiasm_win_size_header(GtkWindow *window) { (void)window; return 0; }')
  println('static int hiasm_win_size_border(GtkWindow *window) { (void)window; return 0; }')
  println('static void hiasm_win_set_icon(GtkWindow *window, GdkPixbuf *pixbuf) { (void)window; (void)pixbuf; }')
  println('static void hiasm_win_shape(GtkWindow *window, GdkPixbuf *pixbuf) { (void)window; (void)pixbuf; }')
  println('static void hiasm_native_style(GtkWindow *window, int taskbar) { (void)window; (void)taskbar; }')
  println('#endif')
  println('')
  println('static void activate(GtkApplication *application, gpointer user_data)')
  println('{')
  block.inclvl()
  println('  (void)user_data;')
  println('  GtkWidget *window = gtk_application_window_new(application);')
  println('  hiasm_main_window = GTK_WINDOW(window);')
  println('  hiasm_save_spec = ', cstr(d('SavePosName')), ';')
  println('  hiasm_transparent_color = ', cstr(d('TransparentColor')), ';')
  println('  hiasm_shift_left = ', get('ShiftLeft'), ';')
  println('  hiasm_shift_top = ', get('ShiftTop'), ';')
  println('  hiasm_apply_frame(GTK_WINDOW(window), ', get('BorderStyle'), ', ', nativeFrame, ');')
  println('  gtk_window_set_title(GTK_WINDOW(window), ', Caption, ');')
  println('  hiasm_restore_size(GTK_WINDOW(window), ', get('Width'), ', ', get('Height'), ');')
  println('  hiasm_set_window_background(window, ', cstr(d('Color')), ');')
  println('  hiasm_set_alpha(GTK_WINDOW(window), ', get('AlphaBlendValue'), ');')
  println('  hiasm_form = gtk_fixed_new();')
  println('  hiasm_picture = gtk_picture_new();')
  println('  gtk_picture_set_content_fit(GTK_PICTURE(hiasm_picture), GTK_CONTENT_FIT_FILL);')
  println('  gtk_fixed_put(GTK_FIXED(hiasm_form), hiasm_picture, 0, 0);')
  println('  gtk_window_set_child(GTK_WINDOW(window), hiasm_form);')
  if(get('DragForm') == 0)
    println('  GtkGesture *drag = gtk_gesture_drag_new();')
    println('  gtk_gesture_single_set_button(GTK_GESTURE_SINGLE(drag), GDK_BUTTON_PRIMARY);')
    println('  g_signal_connect(drag, "drag-begin", G_CALLBACK(hiasm_drag_begin), NULL);')
    println('  gtk_widget_add_controller(window, GTK_EVENT_CONTROLLER(drag));')
  end
  println('  g_signal_connect(window, "close-request", G_CALLBACK(+[](GtkWindow *w, gpointer) -> gboolean {')
  println('    if(!hiasm_form_ready) return FALSE;')
  println('    hiasm_store_geometry(w);')
  if(linked(onClose))
    block.inclvl()
    event(onClose)
    block.declvl()
  end
  println('    return FALSE;')
  println('  }), NULL);')
  if(linked(onActivate) or linked(onDeactivate))
    println('  g_signal_connect(window, "notify::is-active", G_CALLBACK(+[](GObject *object, GParamSpec *, gpointer) {')
    println('    if(!hiasm_form_ready) return;')
    println('    if(gtk_window_is_active(GTK_WINDOW(object))) {')
    block.inclvl()
    event(onActivate)
    block.declvl()
    println('    } else {')
    block.inclvl()
    event(onDeactivate)
    block.declvl()
    println('    }')
    println('  }), NULL);')
  end
  block.inclvl()
  sys.run_all('dostart')
  block.declvl()
  event(onCreate)
  if(nativeFrame == 1)
    println('  g_signal_connect(window, "realize", G_CALLBACK(+[](GtkWidget *w, gpointer) { hiasm_native_style(GTK_WINDOW(w), ', get('TaskBar'), '); }), NULL);')
    println('  g_signal_connect(window, "map", G_CALLBACK(+[](GtkWidget *w, gpointer) { hiasm_native_style(GTK_WINDOW(w), ', get('TaskBar'), '); }), NULL);')
  end
  println('  gtk_widget_realize(window);')
  if(nativeFrame == 1)
    println('  hiasm_native_style(GTK_WINDOW(window), ', get('TaskBar'), ');')
  end
  println('  hiasm_set_icon(GTK_WINDOW(window), ', cstr(d('Icon')), ');')
  println('  hiasm_set_picture(GTK_WINDOW(window), ', cstr(d('Picture')), ');')
  println('  hiasm_win_taskbar(GTK_WINDOW(window), ', get('TaskBar'), ');')
  println('  gtk_widget_set_visible(window, TRUE);')
  println('  hiasm_apply_state(GTK_WINDOW(window), ', get('WindowsState'), ', ', get('Position'), ', ', get('ClientSize'), ', ', get('Width'), ', ', get('Height'), ');')
  println('  hiasm_form_ready = true;')
  block.declvl()
  println('}')
  println('')
  println('static int hiasm_application_run(int argc, char **argv)')
  println('{')
  println('#if defined(_WIN32)')
  if(nativeFrame == 1)
    println('  g_setenv("GTK_CSD", "0", TRUE);')
  end
  println('#endif')
  println('  GtkApplication *application = gtk_application_new("com.hiasm.mainform", G_APPLICATION_DEFAULT_FLAGS);')
  println('  g_signal_connect(application, "activate", G_CALLBACK(activate), NULL);')
  println('  int status = g_application_run(G_APPLICATION(application), argc, argv);')
  println('  g_object_unref(application);')
  println('  return status;')
  println('}')
  println('')
  println('#if defined(_WIN32)')
  println('int WINAPI WinMain(HINSTANCE instance, HINSTANCE previous, LPSTR command, int show)')
  println('{')
  println('  (void)instance; (void)previous; (void)command; (void)show;')
  println('  return hiasm_application_run(__argc, __argv);')
  println('}')
  println('#else')
  println('int main(int argc, char **argv)')
  println('{')
  println('  return hiasm_application_run(argc, argv);')
  println('}')
  println('#endif')
end

func Arg(value)
  if(len(value) > 0)
    return(value)
  else
    return('""')
  end
end

func doCaption(_data)
  println('gtk_window_set_title(', Win(), ', hiasm_text(', Arg(_data), ').c_str());')
end

func doRestore(_data)
  println('hiasm_restore_window(', Win(), ');')
end

func doMinimize(_data)
  println('gtk_window_minimize(', Win(), ');')
end

func doClose(_data)
  println('gtk_window_close(', Win(), ');')
end

func doVisible(_data)
  println('gtk_widget_set_visible(GTK_WIDGET(', Win(), '), hiasm_flag(hiasm_text(', Arg(_data), ')) ? TRUE : FALSE);')
end

func doEnabled(_data)
  println('gtk_widget_set_sensitive(GTK_WIDGET(', Win(), '), hiasm_flag(hiasm_text(', Arg(_data), ')) ? TRUE : FALSE);')
end

func doHint(_data)
  println('gtk_widget_set_tooltip_text(GTK_WIDGET(', Win(), '), hiasm_text(', Arg(_data), ').c_str());')
end

func doLeft(_data)
  println('hiasm_set_left(', Win(), ', hiasm_int(hiasm_text(', Arg(_data), ')));')
end

func doTop(_data)
  println('hiasm_set_top(', Win(), ', hiasm_int(hiasm_text(', Arg(_data), ')));')
end

func doWidth(_data)
  println('hiasm_set_size(', Win(), ', hiasm_int(hiasm_text(', Arg(_data), ')), -1);')
end

func doHeight(_data)
  println('hiasm_set_size(', Win(), ', -1, hiasm_int(hiasm_text(', Arg(_data), ')));')
end

func doAlphaBlendValue(_data)
  println('hiasm_set_alpha(', Win(), ', hiasm_int(hiasm_text(', Arg(_data), ')));')
end

func doBorderStyle(_data)
  println('hiasm_apply_frame(', Win(), ', hiasm_int(hiasm_text(', Arg(_data), ')));')
end

func doIcon(_data)
  println('hiasm_set_icon(', Win(), ', hiasm_text(', Arg(_data), '));')
end

func doPicture(_data)
  println('hiasm_set_picture(', Win(), ', hiasm_text(', Arg(_data), '));')
end

func doShiftLeft(_data)
  println('hiasm_shift_left = hiasm_int(hiasm_text(', Arg(_data), '));')
end

func doShiftTop(_data)
  println('hiasm_shift_top = hiasm_int(hiasm_text(', Arg(_data), '));')
end

func doFlashWindow(_data)
  println('hiasm_win_flash(', Win(), ');')
end

func doShowModal(_data)
  println('hiasm_show_modal(', Win(), ');')
end

func doPlaceInTaskBar(_data)
  println('hiasm_win_place_in_taskbar(', Win(), ');')
end

func doShadow(_data)
  println('hiasm_win_shadow(', Win(), ', hiasm_flag(hiasm_text(', Arg(_data), ')));')
end

func SizeHeader()
  return('hiasm_win_size_header(' && Win() && ')')
end

func SizeBorder()
  return('hiasm_win_size_border(' && Win() && ')')
end
