  println('class HiasmPlotter final : public QWidget {')
  println('public:')
  println('  using QWidget::QWidget;')
  println('  QMargins margins{30, 15, 15, 15};')
  println('  QColor gridColor{192, 192, 192}, borderColor = Qt::black, axisColor = Qt::blue;')
  println('  int gridX = 10, gridY = 10;')
  println('  double minX = 0, maxX = 0, minY = 0, maxY = 0;')
  println('  bool mouseControl = true;')
  println('  QPointF coordinatesAt(QPointF position) const {')
  println('    const auto area = plotArea();')
  println('    return area.isEmpty() ? QPointF() : graphPoint(position, area, plotBounds(entries()));')
  println('  }')
  println('  void clear() {')
  println('    for (auto *series : entries()) series->points.clear();')
  println('    update();')
  println('  }')
  println('  void setBound(bool xAxis, bool maximum, double value) {')
  println('    if (!qIsFinite(value)) return;')
  println('    (xAxis ? (maximum ? maxX : minX) : (maximum ? maxY : minY)) = value;')
  println('    view = QRectF();')
  println('    update();')
  println('  }')
  println('  double extreme(bool xAxis, bool maximum) const {')
  println('    return extreme(entries(), xAxis, maximum);')
  println('  }')
  println('  void save(const QString &fileName) {')
  println('    if (fileName.isEmpty() || size().isEmpty()) return;')
  println('    QImage image(size(), QImage::Format_RGB32);')
  println('    if (image.isNull()) return;')
  println('    QPainter painter(&image);')
  println('    draw(painter);')
  println('    painter.end();')
  println('    image.save(fileName, "BMP");')
  println('  }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    draw(painter);')
  println('    if (drag == Qt::LeftButton) {')
  println('      painter.setPen(QPen(palette().highlight().color(), 1, Qt::DashLine));')
  println('      painter.drawRect(QRectF(anchor, cursor).normalized().intersected(plotArea()));')
  println('    }')
  println('  }')
  println('  void mousePressEvent(QMouseEvent *event) override {')
  println('    if (mouseControl && plotArea().contains(event->position()) &&')
  println('        (event->button() == Qt::MiddleButton ||')
  println('         (event->button() == Qt::LeftButton && event->modifiers().testFlag(Qt::ControlModifier)))) {')
  println('      drag = event->button();')
  println('      anchor = cursor = event->position();')
  println('      event->accept();')
  println('    } else QWidget::mousePressEvent(event);')
  println('  }')
  println('  void mouseMoveEvent(QMouseEvent *event) override {')
  println('    if (drag == Qt::NoButton) { QWidget::mouseMoveEvent(event); return; }')
  println('    const auto area = plotArea();')
  println('    if (drag == Qt::MiddleButton && !area.isEmpty()) {')
  println('      const auto bounds = plotBounds(entries());')
  println('      const auto delta = event->position() - cursor;')
  println('      setView(bounds.translated(-delta.x() / area.width() * bounds.width(), delta.y() / area.height() * bounds.height()));')
  println('    }')
  println('    cursor = event->position();')
  println('    update();')
  println('  }')
  println('  void mouseReleaseEvent(QMouseEvent *event) override {')
  println('    if (drag != event->button()) { QWidget::mouseReleaseEvent(event); return; }')
  println('    if (drag == Qt::LeftButton) {')
  println('      const auto area = plotArea();')
  println('      const auto end = event->position();')
  println('      const auto selection = QRectF(anchor, end).normalized().intersected(area);')
  println('      if (end.x() < anchor.x() || end.y() < anchor.y()) view = QRectF();')
  println('      else if (selection.width() >= 4 && selection.height() >= 4) {')
  println('        const auto bounds = plotBounds(entries());')
  println('        setView(QRectF(graphPoint(selection.bottomLeft(), area, bounds), graphPoint(selection.topRight(), area, bounds)));')
  println('      }')
  println('    }')
  println('    drag = Qt::NoButton;')
  println('    update();')
  println('  }')
  println('  void wheelEvent(QWheelEvent *event) override {')
  println('    const auto area = plotArea();')
  println('    if (!mouseControl || !area.contains(event->position()) || !event->angleDelta().y()) { QWidget::wheelEvent(event); return; }')
  println('    const auto bounds = plotBounds(entries());')
  println('    const auto center = graphPoint(event->position(), area, bounds);')
  println('    const double factor = event->angleDelta().y() > 0 ? 0.8 : 1.25;')
  println('    setView(QRectF(center + (bounds.topLeft() - center) * factor, bounds.size() * factor));')
  println('    update();')
  println('    event->accept();')
  println('  }')
  println('private:')
  println('  QRectF view;')
  println('  Qt::MouseButton drag = Qt::NoButton;')
  println('  QPointF anchor, cursor;')
  println('  QList<HiasmPlotLines *> entries() const {')
  println('    QList<HiasmPlotLines *> result;')
  println('    if (const auto *owner = parent()) for (auto *child : owner->children()) {')
  println('      if (auto *series = dynamic_cast<HiasmPlotLines *>(child); series && series->target == objectName()) result.append(series);')
  println('    }')
  println('    return result;')
  println('  }')
  println('  double extreme(const QList<HiasmPlotLines *> &series, bool xAxis, bool maximum) const {')
  println('    const double bound = xAxis ? (maximum ? maxX : minX) : (maximum ? maxY : minY);')
  println('    if (bound != 0) return bound;')
  println('    double result = 0;')
  println('    bool havePoints = false;')
  println('    for (const auto *line : series) {')
  println('      if (line->points.isEmpty()) continue;')
  println('      const double value = line->extreme(xAxis, maximum);')
  println('      result = !havePoints ? value : maximum ? qMax(result, value) : qMin(result, value);')
  println('      havePoints = true;')
  println('    }')
  println('    return result;')
  println('  }')
  println('  QRectF plotArea() const { return QRectF(rect()).marginsRemoved(QMarginsF(margins)); }')
  println('  QRectF plotBounds(const QList<HiasmPlotLines *> &series) const {')
  println('    if (!view.isEmpty()) return view;')
  println('    const auto range = [](double lower, double upper) {')
  println('      if (lower > upper) std::swap(lower, upper);')
  println('      if (lower == upper) {')
  println('        const double padding = qMax(0.5, qAbs(lower) * 0.05);')
  println('        lower -= padding;')
  println('        upper += padding;')
  println('      }')
  println('      return qIsFinite(upper - lower) ? std::pair(lower, upper) : std::pair(-1.0, 1.0);')
  println('    };')
  println('    const auto x = range(extreme(series, true, false), extreme(series, true, true));')
  println('    const auto y = range(extreme(series, false, false), extreme(series, false, true));')
  println('    return QRectF(x.first, y.first, x.second - x.first, y.second - y.first);')
  println('  }')
  println('  void setView(QRectF next) {')
  println('    if (!next.isEmpty() && qIsFinite(next.width()) && qIsFinite(next.height()) &&')
  println('        qIsFinite(next.left()) && qIsFinite(next.top()) && qIsFinite(next.right()) && qIsFinite(next.bottom())) view = next;')
  println('  }')
  println('  static QPointF graphPoint(QPointF pixel, const QRectF &area, const QRectF &bounds) {')
  println('    return {bounds.left() + (pixel.x() - area.left()) / area.width() * bounds.width(),')
  println('            bounds.top() + (area.bottom() - pixel.y()) / area.height() * bounds.height()};')
  println('  }')
  println('  void draw(QPainter &painter) const {')
  println('    painter.fillRect(rect(), palette().window());')
  println('    const auto area = plotArea();')
  println('    if (area.isEmpty()) return;')
  println('    const auto series = entries();')
  println('    const auto bounds = plotBounds(series);')
  println('    const auto drawGrid = [&](bool xAxis, int count) {')
  println('      const double span = xAxis ? area.width() : area.height();')
  println('      count = qBound(1, count, qMax(1, int(span)));')
  println('      for (int i = 0; i <= count; ++i) {')
  println('        const double fraction = double(i) / count;')
  println('        const double pixel = xAxis ? area.left() + fraction * span : area.bottom() - fraction * span;')
  println('        if (i > 0 && i < count) {')
  println('          painter.setPen(QPen(gridColor, 1, Qt::DotLine));')
  println('          if (xAxis) painter.drawLine(QLineF(pixel, area.top(), pixel, area.bottom()));')
  println('          else painter.drawLine(QLineF(area.left(), pixel, area.right(), pixel));')
  println('        }')
  println('        if (span / count < (xAxis ? 32 : 12)) continue;')
  println('        painter.setPen(axisColor);')
  println('        const double tick = xAxis ? bounds.left() + fraction * bounds.width() : bounds.top() + fraction * bounds.height();')
  println('        const QString text = QString::number(tick);')
  println('        if (xAxis) painter.drawText(QRectF(pixel - 40, area.bottom(), 80, qMax(0, margins.bottom())), Qt::AlignHCenter | Qt::AlignTop, text);')
  println('        else painter.drawText(QRectF(0, pixel - 8, qMax(0, margins.left() - 3), 16), Qt::AlignRight | Qt::AlignVCenter, text);')
  println('      }')
  println('    };')
  println('    drawGrid(true, gridX);')
  println('    drawGrid(false, gridY);')
  println('    painter.save();')
  println('    painter.setClipRect(area);')
  println('    painter.setRenderHint(QPainter::Antialiasing);')
  println('    for (const auto *line : series) {')
  println('      if (!line->shown || line->points.isEmpty()) continue;')
  println('      QPolygonF pixels;')
  println('      pixels.reserve(line->points.size());')
  println('      for (const auto &point : line->points) {')
  println('        const double x = qBound(-1e4, (point.x() - bounds.left()) / bounds.width(), 1e4);')
  println('        const double y = qBound(-1e4, (point.y() - bounds.top()) / bounds.height(), 1e4);')
  println('        pixels.append(QPointF(area.left() + x * area.width(), area.bottom() - y * area.height()));')
  println('      }')
  println('      painter.setPen(QPen(line->color, line->penWidth));')
  println('      if (line->histogram) {')
  println('        const double halfWidth = qBound(1.0, line->penWidth * area.width() / bounds.width(), area.width());')
  println('        painter.setPen(QPen(line->color, 1));')
  println('        painter.setBrush(line->fill);')
  println('        const auto *axis = line->baselineAxis.isEmpty() || !parent() ? nullptr :')
  println('          dynamic_cast<HiasmPlotAxis *>(parent()->findChild<QObject *>(line->baselineAxis, Qt::FindDirectChildrenOnly));')
  println('        for (qsizetype index = 0; index < pixels.size(); ++index) {')
  println('          const auto &point = pixels[index];')
  println('          double baseline = area.bottom();')
  println('          if (axis && qAbs(qCos(qDegreesToRadians(axis->angle))) > 1e-9) {')
  println('            const double y = axis->origin.y() + (line->points[index].x() - axis->origin.x()) * qTan(qDegreesToRadians(axis->angle));')
  println('            if (qIsFinite(y)) baseline = area.bottom() - qBound(-1e4, (y - bounds.top()) / bounds.height(), 1e4) * area.height();')
  println('          }')
  println('          painter.drawRect(QRectF(QPointF(point.x() - halfWidth, point.y()), QPointF(point.x() + halfWidth, baseline)).normalized());')
  println('        }')
  println('      } else if (line->marker >= 0) {')
  println('        const double radius = qMax(1, line->penWidth);')
  println('        painter.setPen(QPen(line->color, 1));')
  println('        painter.setBrush(line->color);')
  println('        for (const auto &point : pixels) {')
  println('          const QRectF rect(point - QPointF(radius, radius), QSizeF(2 * radius, 2 * radius));')
  println('          switch (line->marker) {')
  println('          case 0: painter.drawLine(point - QPointF(radius, 0), point + QPointF(radius, 0));')
  println('                  painter.drawLine(point - QPointF(0, radius), point + QPointF(0, radius)); break;')
  println('          case 1: painter.drawRect(rect); break;')
  println('          case 2: painter.drawEllipse(rect); break;')
  println('          case 3: painter.drawPolygon(QPolygonF{point - QPointF(0, radius), rect.bottomRight(), rect.bottomLeft()}); break;')
  println('          }')
  println('        }')
  println('      } else if (pixels.size() == 1) painter.drawPoint(pixels.constFirst());')
  println('      else painter.drawPolyline(pixels);')
  println('    }')
  println('    if (const auto *owner = parent()) for (const auto *child : owner->children()) {')
  println('      const auto *axis = dynamic_cast<const HiasmPlotAxis *>(child);')
  println('      if (!axis || axis->target != objectName()) continue;')
  println('      const double radians = qDegreesToRadians(axis->angle);')
  println('      const QPointF direction(qCos(radians), qSin(radians));')
  println('      const auto pixel = [&](QPointF point) {')
  println('        return QPointF(area.left() + (point.x() - bounds.left()) / bounds.width() * area.width(),')
  println('                       area.bottom() - (point.y() - bounds.top()) / bounds.height() * area.height());')
  println('      };')
  println('      if (!axis->seriesTarget.isEmpty()) {')
  println('        const auto *line = dynamic_cast<HiasmPlotLines *>(owner->findChild<QObject *>(axis->seriesTarget, Qt::FindDirectChildrenOnly));')
  println('        if (!line || !line->shown || line->target != objectName()) continue;')
  println('        painter.setFont(axis->font);')
  println('        const QFontMetricsF metrics(axis->font);')
  println('        for (qsizetype index = 0; index < qMin(line->points.size(), axis->labels.size()); ++index) {')
  println('          const auto &text = axis->labels[index];')
  println('          const auto at = pixel(line->points[index]);')
  println('          if (text.isEmpty() || !qIsFinite(at.x()) || !qIsFinite(at.y())) continue;')
  println('          const QSizeF size(metrics.horizontalAdvance(text) + 6, metrics.height() + 4);')
  println('          const qreal x = axis->horizontalAlign == 0 ? -size.width() - 6 : axis->horizontalAlign == 2 ? 6 : -size.width() / 2;')
  println('          const qreal y = axis->verticalAlign == 0 ? -size.height() - 6 : axis->verticalAlign == 2 ? 6 : -size.height() / 2;')
  println('          const QRectF label(at + QPointF(x, y), size);')
  println('          painter.setPen(axis->framePen);')
  println('          painter.setBrush(axis->filled ? QBrush(axis->background) : QBrush(Qt::NoBrush));')
  println('          painter.drawRect(label);')
  println('          painter.setPen(axis->foreground);')
  println('          painter.drawText(label, Qt::AlignCenter, text);')
  println('        }')
  println('        continue;')
  println('      }')
  println('      if (axis->marker) {')
  println('        const auto at = pixel(axis->origin);')
  println('        if (!qIsFinite(at.x()) || !qIsFinite(at.y())) continue;')
  println('        const auto axisByName = [&](const QString &name) -> const HiasmPlotAxis * {')
  println('          if (name.isEmpty()) return nullptr;')
  println('          const auto *candidate = dynamic_cast<HiasmPlotAxis *>(owner->findChild<QObject *>(name, Qt::FindDirectChildrenOnly));')
  println('          return candidate && !candidate->marker && candidate->target == objectName() ? candidate : nullptr;')
  println('        };')
  println('        double left = area.left(), bottom = area.bottom();')
  println('        if (const auto *reference = axisByName(axis->verticalAxis)) {')
  println('          const auto radians = qDegreesToRadians(reference->angle);')
  println('          if (qAbs(qSin(radians)) > 1e-9) left = pixel(QPointF(reference->origin.x() +')
  println('              (axis->origin.y() - reference->origin.y()) * qCos(radians) / qSin(radians), axis->origin.y())).x();')
  println('        }')
  println('        if (const auto *reference = axisByName(axis->horizontalAxis)) {')
  println('          const auto radians = qDegreesToRadians(reference->angle);')
  println('          if (qAbs(qCos(radians)) > 1e-9) bottom = pixel(QPointF(axis->origin.x(), reference->origin.y() +')
  println('              (axis->origin.x() - reference->origin.x()) * qTan(radians))).y();')
  println('        }')
  println('        painter.setPen(axis->pen);')
  println('        if (qIsFinite(left)) painter.drawLine(QPointF(left, at.y()), at);')
  println('        if (qIsFinite(bottom)) painter.drawLine(at, QPointF(at.x(), bottom));')
  println('        if (!axis->caption.isEmpty()) {')
  println('          painter.setFont(axis->font);')
  println('          const QFontMetricsF metrics(axis->font);')
  println('          const QSizeF size(metrics.horizontalAdvance(axis->caption) + 6, metrics.height() + 4);')
  println('          const qreal x = axis->horizontalAlign == 0 ? -size.width() - 6 : axis->horizontalAlign == 2 ? 6 : -size.width() / 2;')
  println('          const qreal y = axis->verticalAlign == 0 ? -size.height() - 6 : axis->verticalAlign == 2 ? 6 : -size.height() / 2;')
  println('          const QRectF label(at + QPointF(x, y), size);')
  println('          painter.setPen(axis->framePen);')
  println('          painter.setBrush(axis->filled ? QBrush(axis->background) : QBrush(Qt::NoBrush));')
  println('          painter.drawRect(label);')
  println('          painter.setPen(axis->foreground);')
  println('          painter.drawText(label, Qt::AlignCenter, axis->caption);')
  println('        }')
  println('        continue;')
  println('      }')
  println('      const auto middle = bounds.center();')
  println('      const auto delta = middle - axis->origin;')
  println('      const auto center = axis->origin + direction * QPointF::dotProduct(delta, direction);')
  println('      const double reach = bounds.width() + bounds.height();')
  println('      const auto a = pixel(center - direction * reach), b = pixel(center + direction * reach);')
  println('      if (!qIsFinite(a.x()) || !qIsFinite(a.y()) || !qIsFinite(b.x()) || !qIsFinite(b.y())) continue;')
  println('      painter.setPen(axis->pen);')
  println('      painter.drawLine(a, b);')
  println('    }')
  println('    painter.restore();')
  println('    painter.setPen(borderColor);')
  println('    painter.drawRect(area);')
  println('  }')
  println('};')
  println('inline void HiasmPlotLines::redraw() {')
  println('  if (target.isEmpty() || !parent()) return;')
  println('  auto *widget = parent()->findChild<QWidget *>(target, Qt::FindDirectChildrenOnly);')
  println('  if (auto *plotter = dynamic_cast<HiasmPlotter *>(widget)) plotter->update();')
  println('}')
  println('inline void HiasmPlotAxis::redraw() {')
  println('  if (auto *owner = parent(); owner && !target.isEmpty())')
  println('    if (auto *plot = dynamic_cast<HiasmPlotter *>(owner->findChild<QWidget *>(target, Qt::FindDirectChildrenOnly))) plot->update();')
  println('}')
  println('class HiasmPlotMouse final : public QObject {')
  println('public:')
  println('  using Callback = std::function<void(double, double)>;')
  println('  using QObject::QObject;')
  println('  Callback pressed, released, moved;')
  println('  int button = 0;')
  println('  bool realCoordinates = false;')
  println('protected:')
  println('  bool eventFilter(QObject *watched, QEvent *event) override {')
  println('    Callback callback;')
  println('    switch (event->type()) {')
  println('    case QEvent::MouseButtonPress: callback = pressed; break;')
  println('    case QEvent::MouseButtonRelease: callback = released; break;')
  println('    case QEvent::MouseMove: callback = moved; break;')
  println('    default: return false;')
  println('    }')
  println('    const auto *mouse = static_cast<QMouseEvent *>(event);')
  println('    if (mouse->button() == Qt::LeftButton) button = 1;')
  println('    if (mouse->button() == Qt::RightButton) button = 2;')
  println('    if (mouse->button() == Qt::MiddleButton) button = 3;')
  println('    if (callback) {')
  println('      const auto point = realCoordinates ? mouse->position() : static_cast<HiasmPlotter *>(watched)->coordinatesAt(mouse->position());')
  println('      callback(point.x(), point.y());')
  println('    }')
  println('    return false;')
  println('  }')
  println('};')
end

func qtChildStart
  println('{')
  block.inclvl()
  println('auto *child = new HiasmForm(widgetParent->window(), Qt::Window);')
  qtConfigureChild()
  println('QWidget *widgetParent = child;')
  sys.run_all('dostart')
  qtEvents()
  qtScheduleChild()
  block.declvl()
  println('}')
end

func qtConfigureChild
  println('child->setObjectName(QStringLiteral("MainForm', _id_, '"));')
  println('child->setWindowTitle(qt_text(', cstr(d('Caption')), '));')
  println('child->setWindowIcon(QIcon(QPixmap::fromImage(qt_bitmap(qt_text(', cstr(get('Icon')), '), "ico"))));')
  println('child->backgroundPicture = qt_bitmap(qt_text(', cstr(get('Picture')), '));')
  println('qt_form_frame(*child, ', get('BorderStyle'), ', ', get('Resizable') == 0, ', ', get('ClientSize') == 0, ', ', Width, ', ', Height, ');')
  println('child->setWindowOpacity(qBound(0, int(', AlphaBlendValue, '), 255) / 255.0);')
  if(get('Modal') == 0)
    println('child->setWindowModality(Qt::WindowModal);')
  end
  println('if (const QColor color = QColor::fromString(qt_text(', cstr(d('Color')), ')); color.isValid()) {')
  println('  auto palette = child->palette();')
  println('  palette.setColor(QPalette::Window, color);')
  println('  child->setPalette(palette);')
  println('  child->setAutoFillBackground(true);')
  println('}')
end

func qtPolyStart
  println('{ auto *child = root;')
  qtConfigureChild()
  qtEvents()
  println('}')
end

func qtPolyReady
  println('{ auto *child = root;')
  qtScheduleChild()
  println('}')
end

func qtScheduleChild
  // Run startup actions after all windows and link targets have been constructed.
  println('QTimer::singleShot(0, child, [&form, child] {')
  block.inclvl()
  qtShow()
  event(onCreate)
  block.declvl()
  println('});')
end

func QtLocal()
  if(sys.inner_parent() or get('qtPolyForm') == 1)
    return('child->')
  end
  return('form.')
end

func qtEvents
  if(linked(onClose))
    println(QtLocal(), 'onClose = [&form] {')
    block.inclvl()
    event(onClose)
    block.declvl()
    println('};')
  end
  if(linked(onActivate))
    println(QtLocal(), 'onActivate = [&form] {')
    event(onActivate)
    println('};')
  end
  if(linked(onDeactivate))
    println(QtLocal(), 'onDeactivate = [&form] {')
    event(onDeactivate)
    println('};')
  end
end

func qtShow
  if(get('Visible') == 'True')
    switch(get('WindowsState'))
      case 1: println(QtLocal(), 'showMinimized();')
      case 2: println(QtLocal(), 'showMaximized();')
      default: println(QtLocal(), 'show();')
    end
  end
end

func qtCreate
  if(linked(onCreate))
    println('QTimer::singleShot(0, &form, [&form] {')
    block.inclvl()
    event(onCreate)
    block.declvl()
    println('});')
  end
end

func QtWin()
  if(sys.inner_parent() or get('qtPolyForm') == 1)
    return('qt_widget<HiasmForm>(form, "MainForm' && _id_ && '")->')
  else
    return('form.')
  end
end

// Additional form (ChildForm): a window of its own, owned by the main window and hidden when it is closed, as
// in HiAsm 4. Its elements are created on its client area. Shown at start when Visible is True.
func childStart
  println('{')
  println('GtkWidget *child = gtk_window_new();')
  println('hiasm_register("MainForm', _id_, '", child, NULL);')
  println('gtk_window_set_title(GTK_WINDOW(child), ', Caption, ');')
  println('gtk_window_set_transient_for(GTK_WINDOW(child), hiasm_main_window);')
  println('gtk_window_set_destroy_with_parent(GTK_WINDOW(child), TRUE);')
  println('gtk_window_set_hide_on_close(GTK_WINDOW(child), TRUE);')
  println('gtk_window_set_default_size(GTK_WINDOW(child), ', get('Width'), ', ', get('Height'), ');')
  println('hiasm_set_window_background(child, ', cstr(d('Color')), ');')
  println('GtkWidget *client = gtk_fixed_new();')
  println('gtk_window_set_child(GTK_WINDOW(child), client);')
  if(linked(onClose))
    println('g_signal_connect(child, "close-request", G_CALLBACK(+[](GtkWindow *, gpointer) -> gboolean {')
    println('  if(!hiasm_form_ready) return FALSE;')
    block.inclvl()
    event(onClose)
    block.declvl()
    println('  return FALSE;')
    println('}), NULL);')
  end
  if(linked(onActivate) or linked(onDeactivate))
    println('g_signal_connect(child, "notify::is-active", G_CALLBACK(+[](GObject *object, GParamSpec *, gpointer) {')
    println('  if(!hiasm_form_ready) return;')
    println('  if(gtk_window_is_active(GTK_WINDOW(object))) {')
    block.inclvl()
    event(onActivate)
    block.declvl()
    println('  } else {')
    block.inclvl()
    event(onDeactivate)
    block.declvl()
    println('  }')
    println('}), NULL);')
  end
  println('hiasm_parents.push_back(client);')
  sys.run_all('dostart')
  println('hiasm_parents.pop_back();')
  event(onCreate)
  // Visible is a True/False list (type 14): get() gives the item text.
  if(get('Visible') == 'True')
    println('gtk_widget_set_visible(child, TRUE);')
  end
  println('}')
end

// The window of this form in the generated program.
func Win()
  if(sys.inner_parent())
    return('GTK_WINDOW(hiasm_widget("MainForm' && _id_ && '").get())')
  else
    return('hiasm_main_window')
  end
end

func mainStart
  block.reg("result")
  block.select("result")
  // NativeFrame (Windows): 1 = the standard Windows frame (the property is True), 0 = the frame drawn by GTK.
  fvar(nativeFrame)
  nativeFrame = 0
  if(get('NativeFrame') == 0)
    nativeFrame = 1
  end
  println('#include <gtk/gtk.h>')
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#include <gdk/win32/gdkwin32.h>')
  println('#endif')
  println('#include <string>')
  println('#include <sstream>')
  println('#include <vector>')
  println('#include <map>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')
  println('#include <ctime>')
  println('#include <thread>')
  println('#include <chrono>')
  println('#include <filesystem>')
  println('#include <iostream>')
  println('#include <fstream>')
  println('#include <initializer_list>')
  println('')
  println('static std::string hiasm_text(const std::string &value) { return value; }')
  println('static std::string hiasm_text(const char *value) { return value ? value : ""; }')
  println('static std::string hiasm_text(int value) { return std::to_string(value); }')
  println('static std::string hiasm_text(double value) { std::ostringstream out; out << value; return out.str(); }')
  println('static std::string hiasm_text(long long value) { return std::to_string(value); }')
  println('')
  println('static std::map<int, std::vector<std::string>> hiasm_lists;')
  println('static std::map<int, bool> hiasm_list_ready;')
  println('static std::map<int, std::vector<int>> hiasm_int_lists;')
  println('static std::map<int, std::vector<double>> hiasm_real_lists;')
  println('static std::map<int, bool> hiasm_vect_ready;')
  println('')
  println('static std::vector<int> &hiasm_int_list(int id) { return hiasm_int_lists[id]; }')
  println('static std::vector<double> &hiasm_real_list(int id) { return hiasm_real_lists[id]; }')
  println('static std::map<GtkListBox*, int> hiasm_list_heights;')
  println('')
  println('static std::vector<std::string> &hiasm_list_ref(int id)')
  println('{')
  println('  return hiasm_lists[id];')
  println('}')
  println('')
  println('static void hiasm_list_init(int id, std::initializer_list<const char*> lines)')
  println('{')
  println('  if(hiasm_list_ready[id]) return;')
  println('  std::vector<std::string> &list = hiasm_lists[id];')
  println('  list.clear();')
  println('  for(auto line : lines) list.emplace_back(line ? line : "");')
  println('  hiasm_list_ready[id] = true;')
  println('}')
  println('')
  println('static std::string hiasm_list_text(int id)')
  println('{')
  println('  std::string out;')
  println('  const std::vector<std::string> &list = hiasm_lists[id];')
  println('  for(std::size_t i = 0; i < list.size(); ++i) {')
  println('    if(i) out += static_cast<char>(10);')
  println('    out += list[i];')
  println('  }')
  println('  return out;')
  println('}')
  println('')
  println('static std::map<int, int> &hiasm_int_values()')
  println('{')
  println('  static std::map<int, int> values;')
  println('  return values;')
  println('}')
  println('')
  println('static int &hiasm_int_state(int id, int initial)')
  println('{')
  println('  std::map<int, int> &values = hiasm_int_values();')
  println('  std::map<int, int>::iterator it = values.find(id);')
  println('  if(it == values.end()) it = values.insert(std::make_pair(id, initial)).first;')
  println('  return it->second;')
  println('}')
  println('')
  println('static std::map<int, long long> &hiasm_ll_values()')
  println('{')
  println('  static std::map<int, long long> values;')
  println('  return values;')
  println('}')
  println('')
  println('static long long &hiasm_ll_state(int id, long long initial = 0)')
  println('{')
  println('  std::map<int, long long> &values = hiasm_ll_values();')
  println('  std::map<int, long long>::iterator it = values.find(id);')
  println('  if(it == values.end()) it = values.insert(std::make_pair(id, initial)).first;')
  println('  return it->second;')
  println('}')
  println('')
  println('static std::map<int, std::string> &hiasm_str_values()')
  println('{')
  println('  static std::map<int, std::string> values;')
  println('  return values;')
  println('}')
  println('')
  println('struct HiasmMathState { double value; bool error; };')
  println('static std::map<int, HiasmMathState> &hiasm_math_values()')
  println('{')
  println('  static std::map<int, HiasmMathState> values;')
  println('  return values;')
  println('}')
  println('static HiasmMathState &hiasm_math_state(int id, double initial)')
  println('{')
  println('  std::map<int, HiasmMathState> &values = hiasm_math_values();')
  println('  std::map<int, HiasmMathState>::iterator it = values.find(id);')
  println('  if(it == values.end()) { HiasmMathState fresh = {initial, false}; it = values.insert(std::make_pair(id, fresh)).first; }')
  println('  return it->second;')
  println('}')
  println('')
  println('static std::string &hiasm_str_state(int id, const std::string &initial = std::string())')
  println('{')
  println('  std::map<int, std::string> &values = hiasm_str_values();')
  println('  std::map<int, std::string>::iterator it = values.find(id);')
  println('  if(it == values.end()) it = values.insert(std::make_pair(id, initial)).first;')
  println('  return it->second;')
  println('}')
