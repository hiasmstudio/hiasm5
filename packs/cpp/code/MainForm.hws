  println('static std::string hiasm_join_lines(const std::vector<std::string> &lines)')
  println('{')
  println('  std::string out;')
  println('  for(std::size_t i = 0; i < lines.size(); ++i) {')
  println('    if(i) out += static_cast<char>(10);')
  println('    out += lines[i];')
  println('  }')
  println('  return out;')
