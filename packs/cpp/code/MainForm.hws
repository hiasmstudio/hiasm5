  println('  GtkNative *native = widget ? gtk_widget_get_native(widget) : NULL;')
  println('  GdkSurface *surface = native ? gtk_native_get_surface(native) : NULL;')
  println('  if(!surface || !GDK_IS_TOPLEVEL(surface)) return;')
  println('  gdk_toplevel_begin_move(GDK_TOPLEVEL(surface), gtk_gesture_get_device(GTK_GESTURE(gesture)), GDK_BUTTON_PRIMARY, x, y, gtk_event_controller_get_current_event_time(GTK_EVENT_CONTROLLER(gesture)));')
  println('}')
