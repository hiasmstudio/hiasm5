  println('#if defined(_WIN32)')
  println('static HWND hiasm_hwnd(GtkWindow *window)')
  println('{')
  println('  GdkSurface *surface = gtk_native_get_surface(GTK_NATIVE(window));')
  println('  return surface ? gdk_win32_surface_get_handle(surface) : NULL;')
  println('}')
  println('static bool hiasm_win_get_pos(GtkWindow *window, int &left, int &top)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  RECT rect;')
  println('  if(!hwnd || !GetWindowRect(hwnd, &rect)) return false;')
  println('  left = rect.left;')
  println('  top = rect.top;')
  println('  return true;')
  println('}')
  println('static void hiasm_win_move(GtkWindow *window, int left, int top)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(hwnd) SetWindowPos(hwnd, NULL, left, top, 0, 0, SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE);')
  println('}')
  println('static void hiasm_win_resize(GtkWindow *window, int width, int height)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(hwnd) SetWindowPos(hwnd, NULL, 0, 0, width, height, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);')
  println('}')
  println('static void hiasm_win_center(GtkWindow *window)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  RECT rect;')
  println('  if(!hwnd || !GetWindowRect(hwnd, &rect)) return;')
  println('  hiasm_win_move(window, (GetSystemMetrics(SM_CXSCREEN) - (rect.right - rect.left)) / 2, (GetSystemMetrics(SM_CYSCREEN) - (rect.bottom - rect.top)) / 2);')
  println('}')
  println('static void hiasm_win_client_size(GtkWindow *window, int width, int height)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  RECT rect = {0, 0, width, height};')
  println('  AdjustWindowRect(&rect, static_cast<DWORD>(GetWindowLongPtr(hwnd, GWL_STYLE)), FALSE);')
  println('  SetWindowPos(hwnd, NULL, 0, 0, rect.right - rect.left, rect.bottom - rect.top, SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);')
  println('}')
  println('static void hiasm_win_exstyle(GtkWindow *window, LONG_PTR add, LONG_PTR remove)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  SetWindowLongPtr(hwnd, GWL_EXSTYLE, (GetWindowLongPtr(hwnd, GWL_EXSTYLE) | add) & ~remove);')
  println('}')
  println('static void hiasm_win_taskbar(GtkWindow *window, int index)')
  println('{')
  println('  if(index == 1) hiasm_win_exstyle(window, static_cast<LONG_PTR>(WS_EX_TOOLWINDOW), static_cast<LONG_PTR>(WS_EX_APPWINDOW));')
  println('}')
  println('static void hiasm_win_place_in_taskbar(GtkWindow *window)')
  println('{')
  println('  hiasm_win_exstyle(window, static_cast<LONG_PTR>(WS_EX_APPWINDOW), static_cast<LONG_PTR>(WS_EX_TOOLWINDOW));')
  println('}')
  println('static void hiasm_win_shadow(GtkWindow *window, bool enable)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
  println('  if(!hwnd) return;')
  println('  const LONG_PTR style = GetClassLongPtrA(hwnd, GCL_STYLE);')
  println('  SetClassLongPtrA(hwnd, GCL_STYLE, enable ? (style | 0x00020000) : (style & ~static_cast<LONG_PTR>(0x00020000)));')
  println('}')
  println('static void hiasm_win_flash(GtkWindow *window)')
  println('{')
  println('  HWND hwnd = hiasm_hwnd(window);')
