  println('struct HiasmClipboardState { GMainLoop *loop; std::string text; };')
  println('')
  println('static void hiasm_clipboard_done(GObject *source, GAsyncResult *result, gpointer user_data)')
  println('{')
  println('  HiasmClipboardState *state = static_cast<HiasmClipboardState*>(user_data);')
  println('  GError *error = NULL;')
  println('  char *text = gdk_clipboard_read_text_finish(GDK_CLIPBOARD(source), result, &error);')
  println('  if(text) { state->text = text; g_free(text); }')
  println('  if(error) g_error_free(error);')
  println('  if(state->loop) g_main_loop_quit(state->loop);')
  println('}')
  println('')
  println('static std::string hiasm_clipboard_text()')
  println('{')
  println('  GdkClipboard *clipboard = gdk_display_get_clipboard(gdk_display_get_default());')
  println('  HiasmClipboardState state;')
  println('  state.loop = g_main_loop_new(NULL, FALSE);')
  println('  gdk_clipboard_read_text_async(clipboard, NULL, hiasm_clipboard_done, &state);')
  println('  g_main_loop_run(state.loop);')
  println('  g_main_loop_unref(state.loop);')
  println('  return state.text;')
  println('}')
