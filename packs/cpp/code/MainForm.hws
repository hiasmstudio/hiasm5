  println('')

  println('static bool hiasm_is_number(const std::string &s)')
  println('{')
  println('  bool hsd_digit = false;')
  println('  for(std::size_t i = 0; i < s.size(); ++i) {')
  println('    char c = s[i];')
  println('    if(c == 32 || c == 9 || c == 10 || c == 13) continue;')
  println('    if((c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46) { hsd_digit = true; continue; }')
  println('    return false;')
  println('  }')
  println('  return hsd_digit;')
  println('}')
  println('')
  println('static int hiasm_data_cmp(const std::string &a, const std::string &b)')
  println('{')
  println('  if(hiasm_is_number(a) && hiasm_is_number(b)) {')
  println('    double da = std::atof(a.c_str()), db = std::atof(b.c_str());')
  println('    return da < db ? -1 : (da > db ? 1 : 0);')
  println('  }')
  println('  if(a < b) return -1;')
  println('  if(a > b) return 1;')
  println('  return 0;')
  println('}')
  println('')
  println('static std::map<int, std::vector<std::string>> hiasm_str_lists;')
  println('static std::vector<std::string> &hiasm_str_list(int id) { return hiasm_str_lists[id]; }')
  println('static std::map<std::string, std::string> hiasm_global_vars;')
  println('std::string &hiasm_global_var(const std::string &name) { return hiasm_global_vars[name]; }')
  println('')
  println('static std::vector<std::string> hiasm_str_split(const std::string &s, const std::string &d)')
  println('{')
  println('  std::vector<std::string> out;')
  println('  std::size_t px = 0;')
  println('  while(px <= s.size()) {')
  println('    std::size_t n = d.empty() ? std::string::npos : s.find(d, px);')
  println('    out.push_back(s.substr(px, n == std::string::npos ? std::string::npos : n - px));')
  println('    if(n == std::string::npos) break;')
  println('    px = n + d.size();')
  println('  }')
  println('  return out;')
  println('}')
  println('')
  println('static unsigned hiasm_crc(const std::string &data, unsigned poly, unsigned init, unsigned f, int reflected, int hexdata)')
  println('{')
  println('  std::string bytes = data;')
  println('  if(hexdata) {')
  println('    bytes.clear();')
  println('    auto digit = [](char c) { if(c >= 48 && c <= 57) return static_cast<unsigned>(c - 48); if(c >= 65 && c <= 70) return static_cast<unsigned>(c - 55); if(c >= 97 && c <= 102) return static_cast<unsigned>(c - 87); return 0u; };')
  println('    for(std::size_t i = 0; i + 1 < data.size(); i += 2) bytes += static_cast<char>((digit(data[i]) << 4) | digit(data[i + 1]));')
  println('  }')
  println('  unsigned crc = init;')
  println('  for(std::size_t i = 0; i < bytes.size(); ++i) {')
  println('    crc ^= static_cast<unsigned>(static_cast<unsigned char>(bytes[i]));')
  println('    for(int b = 0; b < 8; ++b) {')
  println('      if(reflected) crc = (crc & 1u) ? (crc >> 1) ^ poly : crc >> 1;')
  println('      else crc = (crc & 0x80000000u) ? ((crc << 1) ^ poly) : (crc << 1);')
  println('    }')
  println('  }')
  println('  return crc ^ f;')
  println('}')
  println('')
  println('static std::string hiasm_hashsum(const std::string &msg, int algo)')
  println('{')
  println('  static const char hexd[] = "0123456789abcdef";')
  println('  auto tohex = [&](const unsigned char *p, std::size_t n) {')
  println('    std::string o;')
  println('    for(std::size_t i = 0; i < n; ++i) { o += hexd[p[i] >> 4]; o += hexd[p[i] & 15]; }')
  println('    return o;')
  println('  };')
  println('  auto pad = [&](bool big, int be) {')
  println('    std::string s = msg;')
  println('    s += static_cast<char>(128);')
  println('    while(s.size() % (big ? 128 : 64) != (big ? 112 : 56)) s += static_cast<char>(0);')
  println('    unsigned long long bits = static_cast<unsigned long long>(msg.size()) * 8;')
  println('    if(big) {')
  println('      for(int i = 0; i < 16; ++i) s += static_cast<char>(0);')
  println('      for(int i = 0; i < 8; ++i) s += static_cast<char>((bits >> (8 * (7 - i))) & 0xFF);')
  println('    } else {')
  println('      for(int i = 0; i < 8; ++i) s += static_cast<char>((bits >> (8 * (be ? (7 - i) : i))) & 0xFF);')
  println('    }')
  println('    return s;')
  println('  };')
  println('  if(algo == 0) {')
  println('    std::string s = pad(false, 0);')
  println('    unsigned a0 = 0x67452301u, b0 = 0xefcdab89u, c0 = 0x98badcfeu, d0 = 0x10325476u;')
  println('    for(std::size_t off = 0; off < s.size(); off += 64) {')
  println('      unsigned m[16];')
  println('      for(int j = 0; j < 16; ++j) {')
  println('        m[j] = ((unsigned)(unsigned char)s[off + 4*j]) | ((unsigned)(unsigned char)s[off + 4*j + 1] << 8) | ((unsigned)(unsigned char)s[off + 4*j + 2] << 16) | ((unsigned)(unsigned char)s[off + 4*j + 3] << 24);')
  println('      }')
  println('      unsigned a = a0, b = b0, c = c0, d = d0;')
  println('      for(int i = 0; i < 64; ++i) {')
  println('        unsigned f, g, k;')
  println('        if(i < 16) { f = (b & c) | ((~b) & d); g = i; }')
  println('        else if(i < 32) { f = (d & b) | ((~d) & c); g = (5 * i + 1) & 15; }')
  println('        else if(i < 48) { f = b ^ c ^ d; g = (3 * i + 5) & 15; }')
  println('        else { f = c ^ (b | (~d)); g = (7 * i) & 15; }')
  println('        k = (unsigned)(std::fabs(std::sin(static_cast<double>(i) + 1.0)) * 4294967296.0);')
  println('        int sh;')
  println('        if(i < 16) sh = (i % 4 == 0) ? 7 : ((i % 4 == 1) ? 12 : ((i % 4 == 2) ? 17 : 22));')
  println('        else if(i < 32) sh = (i % 4 == 0) ? 5 : ((i % 4 == 1) ? 9 : ((i % 4 == 2) ? 14 : 20));')
  println('        else if(i < 48) sh = (i % 4 == 0) ? 4 : ((i % 4 == 1) ? 11 : ((i % 4 == 2) ? 16 : 23));')
  println('        else sh = (i % 4 == 0) ? 6 : ((i % 4 == 1) ? 10 : ((i % 4 == 2) ? 15 : 21));')
  println('        unsigned tmp = d;')
  println('        d = c;')
  println('        c = b;')
  println('        unsigned sum = a + f + k + m[g];')
  println('        unsigned rot = (sum << sh) | (sum >> (32 - sh));')
  println('        b = b + rot;')
  println('        a = tmp;')
  println('      }')
  println('      a0 += a; b0 += b; c0 += c; d0 += d;')
  println('    }')
  println('    unsigned char o[16];')
  println('    unsigned h[4] = {a0, b0, c0, d0};')
  println('    for(int j = 0; j < 4; ++j) { o[4*j] = h[j] & 0xFF; o[4*j + 1] = (h[j] >> 8) & 0xFF; o[4*j + 2] = (h[j] >> 16) & 0xFF; o[4*j + 3] = (h[j] >> 24) & 0xFF; }')
  println('    return tohex(o, 16);')
  println('  }')
  println('  if(algo == 1) {')
  println('    std::string s = pad(false, 1);')
  println('    unsigned h[5] = {0x67452301u, 0xEFCDAB89u, 0x98BADCFEu, 0x10325476u, 0xC3D2E1F0u};')
  println('    for(std::size_t off = 0; off < s.size(); off += 64) {')
  println('      unsigned w[80];')
  println('      for(int j = 0; j < 16; ++j) {')
  println('        w[j] = ((unsigned)(unsigned char)s[off + 4*j] << 24) | ((unsigned)(unsigned char)s[off + 4*j + 1] << 16) | ((unsigned)(unsigned char)s[off + 4*j + 2] << 8) | ((unsigned)(unsigned char)s[off + 4*j + 3]);')
  println('      }')
  println('      for(int j = 16; j < 80; ++j) {')
  println('        unsigned x = w[j - 3] ^ w[j - 8] ^ w[j - 14] ^ w[j - 16];')
  println('        w[j] = (x << 1) | (x >> 31);')
  println('      }')
  println('      unsigned a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];')
  println('      for(int i = 0; i < 80; ++i) {')
  println('        unsigned f, k;')
  println('        if(i < 20) { f = (b & c) | ((~b) & d); k = 0x5A827999u; }')
  println('        else if(i < 40) { f = b ^ c ^ d; k = 0x6ED9EBA1u; }')
  println('        else if(i < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu; }')
  println('        else { f = b ^ c ^ d; k = 0xCA62C1D6u; }')
  println('        unsigned t = ((a << 5) | (a >> 27)) + f + e + k + w[i];')
  println('        e = d;')
  println('        d = c;')
  println('        c = (b << 30) | (b >> 2);')
  println('        b = a;')
  println('        a = t;')
  println('      }')
  println('      h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;')
  println('    }')
  println('    unsigned char o[20];')
  println('    for(int j = 0; j < 5; ++j) { o[4*j] = (h[j] >> 24) & 0xFF; o[4*j + 1] = (h[j] >> 16) & 0xFF; o[4*j + 2] = (h[j] >> 8) & 0xFF; o[4*j + 3] = h[j] & 0xFF; }')
  println('    return tohex(o, 20);')
  println('  }')
  println('  return std::string();')
  println('}')
  println('')
  println('static std::map<std::string, std::map<std::string, std::string>> hiasm_ini_load(const std::string &path)')
  println('{')
  println('  std::map<std::string, std::map<std::string, std::string>> data;')
  println('  std::ifstream file(path);')
  println('  std::string line, section;')
  println('  while(std::getline(file, line)) {')
  println('    if(!line.empty() && line.back() == static_cast<char>(13)) line.pop_back();')
  println('    if(line.empty() || line[0] == static_cast<char>(59) || line[0] == static_cast<char>(35)) continue;')
  println('    if(line.front() == static_cast<char>(91) && line.back() == static_cast<char>(93)) { section = line.substr(1, line.size() - 2); continue; }')
  println('    std::size_t eq = line.find(static_cast<char>(61));')
  println('    if(eq == std::string::npos) continue;')
  println('    data[section][line.substr(0, eq)] = line.substr(eq + 1);')
  println('  }')
  println('  return data;')
  println('}')
  println('')
  println('static void hiasm_ini_save(const std::string &path, const std::map<std::string, std::map<std::string, std::string>> &data)')
  println('{')
  println('  std::ofstream file(path);')
  println('  for(std::map<std::string, std::map<std::string, std::string>>::const_iterator s = data.begin(); s != data.end(); ++s) {')
  println('    if(!s->first.empty()) file << static_cast<char>(91) << s->first << static_cast<char>(93) << static_cast<char>(10);')
  println('    for(std::map<std::string, std::string>::const_iterator i = s->second.begin(); i != s->second.end(); ++i)')
  println('      file << i->first << static_cast<char>(61) << i->second << static_cast<char>(10);')
  println('  }')
  println('}')
  println('')
  println('static std::string hiasm_ini_get(const std::string &path, const std::string &section, const std::string &key)')
  println('{')
  println('  std::map<std::string, std::map<std::string, std::string>> data = hiasm_ini_load(path);')
  println('  std::map<std::string, std::map<std::string, std::string>>::iterator s = data.find(section);')
  println('  if(s == data.end()) return std::string();')
  println('  std::map<std::string, std::string>::iterator i = s->second.find(key);')
  println('  return i == s->second.end() ? std::string() : i->second;')
  println('}')
  println('')
  println('static void hiasm_ini_set(const std::string &path, const std::string &section, const std::string &key, const std::string &value)')
  println('{')
  println('  std::map<std::string, std::map<std::string, std::string>> data = hiasm_ini_load(path);')
  println('  data[section][key] = value;')
  println('  hiasm_ini_save(path, data);')
  println('}')
  println('')
  println('static void hiasm_ini_delete_key(const std::string &path, const std::string &section, const std::string &key)')
  println('{')
  println('  std::map<std::string, std::map<std::string, std::string>> data = hiasm_ini_load(path);')
  println('  std::map<std::string, std::map<std::string, std::string>>::iterator s = data.find(section);')
  println('  if(s != data.end()) s->second.erase(key);')
  println('  hiasm_ini_save(path, data);')
  println('}')
  println('')
  println('static void hiasm_ini_erase_section(const std::string &path, const std::string &section)')
  println('{')
  println('  std::map<std::string, std::map<std::string, std::string>> data = hiasm_ini_load(path);')
  println('  data.erase(section);')
  println('  hiasm_ini_save(path, data);')
  println('}')
  println('')
  println('static void hiasm_ini_clear(const std::string &path)')
  println('{')
  println('  hiasm_ini_save(path, std::map<std::string, std::map<std::string, std::string>>());')
  println('}')
  println('')
  println('static std::vector<std::string> hiasm_ini_sections(const std::string &path)')
  println('{')
  println('  std::vector<std::string> out;')
  println('  std::map<std::string, std::map<std::string, std::string>> data = hiasm_ini_load(path);')
  println('  for(std::map<std::string, std::map<std::string, std::string>>::const_iterator s = data.begin(); s != data.end(); ++s) out.push_back(s->first);')
  println('  return out;')
  println('}')
  println('')
  println('static std::vector<std::pair<std::string, std::string>> hiasm_ini_data(const std::string &path, const std::string &section)')
  println('{')
  println('  std::vector<std::pair<std::string, std::string>> out;')
  println('  std::map<std::string, std::map<std::string, std::string>> data = hiasm_ini_load(path);')
  println('  std::map<std::string, std::map<std::string, std::string>>::const_iterator s = data.find(section);')
  println('  if(s != data.end()) for(std::map<std::string, std::string>::const_iterator i = s->second.begin(); i != s->second.end(); ++i) out.push_back(std::make_pair(i->first, i->second));')
  println('  return out;')
  println('}')
  println('')
  println('static long long hiasm_memory_bytes(int what)')
  println('{')
  println('#if defined(_WIN32)')
  println('  MEMORYSTATUSEX status; status.dwLength = sizeof(status);')
  println('  if(!GlobalMemoryStatusEx(&status)) return 0;')
  println('  switch(what) { case 0: return static_cast<long long>(status.ullTotalPhys); case 1: return static_cast<long long>(status.ullAvailPhys); case 2: return static_cast<long long>(status.ullTotalPageFile); case 3: return static_cast<long long>(status.ullAvailPageFile); case 4: return static_cast<long long>(status.ullTotalVirtual); default: return static_cast<long long>(status.ullAvailVirtual); }')
  println('#else')
  println('  long long total = 0, available = 0, swapTotal = 0, swapFree = 0;')
  println('  std::ifstream file("/proc/meminfo");')
  println('  std::string key, unit; long long value = 0;')
  println('  while(file >> key >> value >> unit) {')
  println('    if(key == "MemTotal:") total = value * 1024;')
  println('    else if(key == "MemAvailable:") available = value * 1024;')
  println('    else if(key == "MemFree:" && available == 0) available = value * 1024;')
  println('    else if(key == "SwapTotal:") swapTotal = value * 1024;')
  println('    else if(key == "SwapFree:") swapFree = value * 1024;')
  println('  }')
  println('  switch(what) { case 0: return total; case 1: return available; case 2: return swapTotal; case 3: return swapFree; case 4: return total + swapTotal; default: return available + swapFree; }')
  println('#endif')
  println('}')
  println('')
  println('static int hiasm_key_state(int key)')
  println('{')
  println('#if defined(_WIN32)')
  println('  return (GetAsyncKeyState(key) & 0x8000) ? 1 : 0;')
  println('#else')
  println('  (void)key;')
  println('  return 0;')
  println('#endif')
  println('}')
  println('')
  println('static std::string hiasm_vkey_to_char(int key)')
  println('{')
  println('#if defined(_WIN32)')
  println('  const UINT ch = MapVirtualKeyA(static_cast<UINT>(key), MAPVK_VK_TO_CHAR);')
  println('  return ch ? std::string(1, static_cast<char>(ch & 0xFF)) : std::string();')
  println('#else')
  println('  (void)key;')
  println('  return std::string();')
  println('#endif')
  println('}')
  println('')
  println('static int hiasm_screen_width()')
  println('{')
  println('#if defined(_WIN32)')
  println('  return GetSystemMetrics(SM_CXSCREEN);')
