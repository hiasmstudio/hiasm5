  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    if (bitmap.isNull()) return;')
  println('    const QImage pixels = useSourceAlpha ? bitmap : bitmap.convertToFormat(QImage::Format_RGB32);')
  println('    QPainter painter(this);')
  println('    painter.setOpacity(qBound(0, alpha, 255) / 255.0);')
  println('    painter.setRenderHint(QPainter::SmoothPixmapTransform, smooth);')
  println('    if (viewStyle == 3) { painter.drawTiledPixmap(rect(), QPixmap::fromImage(pixels)); return; }')
  println('    if (viewStyle == 4) { painter.drawImage(QPoint(), pixels); return; }')
  println('    QSize target = bitmap.size();')
  println('    if (viewStyle == 1) target = size();')
  println('    if (viewStyle == 2) target.scale(size(), Qt::KeepAspectRatio);')
  println('    if (viewStyle == 5) target.scale(size(), Qt::KeepAspectRatioByExpanding);')
  println('    QRect area(QPoint(), target);')
  println('    area.moveCenter(rect().center());')
  println('    painter.drawImage(area, pixels);')
  println('  }')
  println('};')
