func doStart
  // The MainForm of a ChildForm is an additional window of the program; the project form writes the program.
  if(sys.inner_parent())
    childStart()
  else
    mainStart()
  end
end

// Additional form (ChildForm): a window of its own, owned by the main window and hidden when it is closed, as
// in HiAsm 4. Its elements are created on its client area. Shown at start when Visible is True.
func childStart
  println('{')
  println('GtkWidget *child = gtk_window_new();')
  println('hiasm_register("MainForm', _id_, '", child, NULL);')
  println('gtk_window_set_title(GTK_WINDOW(child), ', Caption, ');')
  println('gtk_window_set_transient_for(GTK_WINDOW(child), hiasm_main_window);')
  println('gtk_window_set_destroy_with_parent(GTK_WINDOW(child), TRUE);')
  println('gtk_window_set_hide_on_close(GTK_WINDOW(child), TRUE);')
  println('gtk_window_set_default_size(GTK_WINDOW(child), ', get('Width'), ', ', get('Height'), ');')
  println('hiasm_set_window_background(child, ', cstr(d('Color')), ');')
  println('GtkWidget *client = gtk_fixed_new();')
  println('gtk_window_set_child(GTK_WINDOW(child), client);')
  if(linked(onClose))
    println('g_signal_connect(child, "close-request", G_CALLBACK(+[](GtkWindow *, gpointer) -> gboolean {')
    println('  if(!hiasm_form_ready) return FALSE;')
    block.inclvl()
    event(onClose)
    block.declvl()
    println('  return FALSE;')
    println('}), NULL);')
  end
  if(linked(onActivate) or linked(onDeactivate))
    println('g_signal_connect(child, "notify::is-active", G_CALLBACK(+[](GObject *object, GParamSpec *, gpointer) {')
    println('  if(!hiasm_form_ready) return;')
    println('  if(gtk_window_is_active(GTK_WINDOW(object))) {')
    block.inclvl()
    event(onActivate)
    block.declvl()
    println('  } else {')
    block.inclvl()
    event(onDeactivate)
    block.declvl()
    println('  }')
    println('}), NULL);')
  end
  println('hiasm_parents.push_back(client);')
  sys.run_all('dostart')
  println('hiasm_parents.pop_back();')
  event(onCreate)
  // Visible is a True/False list (type 14): get() gives the item text.
  if(get('Visible') == 'True')
    println('gtk_widget_set_visible(child, TRUE);')
  end
  println('}')
end

// The window of this form in the generated program.
func Win()
  if(sys.inner_parent())
    return('GTK_WINDOW(hiasm_widget("MainForm' && _id_ && '").get())')
  else
    return('hiasm_main_window')
  end
end

func mainStart
  block.reg("result")
  block.select("result")
  // NativeFrame (Windows): 1 = the standard Windows frame (the property is True), 0 = the frame drawn by GTK.
  fvar(nativeFrame)
  nativeFrame = 0
  if(get('NativeFrame') == 0)
    nativeFrame = 1
  end
  println('#include <gtk/gtk.h>')
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#include <gdk/win32/gdkwin32.h>')
  println('#endif')
