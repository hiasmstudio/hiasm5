  println('static std::string hiasm_view_text(GtkTextView *view)')
  println('{')
  println('  GtkTextBuffer *buffer = gtk_text_view_get_buffer(view);')
  println('  GtkTextIter start, end;')
  println('  gtk_text_buffer_get_bounds(buffer, &start, &end);')
  println('  char *text = gtk_text_buffer_get_text(buffer, &start, &end, FALSE);')
  println('  std::string result = text ? text : "";')
  println('  g_free(text);')
  println('  return result;')
  println('}')
  println('')
  println('static void hiasm_view_add(GtkTextView *view, const char *text)')
  println('{')
  println('  GtkTextBuffer *buffer = gtk_text_view_get_buffer(view);')
  println('  GtkTextIter end;')
  println('  gtk_text_buffer_get_end_iter(buffer, &end);')
  println('  if(gtk_text_buffer_get_char_count(buffer)) gtk_text_buffer_insert(buffer, &end, "\\n", -1);')
  println('  gtk_text_buffer_insert(buffer, &end, text ? text : "", -1);')
  println('}')
