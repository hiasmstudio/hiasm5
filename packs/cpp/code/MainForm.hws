func qtPlotRuntime
  println('template<class T> static double qt_plot_value(T value) {')
  println('  if constexpr (std::is_arithmetic_v<T>) return double(value);')
  println('  else return qt_text(value).toDouble();')
  println('}')
  println('class HiasmPlotLines final : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QList<QPointF> points;')
  println('  QString target, seriesName;')
  println('  QColor color = Qt::red;')
  println('  double step = 0;')
  println('  int penWidth = 1, limit = 0;')
  println('  int marker = -1;')
  println('  bool histogram = false;')
  println('  QString baselineAxis;')
  println('  double offset = 0;')
  println('  QColor fill = Qt::white;')
  println('  bool shown = true;')
  println('  bool add(double y, double x) {')
  println('    if (histogram && points.isEmpty()) x = offset;')
  println('    else if (step != 0) x = points.isEmpty() ? 0 : points.constLast().x() + step;')
  println('    if (!qIsFinite(x) || !qIsFinite(y)) return false;')
  println('    if (limit > 0 && points.size() >= limit) points.removeFirst();')
  println('    points.append(QPointF(x, y));')
  println('    redraw();')
  println('    return true;')
  println('  }')
  println('  void clear() { points.clear(); redraw(); }')
  println('  void setLimit(int value) {')
  println('    limit = qMax(0, value);')
  println('    if (limit > 0 && points.size() > limit) points.resize(limit);')
  println('    redraw();')
  println('  }')
  println('  double extreme(bool xAxis, bool maximum) const {')
  println('    if (points.isEmpty()) return 0;')
  println('    const auto coordinate = [xAxis](QPointF point) { return xAxis ? point.x() : point.y(); };')
  println('    double result = coordinate(points.constFirst());')
  println('    for (const auto &point : points) {')
  println('      const double value = coordinate(point);')
  println('      result = maximum ? qMax(result, value) : qMin(result, value);')
  println('    }')
  println('    return result;')
  println('  }')
  println('  void redraw();')
  println('};')
  println('static bool qt_plot_stream(HiasmPlotLines *series, QIODevice *stream, int type, bool clear, int step) {')
  println('  if (!series || !stream || !stream->isReadable() || type < 0 || type > 6) return false;')
  println('  const int sizes[] = {1, 2, 2, 4, 4, 4, 8};')
  println('  if (clear) series->clear();')
  println('  double x = 0;')
  println('  for (;;) {')
  println('    const auto bytes = stream->read(sizes[type]);')
  println('    if (bytes.size() != sizes[type]) break;')
  println('    const auto *data = bytes.constData();')
  println('    double value = 0;')
  println('    switch (type) {')
  println('    case 0: value = quint8(data[0]); break;')
  println('    case 1: value = qFromLittleEndian<quint16>(data); break;')
  println('    case 2: value = qFromLittleEndian<qint16>(data); break;')
  println('    case 3: value = qFromLittleEndian<quint32>(data); break;')
  println('    case 4: value = qFromLittleEndian<qint32>(data); break;')
  println('    case 5: { const auto bits = qFromLittleEndian<quint32>(data); float real; std::memcpy(&real, &bits, sizeof(real)); value = real; break; }')
  println('    case 6: { const auto bits = qFromLittleEndian<quint64>(data); std::memcpy(&value, &bits, sizeof(value)); break; }')
  println('    }')
  println('    series->add(value, x);')
  println('    x += step;')
  println('  }')
  println('  return true;')
  println('}')
