  println('static std::string hiasm_exe_dir()')
  println('{')
  println('  std::string full;')
  println('#if defined(_WIN32)')
  println('  char path[MAX_PATH] = {0};')
  println('  if(GetModuleFileNameA(NULL, path, MAX_PATH)) full = path;')
  println('#else')
  println('  gchar *link = g_file_read_link("/proc/self/exe", NULL);')
  println('  if(link) full = link;')
  println('  g_free(link);')
  println('#endif')
  println('  const std::size_t slash = full.find_last_of(std::string("/") + static_cast<char>(92));')
  println('  return slash == std::string::npos ? std::string() : full.substr(0, slash + 1);')
  println('}')
  println('')
  println('static void hiasm_split_save_spec(std::string &file, std::string &section)')
  println('{')
  println('  const std::string marker = std::string(".ini") + static_cast<char>(92);')
  println('  const std::size_t pos = hiasm_save_spec.find(marker);')
  println('  file.clear();')
  println('  section.clear();')
  println('  if(pos == std::string::npos) return;')
  println('  file = hiasm_exe_dir() + hiasm_save_spec.substr(0, pos + 4);')
  println('  section = hiasm_save_spec.substr(pos + marker.size());')
  println('}')
  println('')
