  println('      buffer = QImage(size(), QImage::Format_ARGB32_Premultiplied);')
  println('      clear();')
  println('    }')
  println('    return buffer;')
  println('  }')
  println('  void clear() { buffer.fill(background); }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    bitmap();')
  println('    if (clearBeforeDraw) clear();')
  println('    if (beforeDraw) beforeDraw();')
  println('    QPainter painter(this);')
  println('    painter.drawImage(QPoint(), buffer);')
  println('  }')
  println('private:')
  println('  QImage buffer;')
  println('};')
  println('class HiasmTimer : public QTimer {')
  println('public:')
  println('  explicit HiasmTimer(QObject *parent) : QTimer(parent) {')
  println('    connect(this, &QTimer::timeout, this, [this] { tick(); });')
  println('  }')
  println('  bool defer = false;')
  println('  std::function<void()> onTick, onStop;')
  println('  void setAutoStop(int count) { limit = remaining = qMax(0, count); }')
  println('  void restart() { remaining = limit; start(); }')
  println('  void finish(bool discard) {')
  println('    if (discard) pending = 0;')
  println('    stop();')
  println('    if (onStop) onStop();')
  println('  }')
  println('private:')
  println('  int limit = 0, remaining = 0;')
  println('  unsigned pending = 0;')
  println('  bool dispatching = false;')
  println('  void tick() {')
  println('    if (dispatching) { if (defer) ++pending; return; }')
  println('    dispatching = true;')
  println('    for (;;) {')
  println('      const bool last = remaining > 0 && --remaining == 0;')
  println('      if (onTick) onTick();')
  println('      if (last) finish(true);')
  println('      if (!pending) break;')
  println('      --pending;')
  println('    }')
  println('    dispatching = false;')
  println('  }')
  println('};')
  println('class HiasmGradientProgress : public HiasmClickable<QWidget> {')
  println('public:')
  println('  using HiasmClickable<QWidget>::HiasmClickable;')
  println('  QColor light = Qt::cyan, dark = Qt::blue;')
  println('  int maximum = 100, position = 0;')
  println('  bool vertical = false, invertGradient = false;')
  println('  void setPosition(int value) { position = qBound(0, value, maximum); update(); }')
  println('  void setMaximum(int value) { maximum = qMax(0, value); setPosition(position); }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    painter.fillRect(rect(), palette().window());')
  println('    if (!maximum || !position) return;')
  println('    const double fraction = double(position) / maximum;')
  println('    QRectF filled(rect());')
  println('    if (vertical) filled.setTop(height() * (1 - fraction));')
  println('    else filled.setWidth(width() * fraction);')
  println('    const bool horizontalGradient = vertical != invertGradient;')
  println('    QLinearGradient gradient(filled.topLeft(), horizontalGradient ? filled.topRight() : filled.bottomLeft());')
  println('    gradient.setColorAt(0, !vertical && invertGradient ? dark : light);')
  println('    gradient.setColorAt(1, !vertical && invertGradient ? light : dark);')
  println('    painter.fillRect(filled, gradient);')
  println('  }')
  println('};')
  println('template<class Base> class HiasmRushControl : public Base {')
  println('public:')
  println('  using Base::Base;')
  println('  using Base::rect; using Base::isEnabled; using Base::isDown; using Base::underMouse;')
  println('  using Base::text; using Base::hasFocus; using Base::style;')
  println('  struct Skin { QColor from, to, text, border, shadow; int gradient, stroke, offset; };')
  println('  Skin skins[4]{};')
  println('  void setSkin(int state, const QStringList &fields) {')
  println('    auto &skin = skins[state];')
  println('    skin = {qt_led_color(fields[0], Qt::white), qt_led_color(fields[1], Qt::blue),')
  println('      qt_led_color(fields[2], Qt::black), qt_led_color(fields[3], Qt::gray),')
  println('      qt_led_color(fields[4], Qt::white), fields[5].toInt(), fields[6].toInt(), fields[7].toInt()};')
  println('  }')
  println('  QList<QImage> glyphs;')
  println('  int roundWidth = 0, roundHeight = 0, spacing = 5, opacity = 255;')
  println('  int glyphX = 0, glyphY = 1, textX = 1, textY = 1;')
  println('  int dots = 0;')
  println('  bool glyphAlpha = false, singleGlyph = false, verticalDots = false;')
  println('  bool transparent = false;')
  println('  int checkMetric = 15;')
  println('  QColor checkColor = Qt::blue;')
  println('protected:')
  println('  bool hitButton(const QPoint &point) const override { return rect().contains(point); }')
  println('  void enterEvent(QEnterEvent *event) override { Base::enterEvent(event); this->update(); }')
  println('  void leaveEvent(QEvent *event) override { Base::leaveEvent(event); this->update(); }')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    const int state = !isEnabled() ? 3 : isDown() ? 2 : underMouse() ? 1 : 0;')
  println('    const auto &skin = skins[state];')
  println('    QPainter painter(this);')
  println('    painter.setRenderHint(QPainter::Antialiasing);')
  println('    const qreal inset = qMax(0, skin.stroke) / 2.0;')
  println('    const QRectF area = QRectF(rect()).adjusted(inset, inset, -inset, -inset);')
  println('    if (area.isEmpty()) return;')
  println('    QPainterPath outline;')
  println('    outline.addRoundedRect(area, qMax(0, roundWidth) / 2.0, qMax(0, roundHeight) / 2.0);')
  println('    if (!transparent && !skin.gradient) painter.fillPath(outline, skin.from);')
  println('    else if (!transparent) {')
  println('      const bool doubled = skin.gradient == 3 || skin.gradient == 4;')
  println('      const bool across = skin.gradient == 2 || skin.gradient == 4;')
  println('      const auto start = skin.gradient == 6 ? area.topRight() : area.topLeft();')
  println('      const auto end = skin.gradient == 6 ? area.bottomLeft() : skin.gradient == 5 ? area.bottomRight() : across ? area.topRight() : area.bottomLeft();')
  println('      QLinearGradient gradient(start, end);')
  println('      gradient.setColorAt(0, skin.from);')
  println('      if (doubled) gradient.setColorAt(0.5, skin.to);')
  println('      gradient.setColorAt(1, doubled ? skin.from : skin.to);')
  println('      painter.fillPath(outline, gradient);')
  println('    }')
  println('    if (skin.stroke > 0) { painter.setPen(QPen(skin.border, skin.stroke)); painter.drawPath(outline); }')
  println('    QRect textArea = rect().adjusted(4, 2, -4, -2);')
  println('    if constexpr (!std::is_same_v<Base, QPushButton>) {')
  println('      const int side = qBound(0, checkMetric, qMax(0, textArea.height()));')
  println('      const QRectF mark(textArea.left(), (rect().height() - side) / 2.0, side, side);')
  println('      painter.setPen(skin.border);')
  println('      painter.setBrush(skin.from);')
  println('      if constexpr (std::is_same_v<Base, QRadioButton>) painter.drawEllipse(mark); else painter.drawRect(mark);')
  println('      if (this->isChecked()) {')
  println('        painter.setPen(QPen(checkColor, 2));')
  println('        if constexpr (std::is_same_v<Base, QRadioButton>) { painter.setBrush(checkColor); painter.drawEllipse(mark.adjusted(4, 4, -4, -4)); }')
  println('        else painter.drawPolyline(QPolygonF{mark.topLeft() + QPointF(side * .2, side * .5), mark.topLeft() + QPointF(side * .4, side * .75), mark.topLeft() + QPointF(side * .8, side * .25)});')
  println('      }')
  println('      textArea.setLeft(textArea.left() + side + 5);')
  println('    }')
  println('    const auto glyph = glyphs.value(singleGlyph ? 0 : state, glyphs.value(0));')
  println('    if (!glyph.isNull()) {')
  println('      const int x = glyphX == 0 ? textArea.left() : glyphX == 2 ? textArea.right() + 1 - glyph.width() : textArea.center().x() - glyph.width() / 2;')
  println('      const int y = glyphY == 0 ? textArea.top() : glyphY == 2 ? textArea.bottom() + 1 - glyph.height() : textArea.center().y() - glyph.height() / 2;')
  println('      painter.save();')
  println('      if (glyphAlpha) painter.setOpacity(qBound(0, opacity, 255) / 255.0);')
  println('      painter.drawImage(QPoint(x, y), glyphAlpha ? glyph : glyph.convertToFormat(QImage::Format_RGB32));')
  println('      painter.restore();')
  println('      if (glyphX == 0) textArea.setLeft(x + glyph.width() + spacing);')
  println('      else if (glyphX == 2) textArea.setRight(x - spacing);')
  println('      else if (glyphY == 0) textArea.setTop(y + glyph.height() + spacing);')
  println('      else if (glyphY == 2) textArea.setBottom(y - spacing);')
  println('    }')
  println('    const Qt::Alignment horizontal[] = {Qt::AlignLeft, Qt::AlignHCenter, Qt::AlignRight};')
  println('    const Qt::Alignment vertical[] = {Qt::AlignTop, Qt::AlignVCenter, Qt::AlignBottom};')
  println('    const int alignment = horizontal[qBound(0, textX, 2)] | vertical[qBound(0, textY, 2)];')
  println('    if (skin.offset) { painter.setPen(skin.shadow); painter.drawText(textArea.translated(skin.offset, skin.offset), alignment, text()); }')
  println('    painter.setPen(skin.text);')
  println('    painter.drawText(textArea, alignment, text());')
  println('    const int count = qBound(0, dots, 32);')
  println('    for (int i = 0; i < count; ++i) {')
  println('      const qreal offset = 3.0 * (i - (count - 1) / 2.0);')
  println('      const auto center = verticalDots ? QPointF(area.left() + 4, area.center().y() + offset) : QPointF(area.center().x() + offset, area.bottom() - 4);')
  println('      painter.drawEllipse(center, 0.75, 0.75);')
  println('    }')
  println('    if (hasFocus()) { QStyleOptionFocusRect focus; focus.initFrom(this); focus.rect = rect().adjusted(3, 3, -3, -3); style()->drawPrimitive(QStyle::PE_FrameFocusRect, &focus, &painter, this); }')
  println('  }')
  println('};')
  println('using HiasmRushButton = HiasmRushControl<QPushButton>;')
  println('using HiasmRushCheckBox = HiasmRushControl<QCheckBox>;')
  println('using HiasmRushRadio = HiasmRushControl<QRadioButton>;')
  println('static qint64 qt_rush_slider_value(const QSlider *slider) {')
  println('  const qint64 value = slider->value();')
  println('  return slider->property("hiasmAbsolute").toBool() && value < 0 ? -value : value;')
  println('}')
  println('enum { rgVertical, rgHorizontal, rgDoubleVert, rgDoubleHorz, rgFromTopLeft, rgFromTopRight };')
  println('static void qt_rush_slider_rule(QString &style, const char *part, const QString &axis, const char *state,')
  println('    const char *light, const char *dark, const char *edge, int gradient, int stroke, int radius) {')
  println('  const auto from = qt_led_color(qt_text(light), Qt::white).name();')
  println('  const auto to = qt_led_color(qt_text(dark), Qt::gray).name();')
  println('  const auto border = qt_led_color(qt_text(edge), Qt::gray).name();')
  println('  const bool doubled = gradient == rgDoubleVert || gradient == rgDoubleHorz;')
  println('  const bool across = gradient == rgHorizontal || gradient == rgDoubleHorz;')
  println('  const int x1 = gradient == rgFromTopRight ? 1 : 0;')
  println('  const int x2 = gradient == rgFromTopRight ? 0 : int(across || gradient == rgFromTopLeft);')
  println('  const auto stops = doubled ? QStringLiteral("stop:0 %1, stop:0.5 %2, stop:1 %1").arg(from, to)')
  println('                             : QStringLiteral("stop:0 %1, stop:1 %2").arg(from, to);')
  println('  style += QStringLiteral("QSlider::%1:%2%3 { background: qlineargradient(x1:%4,y1:0,x2:%5,y2:%6,%7);")')
  println('      .arg(QString::fromLatin1(part), axis, QString::fromLatin1(state)).arg(x1).arg(x2).arg(!across).arg(stops);')
  println('  style += QStringLiteral(" border: %1px solid %2; border-radius: %3px; }")')
  println('      .arg(qBound(0, stroke, 64)).arg(border).arg(qBound(0, radius / 2, 256));')
  println('}')
  println('class HiasmRushProgress : public QWidget {')
  println('public:')
  println('  using QWidget::QWidget;')
  println('  struct Skin { QColor from, to, text, border, shadow; int gradient, stroke, offset; };')
  println('  Skin normal{}, disabled{};')
  println('  QColor background;')
  println('  QString caption;')
  println('  int position = 0, maximum = 100, roundWidth = 0, roundHeight = 0;')
  println('  bool vertical = false, frame = false, drawProgress = true, transparent = false;')
  println('  void setPosition(int value) { position = qBound(0, value, maximum); update(); }')
  println('protected:')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    const auto &skin = isEnabled() ? normal : disabled;')
  println('    QPainter painter(this);')
  println('    painter.setRenderHint(QPainter::Antialiasing);')
  println('    const QRectF area = QRectF(rect()).adjusted(0.5, 0.5, -0.5, -0.5);')
  println('    if (area.isEmpty()) return;')
  println('    QPainterPath outline;')
  println('    outline.addRoundedRect(area, qMax(0, roundWidth) / 2.0, qMax(0, roundHeight) / 2.0);')
  println('    if (!transparent) painter.fillPath(outline, background);')
  println('    const double fraction = maximum > 0 ? double(position) / maximum : 0.0;')
  println('    QRectF filled = area;')
  println('    if (vertical) filled.setTop(area.bottom() - fraction * area.height());')
  println('    else filled.setWidth(fraction * area.width());')
  println('    if (!filled.isEmpty()) {')
  println('      painter.save();')
  println('      painter.setClipPath(outline);')
  println('      if (!skin.gradient) painter.fillRect(filled, skin.from);')
  println('      else {')
  println('        const bool across = skin.gradient == 2 || skin.gradient == 4;')
  println('        const bool diagonal = skin.gradient >= 5;')
  println('        const auto start = skin.gradient == 6 ? filled.topRight() : filled.topLeft();')
  println('        const auto end = diagonal ? (skin.gradient == 6 ? filled.bottomLeft() : filled.bottomRight()) :')
  println('            (across ? filled.topRight() : filled.bottomLeft());')
  println('        QLinearGradient gradient(start, end);')
  println('        gradient.setColorAt(0, skin.from);')
  println('        if (skin.gradient == 3 || skin.gradient == 4) gradient.setColorAt(0.5, skin.to);')
  println('        gradient.setColorAt(1, skin.gradient == 3 || skin.gradient == 4 ? skin.from : skin.to);')
  println('        painter.fillRect(filled, gradient);')
  println('      }')
  println('      painter.restore();')
  println('    }')
  println('    if (frame && skin.stroke > 0) { painter.setPen(QPen(skin.border, skin.stroke)); painter.drawPath(outline); }')
  println('    auto label = caption;')
  println('    if (drawProgress) label.replace(QChar(37), QString::number(qRound(fraction * 100)) + QChar(37));')
  println('    if (skin.offset) {')
  println('      painter.setPen(skin.shadow);')
  println('      painter.drawText(area.translated(skin.offset, skin.offset), Qt::AlignCenter, label);')
  println('    }')
  println('    painter.setPen(skin.text);')
  println('    painter.drawText(area, Qt::AlignCenter, label);')
  println('  }')
  println('};')
  println('static void qt_form_frame(QWidget &window, int border, bool resizable, bool clientSize, int width, int height) {')
  println('  const bool tool = border == 4 || border == 5;')
  println('  resizable = resizable && (border == 0 || border == 2 || border == 5 || border == 7 || border == 9);')
  println('  Qt::WindowFlags flags = (tool ? Qt::Tool : border == 3 ? Qt::Dialog : Qt::Window) | Qt::CustomizeWindowHint;')
  println('  if (border >= 1 && border <= 5) {')
  println('    flags |= Qt::WindowTitleHint | Qt::WindowSystemMenuHint | Qt::WindowCloseButtonHint;')
  println('    if (!tool && border != 3) flags |= Qt::WindowMinimizeButtonHint;')
  println('    if (border == 2 && resizable) flags |= Qt::WindowMaximizeButtonHint;')
  println('  } else if (border < 6) flags |= Qt::FramelessWindowHint;')
  println('  if (!resizable) flags |= Qt::MSWindowsFixedSizeDialogHint;')
  println('  window.setWindowFlags(flags);')
  println('  if (!clientSize && border) {')
  println('    window.winId();')
  println('    const auto frame = window.windowHandle()->frameMargins();')
  println('    width -= frame.left() + frame.right();')
  println('    height -= frame.top() + frame.bottom();')
  println('  }')
  println('  const QSize size(qMax(1, width), qMax(1, height));')
  println('  if (resizable) window.resize(size);')
  println('  else window.setFixedSize(size);')
  println('}')
  println('template<class T> static T* qt_widget(QWidget &form, const char *name) {')
  println('  const auto objectName = QString::fromLatin1(name);')
  println('  if (objectName.isEmpty()) return nullptr;')
  println('  return dynamic_cast<T*>(form.objectName() == objectName ? &form : form.findChild<QWidget*>(objectName));')
  println('}')
  println('class HiasmExternalCursor : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  ~HiasmExternalCursor() override { if (resetOnDestroy && target && target != parent()) reset(); }')
  println('  bool resetOnDestroy = true;')
  println('  bool load(QWidget *widget, const QString &file) {')
  println('    if (!widget) return false;')
  println('    QImageReader reader(file);')
  println('    const auto image = reader.read();')
  println('    if (image.isNull()) return false;')
  println('    if (target != widget) {')
  println('      if (target) reset();')
  println('      target = widget;')
  println('      original = widget->cursor();')
  println('      hadCursor = widget->testAttribute(Qt::WA_SetCursor);')
  println('    }')
  println('    QPoint hotspot(-1, -1);')
  println('    if (file.endsWith(QStringLiteral(".cur"), Qt::CaseInsensitive)) {')
  println('      QFile source(file);')
  println('      if (source.open(QIODevice::ReadOnly)) {')
  println('        const auto header = source.read(14);')
  println('        if (header.size() == 14 && qFromLittleEndian<quint16>(header.constData() + 2) == 2)')
  println('          hotspot = QPoint(qFromLittleEndian<quint16>(header.constData() + 10), qFromLittleEndian<quint16>(header.constData() + 12));')
  println('      }')
  println('    }')
  println('    target->setCursor(QCursor(QPixmap::fromImage(image), hotspot.x(), hotspot.y()));')
  println('    return true;')
  println('  }')
  println('  void reset() {')
  println('    if (!target) return;')
  println('    if (hadCursor) target->setCursor(original); else target->unsetCursor();')
  println('    target.clear();')
  println('  }')
  println('private:')
  println('  QPointer<QWidget> target;')
  println('  QCursor original;')
  println('  bool hadCursor = false;')
  println('};')
  println('class HiasmWindowAnimation : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  int duration = 500, activation = 0;')
  println('  bool center = false, slide = false, leftToRight = false, rightToLeft = false;')
  println('  bool topToBottom = false, bottomToTop = false;')
  println('  void run(QWidget *widget) const {')
  println('    if (!widget || widget->isHidden() == (activation != 0)) return;')
  println('#ifdef Q_OS_WIN')
  println('    DWORD flags = activation ? AW_HIDE : (widget->isWindow() ? AW_ACTIVATE : 0);')
  println('    if (center) flags |= AW_CENTER;')
  println('    else {')
  println('      if (slide) flags |= AW_SLIDE;')
  println('      if (leftToRight || (!rightToLeft && !topToBottom && !bottomToTop)) flags |= AW_HOR_POSITIVE;')
  println('      else if (rightToLeft) flags |= AW_HOR_NEGATIVE;')
  println('      if (topToBottom) flags |= AW_VER_POSITIVE; else if (bottomToTop) flags |= AW_VER_NEGATIVE;')
  println('    }')
  println('    if (duration > 0 && !widget->testAttribute(Qt::WA_DontShowOnScreen))')
  println('      AnimateWindow(reinterpret_cast<HWND>(widget->winId()), DWORD(duration), flags);')
  println('#endif')
  println('    widget->setVisible(activation == 0);')
  println('  }')
  println('};')
  println('class HiasmHighlighter : public QSyntaxHighlighter {')
  println('public:')
  println('  using QSyntaxHighlighter::QSyntaxHighlighter;')
  println('  bool active = true, caseSensitive = false;')
  println('  void addRules(const QString &source) {')
  println('    for (const auto &line : source.split(QChar(10), Qt::SkipEmptyParts)) {')
  println('      const auto fields = line.trimmed().split(QChar(61));')
  println('      if (fields.size() < 2 || fields.first().isEmpty()) continue;')
  println('      QTextCharFormat format;')
  println('      const auto color = qt_led_color(fields[1].trimmed(), QColor());')
  println('      if (color.isValid()) format.setForeground(color);')
  println('      for (qsizetype i = 2; i < fields.size(); ++i) {')
  println('        const auto style = fields[i].trimmed().toUpper();')
  println('        if (style == "U") format.setFontUnderline(true);')
  println('        if (style == "B") format.setFontWeight(QFont::Bold);')
  println('        if (style == "C") format.setFontItalic(true);')
  println('        if (style == "S") format.setFontStrikeOut(true);')
  println('      }')
  println('      rules.append({fields.first(), format});')
  println('    }')
  println('    rehighlight();')
  println('  }')
  println('protected:')
  println('  void highlightBlock(const QString &text) override {')
  println('    if (!active) return;')
  println('    const auto sensitivity = caseSensitive ? Qt::CaseSensitive : Qt::CaseInsensitive;')
  println('    for (const auto &[word, format] : rules) {')
  println('      for (qsizetype start = 0; (start = text.indexOf(word, start, sensitivity)) >= 0; start += word.size())')
  println('        setFormat(int(start), int(word.size()), format);')
  println('    }')
  println('  }')
  println('private:')
  println('  QList<QPair<QString, QTextCharFormat>> rules;')
  println('};')
  println('static void qt_apply_font(QWidget *control, QString description) {')
  println('  if (!control) return;')
  println('  description = description.trimmed();')
  println('  if (description.startsWith(QChar(91)) && description.endsWith(QChar(93))) description = description.mid(1, description.size() - 2);')
  println('  const auto fields = description.split(QChar(44));')
  println('  if (fields.size() < 4) return;')
  println('  QFont font = control->font();')
  println('  if (!fields[0].trimmed().isEmpty()) font.setFamily(fields[0].trimmed());')
  println('  const int size = fields[1].toInt();')
  println('  if (size > 0) font.setPointSize(size);')
  println('  const int style = fields[2].toInt();')
  println('  font.setBold(style & 1); font.setItalic(style & 2); font.setUnderline(style & 4); font.setStrikeOut(style & 8);')
  println('  control->setFont(font);')
  println('  auto palette = control->palette();')
  println('  const auto color = qt_led_color(fields[3], palette.color(control->foregroundRole()));')
  println('  palette.setColor(control->foregroundRole(), color);')
  println('  control->setPalette(palette);')
  println('  if (fields.size() > 4) control->setProperty("hiasmFontCharset", fields[4].toInt());')
  println('}')
  println('class HiasmGradientLabel : public HiasmClickable<QLabel> {')
  println('public:')
  println('  using HiasmClickable<QLabel>::HiasmClickable;')
  println('  QColor background, hover, shadow;')
  println('  int depth = 100, contrast = 80, backgroundContrast = 100, shadowDepth = 0;')
  println('  bool autoSize = true, textGradient = false, backgroundGradient = false;')
  println('  bool horizontal = false, backgroundHorizontal = false, reverse = false, backgroundReverse = false;')
  println('  bool smooth = false, underline = false, symbolGradient = false;')
  println('  void setCaption(const QString &value) { setText(value); if (autoSize) adjustSize(); update(); }')
  println('protected:')
  println('  void enterEvent(QEnterEvent *event) override { QLabel::enterEvent(event); update(); }')
  println('  void leaveEvent(QEvent *event) override { QLabel::leaveEvent(event); update(); }')
  println('  void paintEvent(QPaintEvent *) override {')
  println('    QPainter painter(this);')
  println('    painter.setRenderHint(QPainter::Antialiasing, smooth);')
  println('    const QRectF area(contentsRect());')
  println('    if (backgroundGradient) painter.fillRect(area, gradient(area, background, backgroundContrast, backgroundHorizontal, backgroundReverse));')
  println('    else if (autoFillBackground()) painter.fillRect(area, background);')
  println('    auto face = font();')
  println('    if (underline && underMouse()) face.setUnderline(true);')
  println('    QFontMetricsF metrics(face);')
  println('    const auto box = metrics.boundingRect(area, alignment(), text());')
  println('    QPainterPath glyphs;')
  println('    glyphs.addText(box.topLeft() + QPointF(0, metrics.ascent()), face, text());')
  println('    if (shadowDepth) painter.fillPath(glyphs.translated(shadowDepth, shadowDepth), shadow);')
  println('    const auto ink = underMouse() && hover != Qt::black ? hover : palette().color(foregroundRole());')
  println('    const int strength = qBound(0, contrast, 250) * qBound(0, depth, 250) / 100;')
  println('    if (textGradient && horizontal && symbolGradient) {')
  println('      for (const auto &run : layoutGlyphs(face, text())) {')
  println('        const auto indexes = run.glyphIndexes();')
  println('        const auto positions = run.positions();')
  println('        for (qsizetype i = 0; i < indexes.size(); ++i) {')
  println('          const auto path = run.rawFont().pathForGlyph(indexes[i]).translated(box.topLeft() + positions[i]);')
  println('          painter.fillPath(path, gradient(path.boundingRect(), ink, strength, true, reverse));')
  println('        }')
  println('      }')
  println('    } else if (textGradient) painter.fillPath(glyphs, gradient(box, ink, strength, horizontal, reverse));')
  println('    else painter.fillPath(glyphs, ink);')
  println('  }')
  println('private:')
  println('  static QList<QGlyphRun> layoutGlyphs(const QFont &font, const QString &text) {')
  println('    QTextLayout layout(text, font);')
  println('    layout.beginLayout();')
  println('    layout.createLine();')
  println('    layout.endLayout();')
  println('    return layout.glyphRuns();')
  println('  }')
  println('  static QLinearGradient gradient(const QRectF &area, QColor color, int contrast, bool horizontal, bool reverse) {')
  println('    QLinearGradient brush(area.topLeft(), horizontal ? area.topRight() : area.bottomLeft());')
  println('    const int factor = 100 + qBound(0, contrast, 250);')
  println('    brush.setColorAt(reverse ? 1 : 0, color.lighter(factor));')
  println('    brush.setColorAt(reverse ? 0 : 1, color.darker(factor));')
  println('    return brush;')
  println('  }')
  println('};')
  println('class HiasmHint : public QObject {')
  println('public:')
  println('  explicit HiasmHint(QWidget *target) : QObject(target), control(target), tip(target, Qt::ToolTip) {')
  println('    tip.setTextFormat(Qt::PlainText);')
  println('    tip.setAutoFillBackground(true);')
  println('    tip.setBackgroundRole(QPalette::ToolTipBase);')
  println('    tip.setForegroundRole(QPalette::ToolTipText);')
  println('    tip.setAttribute(Qt::WA_TransparentForMouseEvents);')
  println('    delay.setSingleShot(true);')
  println('    duration.setSingleShot(true);')
  println('    connect(&delay, &QTimer::timeout, this, [this] { showTip(); });')
  println('    connect(&duration, &QTimer::timeout, &tip, &QWidget::hide);')
  println('    control->installEventFilter(this);')
  println('  }')
  println('  bool custom = false;')
  println('  std::function<void(const QString &)> shown, changed;')
  println('  std::function<void()> hidden;')
  println('  void configure(const QString &font, const QString &background, int margin, int width, int wait, int lifetime, bool track, bool balloon) {')
  println('    qt_apply_font(&tip, font);')
  println('    auto palette = tip.palette();')
  println('    palette.setColor(QPalette::ToolTipBase, qt_led_color(background, palette.color(QPalette::ToolTipBase)));')
  println('    tip.setPalette(palette);')
  println('    tip.setMargin(qMax(0, margin) + 3);')
  println('    tip.setFrameShape(balloon ? QFrame::StyledPanel : QFrame::Box);')
  println('    tip.setWordWrap(width > 0);')
  println('    if (width > 0) tip.setMaximumWidth(width);')
  println('    delay.setInterval(wait < 0 ? 500 : wait);')
  println('    duration.setInterval(lifetime < 0 ? 5000 : lifetime);')
  println('    following = track;')
  println('    if (following) control->setMouseTracking(true);')
  println('  }')
  println('protected:')
  println('  bool eventFilter(QObject *, QEvent *event) override {')
  println('    if (custom) {')
  println('      switch (event->type()) {')
  println('      case QEvent::ToolTip:')
  println('        if (!customVisible && !control->toolTip().isEmpty()) {')
  println('          customVisible = true;')
  println('          if (shown) shown(control->toolTip());')
  println('        }')
  println('        return true;')
  println('      case QEvent::ToolTipChange:')
  println('        if (customVisible && changed) changed(control->toolTip());')
  println('        break;')
  println('      case QEvent::Leave: case QEvent::Hide: case QEvent::MouseButtonPress:')
  println('        if (customVisible) { customVisible = false; if (hidden) hidden(); }')
  println('        break;')
  println('      default: break;')
  println('      }')
  println('      return false;')
  println('    }')
  println('    switch (event->type()) {')
  println('    case QEvent::Enter: if (!following) delay.start(); break;')
  println('    case QEvent::MouseMove:')
  println('      if (following) showTip();')
  println('      else if (!tip.isVisible()) delay.start();')
  println('      break;')
  println('    case QEvent::ToolTip: return true;')
  println('    case QEvent::Leave: case QEvent::Hide: case QEvent::MouseButtonPress: delay.stop(); duration.stop(); tip.hide(); break;')
  println('    default: break;')
  println('    }')
  println('    return false;')
  println('  }')
  println('private:')
  println('  void showTip() {')
  println('    if (!control->isVisible() || control->toolTip().isEmpty()) return;')
  println('    tip.setText(control->toolTip());')
  println('    tip.adjustSize();')
  println('    const auto cursor = QCursor::pos();')
  println('    auto position = cursor + QPoint(12, 18);')
  println('    if (auto *screen = QGuiApplication::screenAt(cursor)) {')
  println('      const auto bounds = screen->availableGeometry();')
  println('      position.setX(qBound(bounds.left(), position.x(), qMax(bounds.left(), bounds.right() - tip.width() + 1)));')
  println('      position.setY(qBound(bounds.top(), position.y(), qMax(bounds.top(), bounds.bottom() - tip.height() + 1)));')
  println('    }')
  println('    tip.move(position); tip.show();')
  println('    if (!following) duration.start();')
  println('  }')
  println('  QWidget *control;')
  println('  QLabel tip;')
  println('  QTimer delay, duration;')
  println('  bool following = false;')
  println('  bool customVisible = false;')
  println('};')
  println('class HiasmTransparency : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QPointer<HiasmForm> target;')
  println('  QImage picture;')
  println('  QRgb key = qRgb(255, 255, 255);')
  println('  int opacity = 255;')
  println('  bool pixelAlpha = false;')
  println('  void apply() {')
  println('    if (!target) return;')
  println('    target->setWindowOpacity(qBound(0, opacity, 255) / 255.0);')
  println('    auto image = picture.convertToFormat(QImage::Format_ARGB32);')
  println('    for (int y = 0; y < image.height(); ++y) {')
  println('      auto *line = reinterpret_cast<QRgb *>(image.scanLine(y));')
  println('      if (!pixelAlpha) for (int x = 0; x < image.width(); ++x)')
  println('        line[x] = (line[x] | 0xff000000u) == key ? 0 : (line[x] | 0xff000000u);')
  println('    }')
  println('    target->backgroundPicture = image;')
  println('    if (image.isNull()) target->clearMask();')
  println('    else {')
  println('      target->resize(image.size());')
  println('      target->setMask(QBitmap::fromImage(image.createAlphaMask()));')
  println('    }')
  println('    target->update();')
  println('  }')
  println('};')
  println('class HiasmBoxLayout : public QObject {')
  println('public:')
  println('  struct Item { QString name; bool layout, spacer; int x, y, width, height, widthScale, heightScale; };')
  println('  HiasmBoxLayout(QWidget *owner, QWidget &root) : QObject(owner), owner(owner), root(root) {}')
  println('  bool horizontal = false, byPosition = false, nested = false;')
  println('  bool wrap = false, autoHeight = false;')
  println('  int padding = 0, spacing = 0, columns = 0;')
  println('  void load(const QByteArray &json) {')
  println('    for (const auto entry : QJsonDocument::fromJson(json).array()) {')
  println('      const auto a = entry.toArray();')
  println('      items.append(Item{a[0].toString(), a[1].toBool(), a[2].toBool(), a[3].toInt(), a[4].toInt(),')
  println('        a[5].toInt(), a[6].toInt(), qBound(0, a[7].toInt(), 100), qBound(0, a[8].toInt(), 100)});')
  println('    }')
  println('    sort();')
  println('    if (!nested) { owner->installEventFilter(this); QTimer::singleShot(0, this, [this] { resize(); }); }')
  println('  }')
  println('  void sort() {')
  println('    if (byPosition) std::stable_sort(items.begin(), items.end(), [this](const Item &a, const Item &b) {')
  println('      if (columns || wrap) return a.y == b.y ? a.x < b.x : a.y < b.y;')
  println('      return horizontal ? a.x < b.x : a.y < b.y;')
  println('    });')
  println('  }')
  println('  QSize preferred() const {')
  println('    if (columns) {')
  println('      const auto widths = gridTracks(true, -1);')
  println('      const auto heights = gridTracks(false, -1);')
  println('      const auto extent = [this](const QList<int> &tracks) {')
  println('        int size = qMax(0, int(tracks.size()) - 1) * spacing + padding * 2;')
  println('        for (int track : tracks) size += track;')
  println('        return size;')
  println('      };')
  println('      return QSize(extent(widths), extent(heights));')
  println('    }')
  println('    int axis = qMax(0, int(items.size()) - 1) * spacing, cross = 0;')
  println('    for (const auto &item : items) {')
  println('      const auto size = baseSize(item);')
  println('      axis += horizontal ? size.width() : size.height();')
  println('      cross = qMax(cross, horizontal ? size.height() : size.width());')
  println('    }')
  println('    return (horizontal ? QSize(axis, cross) : QSize(cross, axis)) + QSize(padding * 2, padding * 2);')
  println('  }')
  println('  void resize() { arrange(nested && lastArea.isValid() ? lastArea : owner->contentsRect()); }')
  println('  void arrange(const QRect &bounds) {')
  println('    lastArea = bounds;')
  println('    const auto inner = bounds.adjusted(padding, padding, -padding, -padding);')
  println('    if (wrap) {')
  println('      int x = inner.x(), y = inner.y(), rowHeight = 0;')
  println('      for (const auto &item : items) {')
  println('        if (item.layout || item.spacer) continue;')
  println('        const auto size = baseSize(item);')
  println('        if (x > inner.x() && x + size.width() > inner.x() + inner.width()) {')
  println('          x = inner.x();')
  println('          y += rowHeight + spacing;')
  println('          rowHeight = 0;')
  println('        }')
  println('        place(item, QRect(QPoint(x, y), size));')
  println('        x += size.width() + spacing;')
  println('        rowHeight = qMax(rowHeight, size.height());')
  println('      }')
  println('      const int height = qMax(0, y - bounds.y() + rowHeight + padding);')
  println('      if (autoHeight && !nested && owner->height() != height) owner->resize(owner->width(), height);')
  println('      return;')
  println('    }')
  println('    if (columns) {')
  println('      const auto widths = gridTracks(true, qMax(0, inner.width()));')
  println('      const auto heights = gridTracks(false, qMax(0, inner.height()));')
  println('      int y = inner.y();')
  println('      for (qsizetype row = 0; row < heights.size(); ++row) {')
  println('        int x = inner.x();')
  println('        for (qsizetype col = 0; col < widths.size(); ++col) {')
  println('          const auto index = row * columns + col;')
  println('          if (index < items.size()) place(items[index], QRect(x, y, widths[col], heights[row]));')
  println('          x += widths[col] + spacing;')
  println('        }')
  println('        y += heights[row] + spacing;')
  println('      }')
  println('      return;')
  println('    }')
  println('    int available = (horizontal ? inner.width() : inner.height()) - qMax(0, int(items.size()) - 1) * spacing;')
  println('    for (const auto &item : items) {')
  println('      const auto size = baseSize(item);')
  println('      if (!(horizontal ? item.widthScale : item.heightScale)) available -= horizontal ? size.width() : size.height();')
  println('    }')
  println('    available = qMax(0, available);')
  println('    int offset = horizontal ? inner.x() : inner.y();')
  println('    for (const auto &item : items) {')
  println('      const auto base = baseSize(item);')
  println('      const bool stretch = item.layout;')
  println('      const int w = horizontal ? (item.widthScale ? qRound(available * (item.widthScale / 100.0)) : base.width())')
  println('                               : (item.widthScale || stretch ? qRound(qMax(0, inner.width()) * ((item.widthScale ? item.widthScale : 100) / 100.0)) : base.width());')
  println('      const int h = !horizontal ? (item.heightScale ? qRound(available * (item.heightScale / 100.0)) : base.height())')
  println('                                : (item.heightScale || stretch ? qRound(qMax(0, inner.height()) * ((item.heightScale ? item.heightScale : 100) / 100.0)) : base.height());')
  println('      const QRect area(horizontal ? offset : inner.x(), horizontal ? inner.y() : offset, w, h);')
  println('      place(item, area);')
  println('      offset += (horizontal ? w : h) + spacing;')
  println('    }')
  println('  }')
  println('protected:')
  println('  bool eventFilter(QObject *watched, QEvent *event) override {')
  println('    if (watched == owner && (event->type() == QEvent::Resize || event->type() == QEvent::Show)) resize();')
  println('    return false;')
  println('  }')
  println('private:')
  println('  QList<int> gridTracks(bool width, int extent) const {')
  println('    const qsizetype count = width ? qMin<qsizetype>(columns, items.size()) : (items.size() + columns - 1) / columns;')
  println('    QList<int> sizes, scales;')
  println('    int available = extent - qMax(0, int(count) - 1) * spacing;')
  println('    for (qsizetype track = 0; track < count; ++track) {')
  println('      const auto &item = items[width ? track : track * columns];')
  println('      const auto base = baseSize(item);')
  println('      sizes.append(width ? base.width() : base.height());')
  println('      scales.append(width ? item.widthScale : item.heightScale);')
  println('      if (!scales.last()) available -= sizes.last();')
  println('    }')
  println('    if (extent >= 0) for (qsizetype track = 0; track < count; ++track)')
  println('      if (scales[track]) sizes[track] = qRound(qMax(0, available) * (scales[track] / 100.0));')
  println('    return sizes;')
  println('  }')
  println('  void place(const Item &item, const QRect &area) {')
  println('    if (item.layout) { if (auto *layout = child(item)) layout->arrange(area); }')
  println('    else if (!item.spacer) {')
  println('      auto *widget = qt_widget<QWidget>(root, item.name.toUtf8().constData());')
  println('      if (widget && widget->parentWidget() == owner) widget->setGeometry(area);')
  println('    }')
  println('  }')
  println('  HiasmBoxLayout *child(const Item &item) const { return dynamic_cast<HiasmBoxLayout *>(owner->findChild<QObject *>(item.name, Qt::FindDirectChildrenOnly)); }')
  println('  QSize baseSize(const Item &item) const {')
  println('    if (item.layout) { if (const auto *layout = child(item)) return layout->preferred(); }')
  println('    return QSize(qMax(0, item.width), qMax(0, item.height));')
  println('  }')
  println('  QWidget *owner;')
  println('  QWidget &root;')
  println('  QList<Item> items;')
  println('  QRect lastArea;')
  println('};')
  println('class HiasmPopupMenuEx : public QMenu {')
  println('public:')
  println('  using QMenu::QMenu;')
  println('  QList<QAction *> entries;')
  println('  QPointer<QMenuBar> bar;')
  println('  std::function<void(int, const QString &)> chosen;')
  println('  QList<QImage> images;')
  println('  bool indexedIcons = false;')
  println('  int iconShift = 0, iconSize = 16;')
  println('  void setSavedImages(const QString &source) {')
  println('    images.clear();')
  println('    static const QRegularExpression bitmap(QStringLiteral("[[]ZIP[0-9A-Fa-f]+[]]|[[]]"));')
  println('    for (auto match = bitmap.globalMatch(source); match.hasNext();) images.append(qt_bitmap(match.next().captured()));')
  println('    refreshIcons();')
  println('  }')
  println('  void refreshIcons() {')
  println('    int nextIcon = iconShift;')
  println('    for (auto *action : entries) {')
  println('      if (action->isSeparator()) continue;')
  println('      QIcon icon;')
  println('      const auto indexes = indexedIcons ? action->property("hiasmIconIndexes").toList() : QVariantList{nextIcon++};')
  println('      for (qsizetype state = 0; state < indexes.size(); ++state) {')
  println('        auto image = images.value(indexes[state].toInt());')
  println('        if (image.isNull()) continue;')
  println('        image = image.convertToFormat(QImage::Format_ARGB32);')
  println('        for (int y = 0; y < image.height(); ++y) {')
  println('          auto *pixels = reinterpret_cast<QRgb *>(image.scanLine(y));')
  println('          for (int x = 0; x < image.width(); ++x) if ((pixels[x] & 0xffffffu) == 0xff00ffu) pixels[x] = 0;')
  println('        }')
  println('        icon.addPixmap(QPixmap::fromImage(image.scaled(iconSize, iconSize, Qt::KeepAspectRatio, Qt::SmoothTransformation)),')
  println('                       state == 1 ? QIcon::Active : state == 2 ? QIcon::Disabled : QIcon::Normal);')
  println('      }')
  println('      action->setIcon(icon);')
  println('    }')
  println('  }')
  println('  void attachBar() {')
  println('    auto *owner = parentWidget();')
  println('    bar = new QMenuBar(owner);')
  println('    bar->setNativeMenuBar(false);')
  println('    owner->installEventFilter(this);')
  println('    placeBar();')
  println('  }')
  println('  void rebuild(const QString &source) {')
  println('    if (bar) bar->clear();')
  println('    entries.clear();')
  println('    QList<QPointer<QMenu>> children;')
  println('    for (auto *child : findChildren<QMenu *>(QString(), Qt::FindDirectChildrenOnly)) children.append(QPointer<QMenu>(child));')
  println('    clear();')
  println('    for (const auto &child : children) if (child) delete child.data();')
  println('    QList<QMenu *> stack{this};')
  println('    auto lines = source.split(QChar(10));')
  println('    for (auto &line : lines) if (line.endsWith(QChar(13))) line.chop(1);')
  println('    for (qsizetype i = 0; i < lines.size(); ++i) {')
  println('      const auto &line = lines[i];')
  println('      if (line == QStringLiteral(")")) { if (stack.size() > 1) stack.removeLast(); continue; }')
  println('      if (line.isEmpty() || line == QStringLiteral("(")) continue;')
  println('      auto *menu = stack.last();')
  println('      if (line == QStringLiteral("-")) { entries.append(menu->addSeparator()); continue; }')
  println('      const auto fields = line.split(QChar(9));')
  println('      auto caption = fields.first();')
  println('      QVariantList iconIndexes;')
  println('      if (indexedIcons) {')
  println('        static const QRegularExpression prefix(QStringLiteral("^<(-?[0-9]+(?:,-?[0-9]+){0,2})>"));')
  println('        const auto match = prefix.match(caption);')
  println('        if (match.hasMatch()) {')
  println('          for (const auto &number : match.captured(1).split(QChar(44))) {')
  println('            bool valid = false; const int index = number.toInt(&valid);')
  println('            iconIndexes.append(valid ? index : -1);')
  println('          }')
  println('          caption.remove(0, match.capturedLength());')
  println('        }')
  println('      }')
  println('      if (lines.value(i + 1) == QStringLiteral("(")) {')
  println('        auto *submenu = menu->addMenu(caption);')
  println('        entries.append(submenu->menuAction());')
  println('        stack.append(submenu); ++i;')
  println('      } else {')
  println('        auto *action = menu->addAction(caption);')
  println('        if (fields.size() > 1) action->setShortcut(QKeySequence(fields[1]));')
  println('        entries.append(action);')
  println('        if (bar) connect(action, &QAction::triggered, this, [this, action] {')
  println('          const int index = int(entries.indexOf(action));')
  println('          const auto caption = action->text();')
  println('          if (index >= 0 && chosen) chosen(index, caption);')
  println('        });')
  println('      }')
  println('      entries.last()->setProperty("hiasmIconIndexes", iconIndexes);')
  println('    }')
  println('    refreshIcons();')
  println('    if (bar) { bar->addActions(actions()); placeBar(); }')
  println('  }')
  println('protected:')
  println('  bool eventFilter(QObject *watched, QEvent *event) override {')
  println('    if (watched == parentWidget() && (event->type() == QEvent::Resize || event->type() == QEvent::Show)) placeBar();')
  println('    return QMenu::eventFilter(watched, event);')
  println('  }')
  println('private:')
  println('  void placeBar() { if (bar) { bar->setGeometry(0, 0, parentWidget()->width(), bar->sizeHint().height()); bar->raise(); } }')
  println('};')
  println('class HiasmMenuBar : public QMenuBar {')
  println('public:')
  println('  explicit HiasmMenuBar(QWidget *parent) : QMenuBar(parent) {')
  println('    setNativeMenuBar(false);')
  println('    parent->installEventFilter(this);')
  println('  }')
  println('  std::function<void(int, const QString &)> selected;')
  println('  void rebuild(const QStringList &items) {')
  println('    clear();')
  println('    for (auto *object : findChildren<QObject *>(QString(), Qt::FindDirectChildrenOnly))')
  println('      if (qobject_cast<QMenu *>(object) || qobject_cast<QAction *>(object)) object->deleteLater();')
  println('    QList<QMenu *> parents;')
  println('    int index = 0;')
  println('    for (qsizetype i = 0; i < items.size(); ++i) {')
  println('      const auto &item = items.at(i);')
  println('      if (item == QStringLiteral(")")) { if (!parents.isEmpty()) parents.removeLast(); continue; }')
  println('      if (item.isEmpty() || item == QStringLiteral("(")) continue;')
  println('      auto *parent = parents.isEmpty() ? nullptr : parents.last();')
  println('      if (item == QStringLiteral("-")) { if (parent) parent->addSeparator(); else addSeparator(); continue; }')
  println('      const auto fields = item.split(QChar(9));')
  println('      const auto caption = fields.first();')
  println('      if (items.value(i + 1) == QStringLiteral("(")) {')
  println('        parents.append(parent ? parent->addMenu(caption) : addMenu(caption));')
  println('        ++i;')
  println('      } else {')
  println('        auto *action = parent ? parent->addAction(caption) : addAction(caption);')
  println('        if (fields.size() > 1) action->setShortcut(QKeySequence(fields.at(1)));')
  println('        connect(action, &QAction::triggered, this, [this, number = index++, caption] {')
  println('          if (selected) selected(number, caption);')
  println('        });')
  println('      }')
  println('    }')
  println('    place();')
  println('  }')
  println('  template<class List> void fromArray(const List &values) {')
  println('    QStringList items;')
  println('    for (const auto &value : values) items.append(qt_text(value));')
  println('    rebuild(items);')
  println('  }')
  println('protected:')
  println('  bool eventFilter(QObject *watched, QEvent *event) override {')
  println('    if (watched == parentWidget() && (event->type() == QEvent::Resize || event->type() == QEvent::Show)) place();')
  println('    return QMenuBar::eventFilter(watched, event);')
  println('  }')
  println('private:')
  println('  void place() { setGeometry(0, 0, parentWidget()->width(), sizeHint().height()); raise(); }')
  println('};')
  println('class HiasmStaticData : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QStringList columns;')
  println('  QList<QStringList> rows;')
  println('  bool reading = false;')
  println('  std::function<void()> open, close;')
  println('  bool beginRead() {')
  println('    if (reading) return false;')
  println('    reading = true;')
  println('    if (open) open();')
  println('    return true;')
  println('  }')
  println('  void endRead() {')
  println('    if (close) close();')
  println('    reading = false;')
  println('  }')
  println('  void load(const QString &headers, const QString &data) {')
  println('    const auto lines = [](const QString &text) {')
  println('      auto result = text.split(QChar(10));')
  println('      if (!result.isEmpty() && result.last().isEmpty()) result.removeLast();')
  println('      for (auto &line : result) if (line.endsWith(QChar(13))) line.chop(1);')
  println('      return result;')
  println('    };')
  println('    columns = lines(headers);')
  println('    rows.clear();')
  println('    for (const auto &line : lines(data)) {')
  println('      auto row = line.split(QChar(124));')
  println('      row.resize(columns.size());')
  println('      rows.append(std::move(row));')
  println('    }')
  println('  }')
  println('};')
  println('static QStringList qt_data_cells(const QString &cell) { return {cell}; }')
  println('static QStringList qt_data_cells(QStringList cells) { return cells; }')
  println('class HiasmDataReader : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QString column, item;')
  println('  int index = -1;')
  println('};')
  println('class HiasmBoxDraw : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QColor light, dark, border, text;')
  println('  bool gradient = true, horizontal = false, reverse = false, frame = true, flat = false;')
  println('  QList<QPointer<QAbstractItemView>> views;')
  println('  void refresh() { for (const auto &view : views) if (view) view->viewport()->update(); }')
  println('};')
  println('class HiasmBoxDrawDelegate : public QStyledItemDelegate {')
  println('public:')
  println('  HiasmBoxDrawDelegate(QAbstractItemView *view, HiasmBoxDraw *settings) : QStyledItemDelegate(view), settings(settings) {}')
  println('  void paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const override {')
  println('    if (!settings || !(option.state & QStyle::State_Selected)) { QStyledItemDelegate::paint(painter, option, index); return; }')
  println('    auto adjusted = option;')
  println('    const auto foreground = settings->text.isValid() ? settings->text : option.palette.color(QPalette::HighlightedText);')
  println('    if (settings->gradient) {')
  println('      const auto dark = settings->dark.isValid() ? settings->dark : option.palette.color(QPalette::Highlight);')
  println('      const auto light = settings->light.isValid() ? settings->light : dark.lighter(135);')
  println('      QLinearGradient fill(option.rect.topLeft(), settings->horizontal ? option.rect.topRight() : option.rect.bottomLeft());')
  println('      fill.setColorAt(0, settings->reverse ? dark : light);')
  println('      fill.setColorAt(1, settings->reverse ? light : dark);')
  println('      adjusted.palette.setBrush(QPalette::Highlight, settings->flat ? QBrush(dark) : QBrush(fill));')
  println('    }')
  println('    adjusted.palette.setColor(QPalette::HighlightedText, foreground);')
  println('    QStyledItemDelegate::paint(painter, adjusted, index);')
  println('    if (settings->frame) {')
  println('      painter->save();')
  println('      painter->setPen(settings->border.isValid() ? settings->border : option.palette.color(QPalette::Dark));')
  println('      painter->setBrush(Qt::NoBrush);')
  println('      painter->drawRect(option.rect.adjusted(0, 0, -1, -1));')
  println('      painter->restore();')
  println('    }')
  println('  }')
  println('private:')
  println('  QPointer<HiasmBoxDraw> settings;')
  println('};')
  println('static void qt_box_draw(QAbstractItemView *view, QWidget &form, const QString &name) {')
  println('  if (!view || name.isEmpty()) return;')
  println('  if (auto *settings = dynamic_cast<HiasmBoxDraw *>(form.findChild<QObject *>(name))) {')
  println('    view->setItemDelegate(new HiasmBoxDrawDelegate(view, settings));')
  println('    settings->views.append(QPointer<QAbstractItemView>(view));')
  println('  }')
  println('}')
  println('class HiasmControlPalette : public QFrame {')
  println('public:')
  println('  explicit HiasmControlPalette(QWidget *parent) : QFrame(parent) {')
  println('    setFrameShape(QFrame::Box);')
  println('    auto *layout = new QVBoxLayout(this);')
  println('    layout->setContentsMargins(1, 1, 1, 1);')
  println('    layout->setSpacing(0);')
  println('    title = new QToolButton(this);')
  println('    title->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);')
  println('    title->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);')
  println('    list = new QListWidget(this);')
  println('    list->setFrameShape(QFrame::NoFrame);')
  println('    layout->addWidget(title);')
  println('    layout->addWidget(list);')
  println('    connect(title, &QToolButton::clicked, this, [this] { setExpanded(!expanded, true); });')
  println('    connect(list, &QListWidget::itemClicked, this, [this](QListWidgetItem *row) {')
  println('      const auto text = row->text();')
  println('      if (clicked) clicked(text);')
  println('      if (collapseOnSelect) setExpanded(false, false);')
  println('    });')
  println('  }')
  println('  QListWidget *list;')
  println('  QToolButton *title;')
  println('  int itemHeight = 17, padding = 3;')
  println('  bool expanded = true, collapseOnSelect = false;')
  println('  std::function<void(const QString &)> clicked;')
  println('  std::function<void(int)> stateChanged;')
  println('  void setExpanded(bool value, bool notify) {')
  println('    const bool changed = expanded != value;')
  println('    expanded = value;')
  println('    title->setArrowType(value ? Qt::DownArrow : Qt::RightArrow);')
  println('    list->setVisible(value);')
  println('    updateHeight();')
  println('    if (changed && notify && stateChanged) stateChanged(int(value));')
  println('  }')
  println('  void updateHeight() {')
  println('    const auto content = qint64(list->count()) * itemHeight + 2 * padding;')
  println('    resize(width(), title->sizeHint().height() + 2 + (expanded ? int(qBound(qint64(0), content, qint64(16777100))) : 0));')
  println('  }')
  println('  void insertText(int index, const QString &text) {')
  println('    auto *row = new QListWidgetItem(text);')
  println('    row->setSizeHint(QSize(0, itemHeight));')
  println('    list->insertItem(index, row);')
  println('  }')
  println('  void setStrings(const QString &text) {')
  println('    list->clear();')
  println('    auto lines = text.split(QChar(10));')
  println('    if (lines.last().isEmpty()) lines.removeLast();')
  println('    for (auto line : lines) {')
  println('      if (line.endsWith(QChar(13))) line.chop(1);')
  println('      insertText(list->count(), line);')
  println('    }')
  println('    updateHeight();')
  println('  }')
  println('  QString strings() const {')
  println('    QStringList lines;')
  println('    for (int row = 0; row < list->count(); ++row) lines.append(list->item(row)->text());')
  println('    return lines.join(QString(QChar(13)) + QChar(10));')
  println('  }')
  println('};')
