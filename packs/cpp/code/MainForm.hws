  println('static GdkPixbuf *hiasm_pixbuf_from_text(const std::string &text)')
  println('{')
  println('  if(text.empty()) return NULL;')
  println('  gsize size = 0;')
  println('  guchar *data = g_base64_decode(text.c_str(), &size);')
  println('  if(!data || !size) { g_free(data); return NULL; }')
  println('  GdkPixbuf *pixbuf = NULL;')
  println('  GdkPixbufLoader *loader = gdk_pixbuf_loader_new();')
  println('  if(gdk_pixbuf_loader_write(loader, data, size, NULL) && gdk_pixbuf_loader_close(loader, NULL)) {')
  println('    pixbuf = gdk_pixbuf_loader_get_pixbuf(loader);')
  println('    if(pixbuf) g_object_ref(pixbuf);')
  println('  }')
  println('  g_object_unref(loader);')
  println('  g_free(data);')
  println('  return pixbuf;')
  println('}')
  println('')
  println('static void hiasm_set_icon(GtkWindow *window, const std::string &text)')
  println('{')
  println('  GdkPixbuf *pixbuf = hiasm_pixbuf_from_text(text);')
  println('  if(!pixbuf) return;')
  println('  hiasm_win_set_icon(window, pixbuf);')
  println('  g_object_unref(pixbuf);')
  println('}')
  println('')
  println('static void hiasm_set_picture(GtkWindow *window, const std::string &text)')
  println('{')
  println('  GdkPixbuf *pixbuf = hiasm_pixbuf_from_text(text);')
  println('  if(!pixbuf) {')
  println('    gtk_picture_set_paintable(GTK_PICTURE(hiasm_picture), NULL);')
  println('    hiasm_win_shape(window, NULL);')
  println('    return;')
  println('  }')
  println('  GdkTexture *texture = gdk_texture_new_for_pixbuf(pixbuf);')
  println('  gtk_picture_set_paintable(GTK_PICTURE(hiasm_picture), GDK_PAINTABLE(texture));')
  println('  g_object_unref(texture);')
  println('  hiasm_win_shape(window, pixbuf);')
  println('  g_object_unref(pixbuf);')
  println('}')
