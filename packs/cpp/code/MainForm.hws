  println('static void hiasm_message_response(GtkDialog *dialog, int response, gpointer data)')
  println('{')
  println('  *static_cast<int*>(data) = response;')
  println('  GMainLoop *loop = static_cast<GMainLoop*>(g_object_get_data(G_OBJECT(dialog), "hiasm-message-loop"));')
  println('  if(loop) g_main_loop_quit(loop);')
  println('}')
  println('')
  println('static int hiasm_message(const char *text, const char *caption, int type, const char *icon)')
  println('{')
  println('  (void)icon;')
  println('  GtkButtonsType buttons = GTK_BUTTONS_OK;')
  println('  switch(type) {')
  println('    case 0: buttons = GTK_BUTTONS_NONE; break;')
  println('    case 1: buttons = GTK_BUTTONS_OK; break;')
  println('    case 2: buttons = GTK_BUTTONS_CLOSE; break;')
  println('    case 3: buttons = GTK_BUTTONS_CANCEL; break;')
  println('    case 4: buttons = GTK_BUTTONS_YES_NO; break;')
  println('    case 5: buttons = GTK_BUTTONS_OK_CANCEL; break;')
  println('  }')
  println('  GtkWidget *dialog = gtk_message_dialog_new(NULL, GTK_DIALOG_MODAL, GTK_MESSAGE_INFO, buttons, "%s", text ? text : "");')
  println('  gtk_window_set_title(GTK_WINDOW(dialog), caption ? caption : "");')
  println('  int response = 0;')
  println('  GMainLoop *loop = g_main_loop_new(NULL, FALSE);')
  println('  g_object_set_data(G_OBJECT(dialog), "hiasm-message-loop", loop);')
  println('  g_signal_connect(dialog, "response", G_CALLBACK(hiasm_message_response), &response);')
  println('  gtk_widget_set_visible(dialog, TRUE);')
  println('  g_main_loop_run(loop);')
  println('  gtk_window_destroy(GTK_WINDOW(dialog));')
  println('  g_main_loop_unref(loop);')
  println('  return response;')
  println('}')
  println('')
  println('static int hiasm_message(const char *text, const char *caption)')
  println('{')
  println('  return hiasm_message(text, caption, 1, "");')
  println('}')
  println('')
  println('struct HiasmClipboardState { GMainLoop *loop; std::string text; };')
  println('')
  println('static void hiasm_clipboard_done(GObject *source, GAsyncResult *result, gpointer user_data)')
  println('{')
  println('  HiasmClipboardState *state = static_cast<HiasmClipboardState*>(user_data);')
  println('  GError *error = NULL;')
  println('  char *text = gdk_clipboard_read_text_finish(GDK_CLIPBOARD(source), result, &error);')
  println('  if(text) { state->text = text; g_free(text); }')
  println('  if(error) g_error_free(error);')
  println('  if(state->loop) g_main_loop_quit(state->loop);')
  println('}')
  println('')
  println('static std::string hiasm_clipboard_text()')
  println('{')
  println('  GdkClipboard *clipboard = gdk_display_get_clipboard(gdk_display_get_default());')
  println('  HiasmClipboardState state;')
  println('  state.loop = g_main_loop_new(NULL, FALSE);')
  println('  gdk_clipboard_read_text_async(clipboard, NULL, hiasm_clipboard_done, &state);')
  println('  g_main_loop_run(state.loop);')
  println('  g_main_loop_unref(state.loop);')
  println('  return state.text;')
  println('}')
