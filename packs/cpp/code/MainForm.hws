  println('class HiasmStatusBar : public QStatusBar {')
  println('public:')
  println('  explicit HiasmStatusBar(QWidget *parent) : QStatusBar(parent) { parent->installEventFilter(this); }')
  println('  QList<QLabel *> panels;')
  println('  QLabel *summary = nullptr;')
  println('  QStringList messages;')
  println('  QProgressBar *progress = nullptr;')
  println('  int progressPanel = -1;')
  println('  bool progressVisible = false, panelHint = false;')
  println('  QString progressHint;')
  println('  QLabel *progressLabel() const { return progressPanel == panels.size() ? summary : panels.value(progressPanel); }')
  println('  void syncProgress() {')
  println('    if (!progress) return;')
  println('    auto *label = progressLabel();')
  println('    progress->setVisible(progressVisible && label);')
  println('    if (!label) return;')
  println('    progress->setGeometry(label->rect());')
  println('    progress->setToolTip(panelHint ? label->text() : progressHint);')
  println('  }')
  println('  void setProgressPanel(int index) {')
  println('    if (!progress) return;')
  println('    if (auto *old = progressLabel()) old->removeEventFilter(this);')
  println('    progressPanel = index;')
  println('    auto *label = progressLabel();')
  println('    progress->setParent(label ? static_cast<QWidget *>(label) : this);')
  println('    if (label) label->installEventFilter(this);')
  println('    syncProgress();')
  println('  }')
  println('  void place() {')
  println('    const int height = sizeHint().height();')
  println('    setGeometry(0, qMax(0, parentWidget()->height() - height), parentWidget()->width(), height);')
  println('    raise();')
  println('  }')
  println('  void setPanelText(int index, const QString &text) {')
  println('    if (index == panels.size()) summary->setText(text);')
  println('    else if (auto *panel = panels.value(index)) panel->setText(text);')
  println('    if (index == progressPanel) syncProgress();')
  println('  }')
  println('protected:')
  println('  bool eventFilter(QObject *object, QEvent *event) override {')
  println('    if (object == progressLabel() && event->type() == QEvent::Resize) syncProgress();')
  println('    if (object == parentWidget() && (event->type() == QEvent::Resize || event->type() == QEvent::Show)) place();')
  println('    return QStatusBar::eventFilter(object, event);')
  println('  }')
  println('};')
  println('static QImage qt_bitmap(const QString &value, const QByteArray &format = "bmp") {')
  println('  if (!value.startsWith(QStringLiteral("[ZIP"))) {')
  println('    if (value.size() > 6 * 1024 * 1024) return {};')
  println('    auto bytes = QByteArray::fromBase64(value.toLatin1());')
  println('    QBuffer buffer(&bytes); buffer.open(QIODevice::ReadOnly);')
  println('    QImageReader reader(&buffer);')
  println('    const auto size = reader.size();')
  println('    return size.isValid() && size.width() <= 1024 && size.height() <= 1024 ? reader.read() : QImage();')
  println('  }')
  println('  if (!value.endsWith(QLatin1Char(93)) || value.size() > 2 * (4 * 1024 * 1024 + 65536)) return {};')
  println('  auto bytes = QByteArray::fromHex(value.mid(4, value.size() - 5).toLatin1());')
  println('  if (bytes.size() < 5) return {};')
  println('  const auto size = qFromLittleEndian<quint32>(bytes.constData());')
  println('  if (!size || size > 4 * 1024 * 1024) return {};')
  println('  qToBigEndian(size, bytes.data());')
  println('  auto bitmap = qUncompress(bytes);')
  println('  if (bitmap.size() != size) return {};')
  println('  QBuffer source(&bitmap);')
  println('  source.open(QIODevice::ReadOnly);')
  println('  QImageReader reader(&source, format);')
  println('  const auto dimensions = reader.size();')
  println('  if (dimensions.isEmpty() || dimensions.width() > 1024 || dimensions.height() > 1024) return {};')
  println('  return reader.read();')
  println('}')
  println('static QIcon qt_bitmap_icon(const QString &value) {')
  println('  return QIcon(QPixmap::fromImage(qt_bitmap(value)));')
  println('}')
  println('class HiasmStringTable : public QTableWidget {')
  println('public:')
  println('  using QTableWidget::QTableWidget;')
  println('  QString delimiter = QStringLiteral(";");')
  println('  bool saveWidth = false, staticColumns = false, clearColumns = false;')
  println('  bool extendedColumns = false, checkRows = false;')
  println('  int defaultColumnWidth = 80;')
  println('  void appendColumn(QString title, bool parseWidth) {')
  println('    int width = defaultColumnWidth, alignment = 0;')
  println('    if (parseWidth) {')
  println('      const auto fields = title.split(QChar(61));')
  println('      if (fields.size() > 1) { width = qMax(0, fields[1].toInt()); title = fields.first(); }')
  println('      if (extendedColumns) alignment = qBound(0, fields.value(3).toInt(), 2);')
  println('    }')
  println('    const int column = columnCount();')
  println('    insertColumn(column);')
  println('    setHorizontalHeaderItem(column, new QTableWidgetItem(title));')
  println('    horizontalHeaderItem(column)->setData(Qt::UserRole, alignment);')
  println('    setColumnWidth(column, width);')
  println('  }')
  println('  void setColumnAlignment(int column, int alignment) {')
  println('    auto *header = horizontalHeaderItem(column);')
  println('    if (!header) return;')
  println('    const Qt::Alignment values[] = {Qt::AlignLeft, Qt::AlignRight, Qt::AlignHCenter};')
  println('    alignment = qBound(0, alignment, 2);')
  println('    const QSignalBlocker blocker(this);')
  println('    header->setData(Qt::UserRole, alignment);')
  println('    for (int row = 0; row < rowCount(); ++row)')
  println('      if (auto *cell = item(row, column)) cell->setTextAlignment(values[alignment] | Qt::AlignVCenter);')
  println('  }')
  println('  void appendRow(const QString &text, int row = -1) {')
  println('    putCells(text.split(delimiter), row, false);')
  println('  }')
  println('  void putCells(const QStringList &cells, int row, bool replace) {')
  println('    const QSignalBlocker blocker(this);')
  println('    if (replace) { if (row < 0 || row >= rowCount()) return; }')
  println('    else { row = row < 0 ? rowCount() : qMin(row, rowCount()); insertRow(row); }')
  println('    const Qt::Alignment alignments[] = {Qt::AlignLeft, Qt::AlignRight, Qt::AlignHCenter};')
  println('    const int count = qMin(columnCount(), qMax(checkRows ? 1 : 0, int(cells.size())));')
  println('    for (int column = 0; column < count; ++column) {')
  println('      auto *cell = item(row, column);')
  println('      if (!cell) {')
  println('        cell = new QTableWidgetItem;')
  println('        if (!column && checkRows) cell->setCheckState(Qt::Unchecked);')
  println('        setItem(row, column, cell);')
  println('      }')
  println('      cell->setText(cells.value(column));')
  println('      const auto *header = horizontalHeaderItem(column);')
  println('      cell->setTextAlignment(alignments[header ? header->data(Qt::UserRole).toInt() : 0] | Qt::AlignVCenter);')
  println('    }')
  println('  }')
  println('  QString rowText(int row) const {')
  println('    if (row < 0 || row >= rowCount()) return {};')
  println('    QStringList cells;')
  println('    for (int column = 0; column < columnCount(); ++column)')
  println('      cells.append(item(row, column) ? item(row, column)->text() : QString());')
  println('    return cells.join(delimiter);')
  println('  }')
  println('  QStringList rowsText() const {')
  println('    QStringList lines;')
  println('    for (int row = 0; row < rowCount(); ++row) lines.append(rowText(row));')
  println('    return lines;')
  println('  }')
  println('  void sortRows(int column, bool numeric) {')
  println('    if (column < 0 || column >= columnCount()) return;')
  println('    if (!numeric) { sortItems(column); return; }')
  println('    const QSignalBlocker blocker(this);')
  println('    QList<QList<QTableWidgetItem *>> rows;')
  println('    for (int row = 0; row < rowCount(); ++row) {')
  println('      QList<QTableWidgetItem *> cells;')
  println('      for (int col = 0; col < columnCount(); ++col) cells.append(takeItem(row, col));')
  println('      rows.append(cells);')
  println('    }')
  println('    std::stable_sort(rows.begin(), rows.end(), [column](const auto &left, const auto &right) {')
  println('      const auto number = [column](const auto &row) {')
  println('        const double value = row[column] ? row[column]->text().toDouble() : 0.0;')
  println('        return qIsFinite(value) ? value : 0.0;')
  println('      };')
  println('      return number(left) < number(right);')
  println('    });')
  println('    for (int row = 0; row < rowCount(); ++row)')
  println('      for (int col = 0; col < columnCount(); ++col) if (rows[row][col]) setItem(row, col, rows[row][col]);')
  println('  }')
  println('  void loadFile(const QString &path) {')
  println('    QFile file(path);')
  println('    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return;')
  println('    auto lines = QString::fromUtf8(file.readAll()).split(QChar(10));')
  println('    if (!lines.isEmpty() && lines.last().isEmpty()) lines.removeLast();')
  println('    setRowCount(0);')
  println('    if (!staticColumns) {')
  println('      setColumnCount(0);')
  println('      if (!lines.isEmpty()) for (const auto &title : lines.takeFirst().split(delimiter)) appendColumn(title, true);')
  println('    }')
  println('    for (const auto &line : lines) appendRow(line);')
  println('  }')
  println('  void saveFile(const QString &path) const {')
  println('    QStringList lines = rowsText();')
  println('    if (!staticColumns) {')
  println('      QStringList titles;')
  println('      for (int column = 0; column < columnCount(); ++column) {')
  println('        auto title = horizontalHeaderItem(column) ? horizontalHeaderItem(column)->text() : QString();')
  println('        if (saveWidth) title += QChar(61) + QString::number(columnWidth(column));')
  println('        titles.append(title);')
  println('      }')
  println('      lines.prepend(titles.join(delimiter));')
  println('    }')
  println('    QSaveFile file(path);')
  println('    if (!file.open(QIODevice::WriteOnly)) return;')
  println('    auto bytes = lines.join(QChar(10)).toUtf8();')
  println('    if (!lines.isEmpty()) bytes.append(char(10));')
  println('    if (file.write(bytes) == bytes.size()) file.commit();')
  println('  }')
  println('};')
  println('class HiasmTree : public QTreeWidget {')
  println('public:')
  println('  using QTreeWidget::QTreeWidget;')
  println('  QList<QIcon> icons;')
  println('  bool hints = false;')
  println('  bool checks = false, editable = false, iconPrefix = false;')
  println('  QList<QTreeWidgetItem *> rows() const {')
  println('    QList<QTreeWidgetItem *> result;')
  println('    for (QTreeWidgetItemIterator it(const_cast<HiasmTree *>(this)); *it; ++it) result.append(*it);')
  println('    return result;')
  println('  }')
  println('  QTreeWidgetItem *append(QTreeWidgetItem *parent, QString text, int icon, QTreeWidgetItem *after = nullptr) {')
  println('    QString prefix;')
  println('    if (iconPrefix && text.startsWith(QChar(60))) {')
  println('      const auto end = text.indexOf(QChar(62));')
  println('      bool valid = false;')
  println('      if (end > 1) {')
  println('        const int index = text.mid(1, end - 1).section(QChar(44), 0, 0).toInt(&valid);')
  println('        if (valid) { icon = index; prefix = text.left(end + 1); text.remove(0, end + 1); }')
  println('      }')
  println('    }')
  println('    auto *item = after ? new QTreeWidgetItem(parent, after) : new QTreeWidgetItem(parent);')
  println('    item->setText(0, text);')
  println('    item->setData(0, Qt::UserRole, prefix);')
  println('    if (editable) item->setFlags(item->flags() | Qt::ItemIsEditable);')
  println('    if (checks) item->setCheckState(0, Qt::Unchecked);')
  println('    item->setIcon(0, icons.value(icon));')
  println('    if (hints) item->setToolTip(0, text);')
  println('    return item;')
  println('  }')
  println('  void load(const QString &text) {')
  println('    clear();')
  println('    if (text.isEmpty()) return;')
  println('    auto lines = text.split(QChar(10));')
  println('    if (lines.last().isEmpty()) lines.removeLast();')
  println('    auto *parent = invisibleRootItem();')
  println('    QTreeWidgetItem *last = nullptr;')
  println('    int index = 0;')
  println('    for (auto line : lines) {')
  println('      if (line.endsWith(QChar(13))) line.chop(1);')
  println('      if (line == QStringLiteral("(")) { if (last && last != parent) { parent = last; last = nullptr; } }')
  println('      else if (line == QStringLiteral(")")) {')
  println('        if (parent != invisibleRootItem()) { last = parent; parent = parent->parent(); if (!parent) parent = invisibleRootItem(); }')
  println('      } else last = append(parent, line, index++);')
  println('    }')
  println('  }')
  println('  QString serialize() const {')
  println('    QStringList lines;')
  println('    QList<QTreeWidgetItem *> parents;')
  println('    for (auto *item : rows()) {')
  println('      while (!parents.isEmpty() && parents.last() != item->parent()) { parents.removeLast(); lines.append(QStringLiteral(")")); }')
  println('      lines.append(item->data(0, Qt::UserRole).toString() + item->text(0));')
  println('      if (item->childCount()) { parents.append(item); lines.append(QStringLiteral("(")); }')
  println('    }')
  println('    for (qsizetype i = 0; i < parents.size(); ++i) lines.append(QStringLiteral(")"));')
  println('    return lines.join(QChar(10));')
  println('  }')
  println('  QStringList texts() const {')
  println('    QStringList result;')
  println('    for (auto *item : rows()) result.append(item->text(0));')
  println('    return result;')
  println('  }')
  println('};')
  println('class HiasmToolBar : public QWidget {')
  println('public:')
  println('  using QWidget::QWidget;')
  println('  QList<QWidget *> items;')
  println('  std::function<void(int)> clicked;')
  println('  bool wrap = true, flat = true, textBelow = true;')
  println('  void load(const QString &source) {')
  println('    static const QRegularExpression entry(QStringLiteral("%1([^%1]*)%1=[[]((?:ZIP[0-9A-Fa-f]+)?)]").arg(QChar(39)));')
  println('    for (auto matches = entry.globalMatch(source); matches.hasNext();) {')
  println('      const auto match = matches.next();')
  println('      const auto label = match.captured(1).section(QChar(61), 0, 0);')
  println('      if (label == QStringLiteral("-")) {')
  println('        auto *line = new QFrame(this);')
  println('        line->setFrameShape(QFrame::VLine);')
  println('        line->setFixedSize(6, 22);')
  println('        items.append(line);')
  println('        continue;')
  println('      }')
  println('      auto *button = new QToolButton(this);')
  println('      button->setText(label);')
  println('      button->setToolTip(match.captured(1).section(QChar(61), 1));')
  println('      button->setAutoRaise(flat);')
  println('      const auto image = match.captured(2);')
  println('      if (!image.isEmpty()) button->setIcon(qt_bitmap_icon(QStringLiteral("[") + image + QChar(93)));')
  println('      button->setToolButtonStyle(button->icon().isNull() ? Qt::ToolButtonTextOnly :')
  println('          textBelow ? Qt::ToolButtonTextUnderIcon : Qt::ToolButtonTextBesideIcon);')
  println('      connect(button, &QToolButton::clicked, this, [this, index = int(items.size())] { if (clicked) clicked(index); });')
  println('      items.append(button);')
  println('    }')
  println('    place();')
  println('  }')
  println('  void enable(int index, bool value) { if (auto *item = items.value(index)) item->setEnabled(value); }')
  println('protected:')
  println('  void resizeEvent(QResizeEvent *event) override { QWidget::resizeEvent(event); place(); }')
  println('private:')
  println('  void place() {')
  println('    int x = 0, y = 0, rowHeight = 0;')
  println('    for (auto *item : items) {')
  println('      const auto size = item->sizeHint().expandedTo(item->minimumSize());')
  println('      if (wrap && x && x + size.width() > width()) { x = 0; y += rowHeight; rowHeight = 0; }')
  println('      item->setGeometry(QRect(QPoint(x, y), size));')
  println('      x += size.width();')
  println('      rowHeight = qMax(rowHeight, size.height());')
  println('    }')
  println('  }')
  println('};')
