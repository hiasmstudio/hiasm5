  println('static void hiasm_list_from_text(GtkListBox *list, const char *text, gboolean first, gboolean select)')
  println('{')
  println('  hiasm_list_clear(list);')
  println('  std::string value = text ? text : "";')
  println('  std::size_t start = 0;')
  println('  while(true) {')
  println('    std::size_t end = value.find(static_cast<char>(10), start);')
  println('    hiasm_list_add(list, value.substr(start, end == std::string::npos ? std::string::npos : end - start).c_str(), first, select);')
  println('    if(end == std::string::npos) break;')
  println('    start = end + 1;')
  println('  }')
  println('}')
  println('')
  println('static std::vector<std::string> hiasm_combo_lines(GtkComboBox *combo)')
  println('{')
  println('  std::vector<std::string> result;')
  println('  GtkTreeModel *model = gtk_combo_box_get_model(combo);')
  println('  if(!model) return result;')
  println('  GtkTreeIter iter;')
  println('  if(gtk_tree_model_get_iter_first(model, &iter)) {')
  println('    do {')
  println('      char *text = NULL;')
  println('      gtk_tree_model_get(model, &iter, 0, &text, -1);')
  println('      result.emplace_back(text ? text : "");')
  println('      g_free(text);')
  println('    } while(gtk_tree_model_iter_next(model, &iter));')
  println('  }')
  println('  return result;')
  println('}')
  println('')
  println('static std::string hiasm_combo_text(GtkComboBox *combo)')
  println('{')
  println('  if(!combo || !GTK_IS_COMBO_BOX_TEXT(combo)) return "";')
  println('  char *text = gtk_combo_box_text_get_active_text(GTK_COMBO_BOX_TEXT(combo));')
  println('  std::string result = text ? text : "";')
  println('  g_free(text);')
  println('  return result;')
  println('}')
  println('')
  println('static void hiasm_combo_clear(GtkComboBox *combo)')
  println('{')
  println('  if(combo && GTK_IS_COMBO_BOX_TEXT(combo)) gtk_combo_box_text_remove_all(GTK_COMBO_BOX_TEXT(combo));')
  println('}')
  println('')
  println('static void hiasm_combo_add(GtkComboBox *combo, const char *text, gboolean first)')
  println('{')
  println('  if(!combo || !GTK_IS_COMBO_BOX_TEXT(combo)) return;')
  println('  if(first) gtk_combo_box_text_prepend_text(GTK_COMBO_BOX_TEXT(combo), text ? text : "");')
  println('  else gtk_combo_box_text_append_text(GTK_COMBO_BOX_TEXT(combo), text ? text : "");')
  println('}')
  println('')
  println('static void hiasm_combo_from_text(GtkComboBox *combo, const char *text, gboolean first)')
  println('{')
  println('  hiasm_combo_clear(combo);')
  println('  std::string value = text ? text : "";')
  println('  std::size_t start = 0;')
  println('  while(true) {')
  println('    std::size_t end = value.find(static_cast<char>(10), start);')
  println('    hiasm_combo_add(combo, value.substr(start, end == std::string::npos ? std::string::npos : end - start).c_str(), first);')
  println('    if(end == std::string::npos) break;')
  println('    start = end + 1;')
  println('  }')
  println('}')
  println('')
  println('static void hiasm_list_sort(GtkListBox *list)')
  println('{')
  println('  std::vector<std::string> lines = hiasm_list_lines(list);')
  println('  std::sort(lines.begin(), lines.end());')
  println('  hiasm_list_clear(list);')
  println('  for(const std::string &line : lines) hiasm_list_add(list, line.c_str(), 0, 0);')
  println('}')
  println('')
  println('static void hiasm_combo_sort(GtkComboBox *combo)')
  println('{')
  println('  std::vector<std::string> lines = hiasm_combo_lines(combo);')
  println('  std::sort(lines.begin(), lines.end());')
  println('  hiasm_combo_clear(combo);')
  println('  for(const std::string &line : lines) hiasm_combo_add(combo, line.c_str(), 0);')
  println('}')
