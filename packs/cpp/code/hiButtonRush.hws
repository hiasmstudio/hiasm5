func doStart
  println('{')
  println('auto *button = new HiasmRushButton(qt_text(', cstr(d('Caption')), '), widgetParent);')
  println('button->setObjectName(QStringLiteral("ButtonRush', _id_, '"));')
  println('button->setGeometry(', Left, ', ', Top, ', ', Width, ', ', Height, ');')
  println('button->setEnabled(', get('Enabled') == 'True', ');')
  println('button->setVisible(', get('Visible') == 'True', ');')
  println('button->setToolTip(qt_text(', cstr(d('Hint')), '));')
  println('button->roundWidth = ', RoundWidth, ';')
  println('button->roundHeight = ', RoundHeight, ';')
  println('button->spacing = ', Spacing, ';')
  println('button->opacity = ', AlphaBlendValue, ';')
  println('button->dots = ', DotsCount, ';')
  println('button->verticalDots = ', get('DotsOrient') == 1, ';')
  println('button->glyphAlpha = ', get('Alpha') == 'True', ';')
  println('button->singleGlyph = ', get('OnlyGlyphDef') == 'True', ';')
  println('button->glyphX = ', get('GlyphHAlign'), '; button->glyphY = ', get('GlyphVAlign'), ';')
  println('button->textX = ', get('HAlign'), '; button->textY = ', get('VAlign'), ';')
  println('button->setSkin(0, {qt_text(', cstr(d('ColorFrom')), '), qt_text(', cstr(d('ColorTo')), '), qt_text(', cstr(d('ColorText')), '), qt_text(', cstr(d('BorderColor')), '), qt_text(', cstr(d('ColorShadow')), '), QString::number(', get('GradientStyle'), '), QString::number(', BorderWidth, '), QString::number(', ShadowOffset, ')});')
  println('button->setSkin(1, {qt_text(', cstr(d('ColorFromOver')), '), qt_text(', cstr(d('ColorToOver')), '), qt_text(', cstr(d('ColorTextOver')), '), qt_text(', cstr(d('BorderColorOver')), '), qt_text(', cstr(d('ColorShadowOver')), '), QString::number(', get('GradientStyleOver'), '), QString::number(', BorderWidthOver, '), QString::number(', ShadowOffsetOver, ')});')
  println('button->setSkin(2, {qt_text(', cstr(d('ColorFromDown')), '), qt_text(', cstr(d('ColorToDown')), '), qt_text(', cstr(d('ColorTextDown')), '), qt_text(', cstr(d('BorderColorDown')), '), qt_text(', cstr(d('ColorShadowDown')), '), QString::number(', get('GradientStyleDown'), '), QString::number(', BorderWidthDown, '), QString::number(', ShadowOffsetDown, ')});')
  println('button->setSkin(3, {qt_text(', cstr(d('ColorFromDis')), '), qt_text(', cstr(d('ColorToDis')), '), qt_text(', cstr(d('ColorTextDis')), '), qt_text(', cstr(d('BorderColorDis')), '), qt_text(', cstr(d('ColorShadowDis')), '), QString::number(', get('GradientStyleDis'), '), QString::number(', BorderWidthDis, '), QString::number(', ShadowOffsetDis, ')});')
  println('static const QRegularExpression glyphPattern(QStringLiteral("[[]ZIP[0-9A-Fa-f]+[]]"));')
  println('const auto glyphs = qt_text(', cstr(get('Glyphs')), ');')
  println('for (auto matches = glyphPattern.globalMatch(glyphs); matches.hasNext();) button->glyphs.append(qt_bitmap(matches.next().captured()));')
  if(linked(onClick))
    println('QObject::connect(button, &QPushButton::clicked, &form, [&form] {')
    event(onClick, Data)
    println('});')
  end
  println('}')
end

func doUpdate(_data)
  println('qt_widget<HiasmRushButton>(form, "ButtonRush', _id_, '")->update();')
end

func doRoundWidth(_data)
  if(len(_data) > 0)
    println('{ auto *button = qt_widget<HiasmRushButton>(form, "ButtonRush', _id_, '"); button->roundWidth = qt_text(', _data, ').toInt(); button->update(); }')
  end
end

func doRoundHeight(_data)
  if(len(_data) > 0)
    println('{ auto *button = qt_widget<HiasmRushButton>(form, "ButtonRush', _id_, '"); button->roundHeight = qt_text(', _data, ').toInt(); button->update(); }')
  end
end
