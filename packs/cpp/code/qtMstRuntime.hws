func qtMstRuntime()
  println('static QVariant qt_mst_value(const char *value) { return QString::fromUtf8(value); }')
  println('static QVariant qt_mst_value(const QVariantList &values) { return values.value(0); }')
  println('template<class T> static QVariant qt_mst_value(const T &value) { return QVariant::fromValue(value); }')
  println('template<class T> static void qt_mst_append(QVariantList &out, const T &value) { out.append(qt_mst_value(value)); }')
  println('static void qt_mst_append(QVariantList &out, const QVariantList &values) { out.append(values); }')
  println('static void qt_mst_append(QVariantList &out, const QVariant &value) {')
  println('  if (value.metaType().id() == QMetaType::QVariantList) out.append(value.toList());')
  println('  else out.append(value);')
  println('}')
  println('static QVariantList qt_mst_tuple(const QVariantList &value) { return value; }')
  println('static QVariantList qt_mst_tuple(const QVariant &value) { QVariantList out; qt_mst_append(out, value); return out; }')
  println('template<class T> static QVariantList qt_mst_tuple(const T &value) { return {qt_mst_value(value)}; }')
  println('static QColor qt_mst_color(const QVariant &value, const QColor &fallback = Qt::black) {')
  println('  bool numeric = false; const uint rgb = uint(value.toLongLong(&numeric));')
  println('  if (numeric && !(rgb & 0x80000000u)) return QColor(rgb & 255, (rgb >> 8) & 255, (rgb >> 16) & 255);')
  println('  return qt_led_color(value.toString(), fallback);')
  println('}')
  println('struct HiasmMstDraw : QObject {')
  println('  using QObject::QObject;')
  println('  int iconSize = 16, gutterStyle = 0, styleGrid3D = 0;')
  println('  bool singleString = false, tabGrid = false, tabGridFrame = false, lightTextSel = true;')
  println('  bool bumpText = false, grid3D = false, gradient = false, colorRowSel = false;')
  println('  QColor gradientColor, frameColor, bkFrameColor, shadowColor, lightTxtColor, gutterColor;')
  println('  QList<QPointer<QTableWidget>> tables;')
  println('  void update() { for (auto table : tables) if (table) table->viewport()->update(); }')
  println('};')
  println('class HiasmMstDelegate : public QStyledItemDelegate {')
  println('public:')
  println('  using QStyledItemDelegate::QStyledItemDelegate;')
  println('  QPointer<HiasmMstDraw> draw;')
  println('  mutable QPointer<QWidget> editor;')
  println('  QWidget *createEditor(QWidget *parent, const QStyleOptionViewItem &option, const QModelIndex &index) const override {')
  println('    editor = QStyledItemDelegate::createEditor(parent, option, index); return editor;')
  println('  }')
  println('  void destroyEditor(QWidget *widget, const QModelIndex &index) const override {')
  println('    if (editor == widget) editor.clear();')
  println('    QStyledItemDelegate::destroyEditor(widget, index);')
  println('  }')
  println('  void finish(bool commit) {')
  println('    auto active = editor;')
  println('    if (!active) return;')
  println('    editor.clear();')
  println('    if (commit) emit commitData(active);')
  println('    if (active) emit closeEditor(active, QAbstractItemDelegate::NoHint);')
  println('  }')
  println('  void paint(QPainter *, const QStyleOptionViewItem &, const QModelIndex &) const override;')
  println('};')
  println('class HiasmMstTable : public QTableWidget {')
  println('public:')
  println('  explicit HiasmMstTable(QWidget *parent = nullptr) : QTableWidget(parent), mstDelegate(new HiasmMstDelegate(this)) {')
  println('    setItemDelegate(mstDelegate);')
  println('  }')
  println('  HiasmMstDelegate *mstDelegate;')
  println('  bool virtualMode = false;')
  println('  QColor iconColor;')
  println('  std::function<void()> externalEnter, externalSize;')
  println('  std::function<void(const QString &)> externalEscape;')
  println('  bool externalDoubleClick = false, externalReturn = false;')
  println('  void finishEdit(bool commit) { mstDelegate->finish(commit); }')
  println('  QString separator = QStringLiteral("=");')
  println('  int defaultWidth = 80, defaultAlignment = 0, colorPosition = -1;')
  println('  bool checkRows = false, colorRows = false, clickEnabled = true, infoTip = true;')
  println('  void updateTips(bool enabled) {')
  println('    const QSignalBlocker blocker(this); infoTip = enabled;')
  println('    for (int row = 0; row < rowCount(); ++row) for (int col = 0; col < columnCount(); ++col)')
  println('      ensureCell(row, col)->setToolTip(enabled ? text(row, col) : QString());')
  println('  }')
  println('  QRect cellRect(int row, int col) const {')
  println('    if (!validRow(row) || !validColumn(col)) return {};')
  println('    auto rect = visualRect(model()->index(row, col));')
  println('    rect.moveTopLeft(viewport()->mapTo(parentWidget(), rect.topLeft())); return rect;')
  println('  }')
  println('  int perPage() const { const int height = verticalHeader()->defaultSectionSize(); return height ? viewport()->height() / height : 0; }')
  println('  bool validRow(int row) const { return row >= 0 && row < rowCount(); }')
  println('  bool validColumn(int col) const { return col >= 0 && col < columnCount(); }')
  println('  int tableStyle = 3;')
  println('  void setTableStyle(int style) { tableStyle = style; horizontalHeader()->setVisible(style == 3); }')
  println('  void setMulti(bool multi) { setSelectionMode(multi ? ExtendedSelection : SingleSelection); }')
  println('  bool multi() const { return selectionMode() == ExtendedSelection; }')
  println('  void setWidthChange(bool enabled) { horizontalHeader()->setSectionResizeMode(enabled ? QHeaderView::Interactive : QHeaderView::Fixed); }')
  println('  QString text(int row, int col) const { const auto *cell = item(row, col); return cell ? cell->text() : QString(); }')
  println('  static Qt::Alignment alignment(int value) { return Qt::AlignVCenter | (value == 1 ? Qt::AlignRight : value == 2 ? Qt::AlignHCenter : Qt::AlignLeft); }')
  println('  static QColor delphiColor(const QVariant &value) {')
  println('    bool numeric = false; const uint rgb = value.toUInt(&numeric);')
  println('    return numeric ? QColor(rgb & 255, (rgb >> 8) & 255, (rgb >> 16) & 255) : QColor::fromString(value.toString());')
  println('  }')
  println('  QTableWidgetItem *ensureCell(int row, int col) {')
  println('    auto *cell = item(row, col);')
  println('    if (!cell) { cell = new QTableWidgetItem; setItem(row, col, cell); }')
  println('    return cell;')
  println('  }')
  println('  void setText(int row, int col, const QString &value) {')
  println('    auto *cell = ensureCell(row, col);')
  println('    cell->setText(value);')
  println('    cell->setToolTip(infoTip ? value : QString());')
  println('  }')
  println('  void applyRow(int row) {')
  println('    const auto *meta = verticalHeaderItem(row);')
  println('    for (int col = 0; col < columnCount(); ++col) {')
  println('      auto *cell = ensureCell(row, col);')
  println('      cell->setTextAlignment(alignment(horizontalHeaderItem(col)->data(Qt::UserRole + 1).toInt()));')
  println('      cell->setBackground(meta ? meta->data(Qt::BackgroundRole).value<QBrush>() : QBrush());')
  println('      cell->setForeground(meta ? meta->data(Qt::ForegroundRole).value<QBrush>() : QBrush());')
  println('      const QVariant check = (checkRows && col == 0 && meta) ? meta->data(Qt::CheckStateRole) : QVariant();')
  println('      cell->setData(Qt::CheckStateRole, check);')
  println('      cell->setFlags(cell->flags().setFlag(Qt::ItemIsUserCheckable, check.isValid()));')
  println('    }')
  println('  }')
  println('  void applyRows() { for (int row = 0; row < rowCount(); ++row) applyRow(row); }')
  println('  void column(int col, const QString &definition, bool insert) {')
  println('    const QSignalBlocker blocker(this), headerBlocker(horizontalHeader());')
  println('    if (insert) { if (col < 0) return; col = qMin(col, columnCount()); insertColumn(col); }')
  println('    else if (!validColumn(col)) return;')
  println('    const auto fields = definition.split(separator);')
  println('    auto *header = new QTableWidgetItem(fields.value(0));')
  println('    const int align = fields.value(3).isEmpty() ? defaultAlignment : fields.at(3).toInt();')
  println('    header->setData(Qt::UserRole, fields.value(2).isEmpty() ? -1 : fields.at(2).toInt());')
  println('    header->setData(Qt::UserRole + 1, align);')
  println('    header->setTextAlignment(alignment(align));')
  println('    setHorizontalHeaderItem(col, header);')
  println('    setColumnWidth(col, qMax(0, fields.value(1).isEmpty() ? defaultWidth : fields.at(1).toInt()));')
  println('    applyRows();')
  println('  }')
  println('  QStringList columnFields(int col) const {')
  println('    if (!validColumn(col)) return {};')
  println('    const auto *header = horizontalHeaderItem(col);')
  println('    return {header->text(), QString::number(columnWidth(col)), header->data(Qt::UserRole).toString(), header->data(Qt::UserRole + 1).toString()};')
  println('  }')
  println('  QVariantList columnSnapshot() const {')
  println('    QVariantList columns; columns.reserve(columnCount());')
  println('    for (int col = 0; col < columnCount(); ++col) columns.append(columnFields(col).join(separator));')
  println('    return columns;')
  println('  }')
  println('  void setColumnField(int col, int field, const QString &value) {')
  println('    if (!validColumn(col)) return;')
  println('    const QSignalBlocker blocker(this), headerBlocker(horizontalHeader());')
  println('    auto *header = horizontalHeaderItem(col);')
  println('    if (field == 0) header->setText(value);')
  println('    if (field == 1) setColumnWidth(col, qMax(0, value.toInt()));')
  println('    if (field == 2) header->setData(Qt::UserRole, value.toInt());')
  println('    if (field == 3) { header->setData(Qt::UserRole + 1, value.toInt()); header->setTextAlignment(alignment(value.toInt())); applyRows(); }')
  println('  }')
  println('  void removeMstColumn(int col) {')
  println('    if (!validColumn(col)) return;')
  println('    const QSignalBlocker blocker(this), headerBlocker(horizontalHeader());')
  println('    removeColumn(col); if (col == 0) applyRows();')
  println('  }')
  println('  void clearColumn(int col) {')
  println('    if (!validColumn(col)) return;')
  println('    const QSignalBlocker blocker(this);')
  println('    for (int row = 0; row < rowCount(); ++row) setText(row, col, QString());')
  println('  }')
  println('  bool sizeColumns(int col, int minimum, int maximum, bool stretch) {')
  println('    if (!columnCount() || col >= columnCount() || (stretch ? col < -2 : !rowCount())) return false;')
  println('    const QSignalBlocker headerBlocker(horizontalHeader());')
  println('    const int available = viewport()->width();')
  println('    qint64 total = 0;')
  println('    for (int i = 0; i < columnCount(); ++i) total += columnWidth(i);')
  println('    for (int i = 0; i < columnCount(); ++i) {')
  println('      if (col >= 0 && i != col) continue;')
  println('      if (stretch) {')
  println('        const qint64 width = col >= 0 ? available - total + columnWidth(i) :')
  println('          col == -2 && total ? qint64(available) * columnWidth(i) / total : available / columnCount();')
  println('        setColumnWidth(i, int(qMax(qint64(0), col >= 0 && maximum > 0 ? qMax(qint64(minimum), width) : width)));')
  println('      } else {')
  println('        resizeColumnToContents(i);')
  println('        setColumnWidth(i, qMax(minimum, maximum > 0 ? qMin(maximum, columnWidth(i)) : columnWidth(i)));')
  println('      }')
  println('    }')
  println('    return true;')
  println('  }')
  println('  bool putRow(int row, QVariantList values, bool replace) {')
  println('    if (values.isEmpty()) return false;')
  println('    if (!replace && row == -1) row = rowCount();')
  println('    if (row < 0 || row > rowCount() || (replace && !validRow(row))) return false;')
  println('    const QSignalBlocker blocker(this);')
  println('    if (!replace) {')
  println('      insertRow(row);')
  println('      auto *meta = new QTableWidgetItem;')
  println('      if (checkRows) meta->setCheckState(Qt::Unchecked);')
  println('      setVerticalHeaderItem(row, meta);')
  println('    }')
  println('    QVariant color;')
  println('    if (colorRows && colorPosition >= 0 && colorPosition <= columnCount() && colorPosition < values.size())')
  println('      color = values.takeAt(colorPosition);')
  println('    for (int col = 0; col < columnCount(); ++col) setText(row, col, values.value(col).toString());')
  println('    const auto tail = values.mid(columnCount());')
  println('    auto *meta = verticalHeaderItem(row);')
  println('    if (colorRows && colorPosition < 0 && !tail.isEmpty()) color = tail.first();')
  println('    if (color.isValid()) {')
  println('      const auto background = delphiColor(color);')
  println('      meta->setData(Qt::BackgroundRole, background.isValid() ? QVariant::fromValue(QBrush(background)) : QVariant());')
  println('    }')
  println('    if (!tail.isEmpty() || color.isValid()) { meta->setData(Qt::UserRole, tail); meta->setData(Qt::UserRole + 1, color); }')
  println('    applyRow(row);')
  println('    return true;')
  println('  }')
  println('  QVariantList rowTuple(int row) const {')
  println('    if (!validRow(row) || !columnCount()) return {};')
  println('    QVariantList values;')
  println('    for (int col = 0; col < columnCount(); ++col) values.append(text(row, col));')
  println('    const auto *meta = verticalHeaderItem(row);')
  println('    if (meta) {')
  println('      if (colorRows && colorPosition >= 0 && colorPosition <= values.size()) {')
  println('        const auto color = meta->data(Qt::UserRole + 1); values.insert(colorPosition, color.isValid() ? color : QVariant(0));')
  println('      }')
  println('      values.append(meta->data(Qt::UserRole).toList());')
  println('    }')
  println('    return values;')
  println('  }')
  println('  QVariantList rowSnapshot() const {')
  println('    QVariantList rows; rows.reserve(rowCount());')
  println('    for (int row = 0; row < rowCount(); ++row) rows.append(QVariant(rowTuple(row)));')
  println('    return rows;')
  println('  }')
  println('  void clearTable(bool columns) {')
  println('    const QSignalBlocker blocker(this), headerBlocker(horizontalHeader());')
  println('    setRowCount(0); if (columns) setColumnCount(0);')
  println('  }')
  println('  QByteArray saveText(const QString &delimiter, bool header, bool properties, bool checks) const {')
  println('    QString result;')
  println('    const auto write = [&](const QStringList &fields) { result += fields.join(delimiter) + QChar(13) + QChar(10); };')
  println('    if (header && columnCount()) {')
  println('      QStringList fields;')
  println('      for (int col = 0; col < columnCount(); ++col) {')
  println('        const auto column = columnFields(col); fields.append(properties ? column.join(separator) : column.first());')
  println('      }')
  println('      write(fields);')
  println('    }')
  println('    for (int row = 0; row < rowCount(); ++row) {')
  println('      QStringList fields; if (checks) fields.append(QString::number(checked(row)));')
  println('      for (const auto &value : rowTuple(row)) fields.append(value.toString());')
  println('      write(fields);')
  println('    }')
  println('    return result.toUtf8();')
  println('  }')
  println('  void loadText(QByteArray bytes, const QString &delimiter, bool header, bool checks) {')
  println('    if (delimiter.isEmpty() || bytes.isEmpty()) return;')
  println('    if (bytes.startsWith(QByteArray::fromHex("efbbbf"))) bytes.remove(0, 3);')
  println('    auto lines = QString::fromUtf8(bytes).split(QChar(10));')
  println('    if (lines.last().isEmpty()) lines.removeLast();')
  println('    for (auto &line : lines) if (line.endsWith(QChar(13))) line.chop(1);')
  println('    if (header && !lines.isEmpty()) {')
  println('      const auto fields = lines.takeFirst().split(delimiter);')
  println('      for (const auto &field : fields) column(columnCount(), field, true);')
  println('    }')
  println('    for (const auto &line : lines) {')
  println('      auto fields = line.split(delimiter);')
  println('      const int check = checks ? fields.takeFirst().toInt() : -1;')
  println('      QVariantList tuple; for (const auto &field : fields) tuple.append(field);')
  println('      if (tuple.isEmpty()) tuple.append(QString());')
  println('      if (putRow(-1, tuple, false)) setChecked(rowCount() - 1, check);')
  println('    }')
  println('  }')
  println('  int checked(int row) const {')
  println('    const auto *meta = verticalHeaderItem(row);')
  println('    const auto value = meta ? meta->data(Qt::CheckStateRole) : QVariant();')
  println('    return value.isValid() ? int(value.toInt() == Qt::Checked) : -1;')
  println('  }')
  println('  bool setChecked(int row, int mode) {')
  println('    if (!checkRows || row < -1 || row >= rowCount() || mode < -1 || mode > 1) return false;')
  println('    const QSignalBlocker blocker(this);')
  println('    for (int i = row < 0 ? 0 : row; i < (row < 0 ? rowCount() : row + 1); ++i) {')
  println('      verticalHeaderItem(i)->setData(Qt::CheckStateRole, mode < 0 ? QVariant() : QVariant(mode ? Qt::Checked : Qt::Unchecked));')
  println('      applyRow(i);')
  println('    }')
  println('    return true;')
  println('  }')
  println('  bool selectedRow(int row) const {')
  println('    return validRow(row) && selectionModel()->rowIntersectsSelection(row, QModelIndex());')
  println('  }')
  println('  QVariantList rowFlags(bool checks, bool indexes) const {')
  println('    QVariantList result;')
  println('    for (int row = 0; row < rowCount(); ++row) {')
  println('      const int flag = checks ? checked(row) : int(selectedRow(row));')
  println('      if (!indexes) result.append(flag); else if (flag == 1) result.append(row);')
  println('    }')
  println('    return result;')
  println('  }')
  println('  void showRow(int row, int position = 0) {')
  println('    if (!validRow(row) || !columnCount()) return;')
  println('    const ScrollHint hints[] = {EnsureVisible, PositionAtTop, PositionAtCenter, PositionAtBottom};')
  println('    scrollTo(model()->index(row, 0), hints[qBound(0, position, 3)]);')
  println('  }')
  println('  bool selectMstRow(int row, bool reveal, int position) {')
  println('    if (!validRow(row) || !columnCount() || selectedRow(row)) return false;')
  println('    const int h = horizontalScrollBar()->value(), v = verticalScrollBar()->value();')
  println('    setCurrentCell(row, 0, (multi() ? QItemSelectionModel::Select : QItemSelectionModel::ClearAndSelect) | QItemSelectionModel::Rows);')
  println('    if (reveal) showRow(row, position); else { horizontalScrollBar()->setValue(h); verticalScrollBar()->setValue(v); }')
  println('    return true;')
  println('  }')
  println('  bool selectRows(int mode) {')
  println('    if (mode == 0) {')
  println('      if (!selectionModel()->hasSelection()) return false;')
  println('      selectionModel()->clear(); return true;')
  println('    }')
  println('    if (!multi() || !rowCount() || !columnCount()) return false;')
  println('    if (mode == 1 && rowFlags(false, true).size() == rowCount()) return false;')
  println('    if (mode == 1) selectAll();')
  println('    else for (int row = 0; row < rowCount(); ++row)')
  println('      selectionModel()->select(model()->index(row, 0), (selectedRow(row) ? QItemSelectionModel::Deselect : QItemSelectionModel::Select) | QItemSelectionModel::Rows);')
  println('    return true;')
  println('  }')
  println('  QVariantList matrix(int x, int y, int filter) const {')
  println('    QVariantList result;')
  println('    if ((x < 0 && y < 0) || x >= columnCount() || y >= rowCount()) return result;')
  println('    for (int row = qMax(0, y); row < (y < 0 ? rowCount() : y + 1); ++row) {')
  println('      if ((filter == 1 && checked(row) != 1) || (filter == 2 && !selectedRow(row))) continue;')
  println('      for (int col = qMax(0, x); col < (x < 0 ? columnCount() : x + 1); ++col) result.append(text(row, col));')
  println('    }')
  println('    return result;')
  println('  }')
  println('  // Move whole rows, including their headers, so selection and metadata follow the cells.')
  println('  void reorder(const QList<int> &order) {')
  println('    const QSignalBlocker blocker(this);')
  println('    const int oldCurrent = currentRow(), oldColumn = currentColumn();')
  println('    QList<QList<QTableWidgetItem *>> cells; QList<QTableWidgetItem *> headers; QList<bool> selected;')
  println('    for (const int row : order) {')
  println('      selected.append(selectedRow(row)); headers.append(takeVerticalHeaderItem(row));')
  println('      QList<QTableWidgetItem *> line;')
  println('      for (int col = 0; col < columnCount(); ++col) line.append(takeItem(row, col));')
  println('      cells.append(std::move(line));')
  println('    }')
  println('    clearSelection();')
  println('    for (int row = 0; row < order.size(); ++row) {')
  println('      setVerticalHeaderItem(row, headers[row]);')
  println('      for (int col = 0; col < columnCount(); ++col) if (cells[row][col]) setItem(row, col, cells[row][col]);')
  println('      if (selected[row] && columnCount()) selectionModel()->select(model()->index(row, 0), QItemSelectionModel::Select | QItemSelectionModel::Rows);')
  println('      if (order[row] == oldCurrent) setCurrentCell(row, oldColumn, QItemSelectionModel::NoUpdate);')
  println('    }')
  println('  }')
  println('  bool moveRow(int row, int delta) {')
  println('    if (!validRow(row) || !validRow(row + delta)) return false;')
  println('    QList<int> order; for (int i = 0; i < rowCount(); ++i) order.append(i);')
  println('    order.swapItemsAt(row, row + delta); reorder(order); return true;')
  println('  }')
  println('  bool sortMst(int col, bool descending, bool numeric) {')
  println('    if (!validColumn(col)) return false;')
  println('    QList<int> order; for (int i = 0; i < rowCount(); ++i) order.append(i);')
  println('    std::stable_sort(order.begin(), order.end(), [&](int a, int b) {')
  println('      if (descending) std::swap(a, b);')
  println('      if (!numeric) return text(a, col).compare(text(b, col), Qt::CaseInsensitive) < 0;')
  println('      const double left = text(a, col).toDouble(), right = text(b, col).toDouble();')
  println('      return (qIsNaN(left) ? 0.0 : left) < (qIsNaN(right) ? 0.0 : right);')
  println('    });')
  println('    reorder(order); return true;')
  println('  }')
  println('  void setGeneralColor(int field, const QVariant &value) {')
  println('    const QPalette::ColorRole roles[] = {QPalette::Window, QPalette::Text, QPalette::Base, QPalette::Button};')
  println('    auto colors = palette(); const auto color = qt_mst_color(value, colors.color(roles[field]));')
  println('    if (field == 3) { iconColor = color; horizontalHeader()->viewport()->update(); }')
  println('    else { colors.setColor(roles[field], color); setPalette(colors); }')
  println('  }')
  println('  QVariantList generalColors() const {')
  println('    const auto bgr = [](const QColor &c) { return c.red() | (c.green() << 8) | (c.blue() << 16); };')
  println('    return {bgr(palette().color(QPalette::Window)), bgr(palette().color(QPalette::Text)),')
  println('            bgr(palette().color(QPalette::Base)), bgr(iconColor.isValid() ? iconColor : palette().color(QPalette::Button))};')
  println('  }')
  println('  void connectExternalEditor() {')
  println('    connect(horizontalHeader(), &QHeaderView::sectionResized, this, [this] {')
  println('      if (externalSize && editTriggers() == NoEditTriggers && currentIndex().isValid()) externalSize();')
  println('    });')
  println('    connect(horizontalScrollBar(), &QScrollBar::valueChanged, this, [this] { escapeExternal(); });')
  println('    connect(verticalScrollBar(), &QScrollBar::valueChanged, this, [this] { escapeExternal(); });')
  println('  }')
  println('protected:')
  println('  void escapeExternal() {')
  println('    if (externalEscape && editTriggers() == NoEditTriggers) externalEscape(text(currentRow(), currentColumn()));')
  println('  }')
  println('  void enterExternal() {')
  println('    if (editTriggers() != NoEditTriggers || !currentIndex().isValid()) return;')
  println('    if (externalSize) externalSize();')
  println('    if (externalEnter) externalEnter();')
  println('  }')
  println('  void keyPressEvent(QKeyEvent *event) override {')
  println('    const int key = event->key();')
  println('    if (editTriggers() == NoEditTriggers && (externalEnter || externalSize) &&')
  println('        (key == Qt::Key_F2 || (externalReturn && (key == Qt::Key_Return || key == Qt::Key_Enter)))) {')
  println('      enterExternal(); event->accept(); return;')
  println('    }')
  println('    QTableWidget::keyPressEvent(event);')
  println('    if (key == Qt::Key_Escape || key == Qt::Key_Up || key == Qt::Key_Down || key == Qt::Key_Left || key == Qt::Key_Right) escapeExternal();')
  println('  }')
  println('  void mousePressEvent(QMouseEvent *event) override { QTableWidget::mousePressEvent(event); escapeExternal(); }')
  println('  void mouseDoubleClickEvent(QMouseEvent *event) override {')
  println('    const auto index = indexAt(event->position().toPoint());')
  println('    QTableWidget::mouseDoubleClickEvent(event);')
  println('    if (externalDoubleClick && index.isValid()) enterExternal();')
  println('  }')
  println('};')
  println('void HiasmMstDelegate::paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const {')
  println('  const auto *table = static_cast<const HiasmMstTable *>(parent());')
  println('  if (!draw) { QStyledItemDelegate::paint(painter, option, index); return; }')
  println('  QStyleOptionViewItem opt(option); initStyleOption(&opt, index);')
  println('  const bool selected = opt.state.testFlag(QStyle::State_Selected);')
  println('  auto *style = opt.widget ? opt.widget->style() : QApplication::style();')
  println('  const auto group = !opt.state.testFlag(QStyle::State_Enabled) ? QPalette::Disabled :')
  println('    opt.state.testFlag(QStyle::State_Active) ? QPalette::Active : QPalette::Inactive;')
  println('  QColor background = opt.backgroundBrush.style() == Qt::NoBrush ? opt.palette.color(group, QPalette::Base) : opt.backgroundBrush.color();')
  println('  if (selected && !draw->colorRowSel) background = draw->gradientColor;')
  println('  painter->save(); painter->setClipRect(opt.rect, Qt::IntersectClip);')
  println('  const auto fill = [&](const QRect &rect, const QColor &color, bool gradient, bool horizontal) {')
  println('    if (!gradient) { painter->fillRect(rect, color); return; }')
  println('    const auto tint = [&](double fraction) { return QColor::fromRgbF(color.redF() + (1 - color.redF()) * fraction,')
  println('        color.greenF() + (1 - color.greenF()) * fraction, color.blueF() + (1 - color.blueF()) * fraction); };')
  println('    QLinearGradient brush(rect.topLeft(), horizontal ? rect.topRight() : rect.bottomLeft());')
  println('    brush.setColorAt(0, tint(0.7)); brush.setColorAt(1, tint(0.2)); painter->fillRect(rect, brush);')
  println('  };')
  println('  fill(opt.rect, background, selected && draw->gradient, false);')
  println('  int size = draw->iconSize > 0 ? draw->iconSize : style->pixelMetric(QStyle::PM_LargeIconSize, &opt, opt.widget);')
  println('  opt.decorationSize = QSize(size, size);')
  println('  const auto textRect = style->subElementRect(QStyle::SE_ItemViewItemText, &opt, opt.widget);')
  println('  if (index.column() == 0 && draw->gutterStyle && textRect.left() > opt.rect.left()) {')
  println('    const QRect gutter(opt.rect.left(), opt.rect.top(), textRect.left() - opt.rect.left(), opt.rect.height());')
  println('    fill(gutter, draw->gutterColor, draw->gutterStyle == 3, true);')
  println('    if (draw->gutterStyle == 2) qDrawShadeRect(painter, gutter.adjusted(0, 0, -1, -1), opt.palette);')
  println('  }')
  println('  const bool frame = selected && draw->tabGrid && draw->tabGridFrame && index == table->currentIndex();')
  println('  if (frame) {')
  println('    const QRect rect = textRect.adjusted(1, 1, -2, -2);')
  println('    painter->setPen(draw->frameColor); painter->setBrush(draw->bkFrameColor); painter->drawRect(rect);')
  println('  }')
  println('  auto foreground = opt.palette.color(group, QPalette::Text);')
  println('  if (selected && draw->lightTextSel && (!draw->tabGrid || (!frame && index == table->currentIndex()))) foreground = draw->lightTxtColor;')
  println('  opt.backgroundBrush = QBrush(); opt.features.setFlag(QStyleOptionViewItem::Alternate, false);')
  println('  opt.state &= ~(QStyle::State_Selected | QStyle::State_HasFocus | QStyle::State_MouseOver);')
  println('  opt.features.setFlag(QStyleOptionViewItem::WrapText, !draw->singleString);')
  println('  if (draw->bumpText && !selected) {')
  println('    auto shadow = opt; shadow.rect.translate(1, 1); shadow.icon = QIcon();')
  println('    shadow.features.setFlag(QStyleOptionViewItem::HasCheckIndicator, false);')
  println('    painter->setClipRect(textRect, Qt::IntersectClip);')
  println('    shadow.palette.setColor(group, QPalette::Text, draw->shadowColor);')
  println('    style->drawControl(QStyle::CE_ItemViewItem, &shadow, painter, opt.widget);')
  println('    painter->setClipRect(opt.rect);')
  println('  }')
  println('  opt.palette.setColor(group, QPalette::Text, foreground);')
  println('  style->drawControl(QStyle::CE_ItemViewItem, &opt, painter, opt.widget);')
  println('  if (draw->grid3D && table->showGrid()) qDrawShadeRect(painter, opt.rect.adjusted(0, 0, -1, -1), opt.palette, draw->styleGrid3D == 1);')
  println('  painter->restore();')
  println('}')
  println('static void qt_mst_attach_draw(HiasmMstTable *table, HiasmMstDraw *draw) {')
  println('  if (!table || !draw || table->mstDelegate->draw == draw) return;')
  println('  table->mstDelegate->draw = draw; draw->tables.append(table); table->viewport()->update();')
  println('}')
  println('class HiasmMstVirtual : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QPointer<HiasmMstTable> table;')
  println('  int initialPage = 0, index = 0;')
  println('  bool columnByName = false, refreshing = false, rendered = false;')
  println('  std::function<QVariantList(qint64, int, const QVariant &)> provider;')
  println('  int perPage() const { return table ? qMax(1, table->perPage()) : 1; }')
  println('  int pageNumber() const { return index / perPage(); }')
  println('  void moveTo(qint64 position) { index = int(qBound(qint64(0), position, qint64(INT_MAX))); }')
  println('  bool attach(HiasmMstTable *target) {')
  println('    if (!table && target) { table = target; moveTo(qint64(initialPage) * perPage()); }')
  println('    return bool(table);')
  println('  }')
  println('  void refresh() {')
  println('    if (!table || !table->virtualMode || refreshing) return;')
  println('    refreshing = true;')
  println('    const QSignalBlocker blocker(table);')
  println('    table->setRowCount(0);')
  println('    const int count = perPage(); const qint64 first = index;')
  println('    for (int row = 0; row < count; ++row) {')
  println('      QVariantList cells;')
  println('      for (int column = 0; column < table->columnCount(); ++column) {')
  println('        const QVariant subitem = columnByName ? QVariant(table->columnFields(column).value(0)) : QVariant(column);')
  println('        cells.append(provider ? provider(first + row, row, subitem).value(0) : QVariant(QString()));')
  println('      }')
  println('      table->putRow(-1, cells, false);')
  println('    }')
  println('    rendered = true; refreshing = false;')
  println('  }')
  println('};')
  println('static void qt_mst_palette(QWidget *control, QPalette::ColorRole role, const QString &value) {')
  println('  auto palette = control->palette();')
  println('  auto color = HiasmMstTable::delphiColor(value);')
  println('  if (!color.isValid()) color = qt_led_color(value, palette.color(role));')
  println('  palette.setColor(role, color); control->setPalette(palette);')
  println('}')
  println('struct HiasmMstFind : QObject {')
  println('  using QObject::QObject;')
  println('  QString needle, replacement, result; int row = -1, col = -1; QVariantList positions;')
  println('  void find(HiasmMstTable *table, int startRow, int startCol, bool replace, bool select) {')
  println('    row = col = -1; result.clear(); positions.clear();')
  println('    if (needle.isEmpty() || !table->validRow(startRow) || !table->validColumn(startCol)) return;')
  println('    for (int r = startRow; r < table->rowCount(); ++r) for (int c = r == startRow ? startCol : 0; c < table->columnCount(); ++c) {')
  println('      auto value = table->text(r, c); qsizetype offset = 0;')
  println('      while ((offset = value.indexOf(needle, offset, Qt::CaseInsensitive)) >= 0) {')
  println('        if (!replace || !replacement.isEmpty()) positions.append(qlonglong(offset + 1));')
  println('        if (replace) value.replace(offset, needle.size(), replacement);')
  println('        offset += replace ? replacement.size() : needle.size();')
  println('        row = r; col = c;')
  println('      }')
  println('      if (row < 0) continue;')
  println('      result = value;')
  println('      if (replace) { const QSignalBlocker blocker(table); table->setText(r, c, value); }')
  println('      if (select) table->selectMstRow(r, false, 0);')
  println('      return;')
  println('    }')
  println('  }')
  println('  void next(HiasmMstTable *table, bool replace, bool select) {')
  println('    const bool wrap = col + 1 >= table->columnCount();')
  println('    find(table, row < 0 ? -1 : row + int(wrap), wrap ? 0 : col + 1, replace, select);')
  println('  }')
  println('};')
end
