func doMessage(_data)
  fvar(text, caption, msg, cap)
  text = '""'
  msg = d('Message')
  if(isset(msg))
    text = cstr(msg)
  end
  caption = '""'
  cap = d('Caption')
  if(isset(cap))
    caption = cstr(cap)
  end
  if(is_qt_project())
    println('{')
    println('using Box = QMessageBox;')
    println('Box box(&form);')
    println('box.setTextFormat(Qt::PlainText);')
    println('box.setWindowTitle(qt_text(', caption, '));')
    println('box.setText(qt_text(', text, '));')
    println('const QList<QList<Box::StandardButton>> groups{{Box::Ok},{Box::Ok,Box::Cancel},{Box::Yes,Box::No},{Box::Yes,Box::No,Box::Cancel},{Box::Retry,Box::Ignore},{Box::Abort,Box::Retry,Box::Ignore}};')
    println('const auto buttons = groups.at(qBound(0, ', get('Type'), ', 5));')
    println('for(auto button : buttons) box.addButton(button);')
    println('box.setDefaultButton(buttons.at(qBound(0, ', get('DefButton'), ', int(buttons.size()) - 1)));')
    println('const Box::Icon icons[]{Box::NoIcon,Box::Critical,Box::Question,Box::Warning,Box::Information};')
    println('box.setIcon(icons[qBound(0, ', get('Icon'), ', 4)]);')
    println('box.exec();')
    println('const QList<Box::StandardButton> codes{Box::NoButton,Box::Ok,Box::Cancel,Box::Abort,Box::Retry,Box::Ignore,Box::Yes,Box::No};')
    println('int answer = int(codes.indexOf(box.standardButton(box.clickedButton())));')
    event(onMessage, 'answer')
    println('switch(answer) {')
    println('case 1: {')
    event(onOK)
    println('} break; case 2: {')
    event(onCANCEL)
    println('} break; case 3: {')
    event(onABORT)
    println('} break; case 4: {')
    event(onRETRY)
    println('} break; case 5: {')
    event(onIGNORE)
    println('} break; case 6: {')
    event(onYES)
    println('} break; case 7: {')
    event(onNO)
    println('} break; } }')
  else
    println('hiasm_message(', text, ', ', caption, ');')
    event(onMessage)
  end
end
