func doStart
  block.reg("result")
  block.select("result")
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#endif')
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  if(TargetPlatform > 1)
    println('#error "CplApp is a Windows-only project type; select the Windows target"')
  end
  println('#include <windows.h>')
  println('#include <cpl.h>')
  println('#include <cstring>')
  println('')
  println('static const char *hiasm_applet_name = ', AppletName, ';')
  println('static const char *hiasm_applet_info = ', AppletInfo, ';')
  println('')
  println('static void hiasm_fill(NEWCPLINFOA *info)')
  println('{')
  println('  if(!info) return;')
  println('  std::memset(info, 0, sizeof(*info));')
  println('  info->dwSize = sizeof(*info);')
  println('  std::strncpy(info->szName, hiasm_applet_name, 31);')
  println('  std::strncpy(info->szInfo, hiasm_applet_info, 63);')
  println('}')
  println('')
  println('extern "C" __declspec(dllexport) LONG WINAPI CPlApplet(HWND window, UINT message, LPARAM parameter1, LPARAM parameter2)')
  println('{')
  println('  (void)window;')
  println('  switch(message)')
  println('  {')
  println('    case CPL_INIT: return 1;')
  println('    case CPL_GETCOUNT: return 1;')
  println('    case CPL_INQUIRE: return 0;')
  // CPL_NEWINQUIRE passes the applet index in lParam1 and the NEWCPLINFO pointer in lParam2.
  println('    case CPL_NEWINQUIRE: hiasm_fill(reinterpret_cast<LPNEWCPLINFOA>(parameter2)); return 0;')
  println('    case CPL_DBLCLK:')
  block.inclvl()
  event(onStart)
  println('      return 0;')
  block.declvl()
  println('    case CPL_STOP: return 0;')
  println('  }')
  println('  return 0;')
  println('}')
  println('')
  println('BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved)')
  println('{')
  println('  (void)reserved;')
  println('  if(reason == DLL_PROCESS_ATTACH) DisableThreadLibraryCalls(instance);')
  println('  return TRUE;')
  println('}')
end
