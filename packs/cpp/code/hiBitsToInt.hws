func Arg(name)
  if(linked(name))
    return(d(name))
  else
    return(get(name))
  end
end

func Expr()
  fvar(expr, i)
  expr = '0'
  i = 1
  while(i <= get('Count'))
    expr = expr && ' | ((' && Arg('Bit' && i) && ' & 1) << ' && (i - 1) && ')'
    i = i + 1
  end
  return(expr)
end

func doNumber(_data)
  event(onNumber, Expr())
end

func Number()
  return(Expr())
end
