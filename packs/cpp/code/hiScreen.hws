func Guard()
  println('#if !defined(_WIN32)')
  println('#error "Screen is a Windows-only element"')
  println('#endif')
end

func Value(name)
  if(linked(name))
    return(d(name))
  else
    return(get(name))
  end
end

func doResolution(_data)
  Guard()
  println('{')
  block.inclvl()
  println('DEVMODEA hiasm_dm', _id_, ' = {};')
  println('hiasm_dm', _id_, '.dmSize = sizeof(DEVMODEA);')
  println('hiasm_dm', _id_, '.dmPelsWidth = static_cast<DWORD>(', Value('X'), ');')
  println('hiasm_dm', _id_, '.dmPelsHeight = static_cast<DWORD>(', Value('Y'), ');')
  println('hiasm_dm', _id_, '.dmFields = DM_PELSWIDTH | DM_PELSHEIGHT;')
  println('ChangeDisplaySettingsA(&hiasm_dm', _id_, ', 0);')
  block.declvl()
  println('}')
end

func doFrequency(_data)
  Guard()
  println('{')
  block.inclvl()
  println('DEVMODEA hiasm_dm', _id_, ' = {};')
  println('hiasm_dm', _id_, '.dmSize = sizeof(DEVMODEA);')
  println('hiasm_dm', _id_, '.dmDisplayFrequency = static_cast<DWORD>(', Value('Frequency'), ');')
  println('hiasm_dm', _id_, '.dmFields = DM_DISPLAYFREQUENCY;')
