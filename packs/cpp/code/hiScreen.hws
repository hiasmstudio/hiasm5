func doSetScreen(_data)
  Guard()
  println('{')
  block.inclvl()
  println('DEVMODEA hiasm_dm', _id_, ' = {};')
  println('hiasm_dm', _id_, '.dmSize = sizeof(DEVMODEA);')
  println('hiasm_dm', _id_, '.dmPelsWidth = static_cast<DWORD>(', Value('X'), ');')
  println('hiasm_dm', _id_, '.dmPelsHeight = static_cast<DWORD>(', Value('Y'), ');')
  println('hiasm_dm', _id_, '.dmDisplayFrequency = static_cast<DWORD>(', Value('Frequency'), ');')
  println('hiasm_dm', _id_, '.dmBitsPerPel = static_cast<DWORD>(', Value('BitsPerPixel'), ');')
  println('hiasm_dm', _id_, '.dmFields = DM_PELSWIDTH | DM_PELSHEIGHT | DM_DISPLAYFREQUENCY | DM_BITSPERPEL;')
  println('ChangeDisplaySettingsA(&hiasm_dm', _id_, ', 0);')
  block.declvl()
  println('}')
end

func doEnum(_data)
  Guard()
  println('{')
  block.inclvl()
  println('DEVMODEA hiasm_dm', _id_, ' = {};')
  println('hiasm_dm', _id_, '.dmSize = sizeof(DEVMODEA);')
  println('auto hiasm_format', _id_, ' = [](std::string mask, int w, int h, int bpp, int freq) {')
  block.inclvl()
  println('const std::pair<const char*, std::string> values[] = {{"%h", std::to_string(h)}, {"%v", std::to_string(w)}, {"%bpp", std::to_string(bpp)}, {"%f", std::to_string(freq)}};')
  println('for(const auto &item : values) { std::size_t p = 0; while((p = mask.find(item.first, p)) != std::string::npos) { mask.replace(p, std::string(item.first).size(), item.second); p += item.second.size(); } }')
  println('return mask;')
  block.declvl()
  println('};')
  println('for(DWORD hiasm_mode', _id_, ' = 0; EnumDisplaySettingsA(NULL, hiasm_mode', _id_, ', &hiasm_dm', _id_, '); ++hiasm_mode', _id_, ') {')
  block.inclvl()
  event(onEnum, 'hiasm_format' && _id_ && '(std::string(' && cstr(get('EnumMask')) && '), static_cast<int>(hiasm_dm' && _id_ && '.dmPelsWidth), static_cast<int>(hiasm_dm' && _id_ && '.dmPelsHeight), static_cast<int>(hiasm_dm' && _id_ && '.dmBitsPerPel), static_cast<int>(hiasm_dm' && _id_ && '.dmDisplayFrequency))')
  block.declvl()
  println('}')
  block.declvl()
  println('}')
end

func Width()
  return('hiasm_screen_width()')
end
