func doStart
  println('{')
  fvar(active)
  active = 0
  switch(d('Checked'))
    case 0: active = 1
  end
  println('GtkWidget *check = gtk_check_button_new_with_label(', Caption, ');')
  println('hiasm_set_color(check, ', cstr(d('Color')), ');')
  println('hiasm_set_font(check, ', cstr(d('Font')), ');')
  switch(get('Transparent'))
    case "True": println('hiasm_set_background(check, "transparent");')
  end
  println('gtk_check_button_set_active(GTK_CHECK_BUTTON(check), ', active, ' ? TRUE : FALSE);')
  println('hiasm_place("CheckBox', _id_, '", check, ', Left, ', ', Top, ');')
  if(linked(onCheck))
    println('g_signal_connect(check, "toggled", G_CALLBACK(+[](GtkCheckButton *button, gpointer) {')
  println('if(!hiasm_form_ready) return;')
    block.inclvl()
    event(onCheck, 'gtk_check_button_get_active(button) ? 1 : 0')
    block.declvl()
    println('}), NULL);')
  end
  if(linked(onClick))
    println('g_signal_connect(check, "clicked", G_CALLBACK(+[](GtkButton *, gpointer) {')
  println('if(!hiasm_form_ready) return;')
    block.inclvl()
    event(onClick)
    block.declvl()
    println('}), NULL);')
  end
  println('}')
end

func Checked()
  return('gtk_check_button_get_active(GTK_CHECK_BUTTON(hiasm_widget("CheckBox' && _id_ && '").get())) ? 1 : 0')
end

func doCheck(_data)
  println('gtk_check_button_set_active(GTK_CHECK_BUTTON(hiasm_widget("CheckBox', _id_, '").get()), (', _data, ') ? TRUE : FALSE);')
end
