func PolyManager()
  return('form.findChild<QObject *>(QStringLiteral("' && this.name && _id_ && '"), Qt::FindDirectChildrenOnly)')
end

func PolyArgument(payload)
  if(len(payload) > 0)
    return('qt_text(' && payload && ')')
  end
  return('QString()')
end

func PolyStart(element, isWindow)
  fvar(i, sdk, frame, name, port)
  // The local class owns instances. QVariant callbacks keep generated links independent of its C++ scope.
  println('{')
  println('class PolyManager : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  using Factory = std::function<QWidget *(QWidget *, QObject *)>;')
  println('  struct Class { QString name; Factory create; };')
  println('  struct Instance { int handle = 0; QString name; QPointer<QWidget> root; };')
  println('  QList<Class> classes;')
  println('  QList<Instance> instances;')
  println('  QList<int> activeSources, deleting;')
  println('  int nextHandle = 0, selected = 0, source = 0;')
  println('  QWidget *widgetParent = nullptr;')
  println('  int indexOf(int handle) const {')
  println('    for (int i = 0; i < instances.size(); ++i) if (instances[i].handle == handle) return i;')
  println('    return -1;')
  println('  }')
  println('  int handleOf(QWidget *root) const {')
  println('    for (const auto &instance : instances) if (instance.root == root) return instance.handle;')
  println('    return 0;')
  println('  }')
  println('  void work(int handle, const QString &name, const QString &payload) {')
  println('    const auto instance = instances.value(indexOf(handle));')
  println('    if (!instance.root) return;')
  println('    const auto callback = instance.root->property((QByteArray("polyIn:") + name.toUtf8()).constData()).value<std::function<void(QString)>>();')
  println('    if (callback) callback(payload);')
  println('  }')
  println('  void remove(int handle, const QString &name, const QString &payload) {')
  println('    const int index = indexOf(handle);')
  println('    if (index < 0 || activeSources.contains(handle) || deleting.contains(handle)) return;')
  println('    const auto instance = instances[index];')
  // A class's deletion hook can dispatch more operations, so look up its handle again after the hook.
  println('    deleting.append(handle);')
  println('    work(handle, name, payload);')
  println('    deleting.removeLast();')
  println('    instances.removeAt(indexOf(handle));')
  println('    if (selected == handle) selected = 0;')
  println('    if (instance.root) { instance.root->hide(); instance.root->deleteLater(); }')
  println('  }')
  println('  void dispatch(const QString &name, const QString &payload) {')
  println('    if (name == QStringLiteral("##add")) {')
  println('      for (const auto &entry : classes) {')
  println('        if (entry.name.compare(payload, Qt::CaseInsensitive) != 0) continue;')
  println('        if (nextHandle == 2147483647) return;')
  println('        const int handle = ++nextHandle;')
  println('        auto *root = entry.create(widgetParent, this);')
  println('        instances.append({handle, payload, root});')
  println('        work(handle, name, payload);')
  println('        return;')
  println('      }')
  println('      return;')
  println('    }')
  println('    if (name == QStringLiteral("##clear")) {')
  println('      const auto snapshot = instances;')
  println('      for (auto it = snapshot.crbegin(); it != snapshot.crend(); ++it)')
  println('        remove(it->handle, QStringLiteral("##delete"), QString::number(indexOf(it->handle)));')
  println('      return;')
  println('    }')
  println('    if (name == QStringLiteral("##nselect")) {')
  println('      selected = 0;')
  println('      const auto snapshot = instances;')
  println('      for (const auto &instance : snapshot) {')
  println('        if (instance.name != payload || indexOf(instance.handle) < 0) continue;')
  println('        selected = instance.handle;')
  println('        work(selected, name, payload);')
  println('      }')
  println('      return;')
  println('    }')
  println('    if (name == QStringLiteral("##select") || name == QStringLiteral("##hselect") ||')
  println('        name == QStringLiteral("##delete") || name == QStringLiteral("##hdelete")) {')
  println('      bool valid = false;')
  println('      const int number = payload.toInt(&valid);')
  println('      const int index = !valid ? -1 : name.startsWith(QStringLiteral("##h")) ? indexOf(number) : number;')
  println('      const int handle = instances.value(index).handle;')
  println('      if (name.endsWith(QStringLiteral("select"))) { selected = handle; work(handle, name, payload); }')
  println('      else remove(handle, name, payload);')
  println('      return;')
  println('    }')
  if(get('WorkScheme') == 1)
    println('    const auto snapshot = instances;')
    println('    for (const auto &instance : snapshot) work(instance.handle, name, payload);')
  else
    println('    work(selected, name, payload);')
  end
  println('  }')
  println('  QString read(const QString &name) const {')
  println('    const auto instance = instances.value(indexOf(selected));')
  println('    if (name == QStringLiteral("##name")) return instance.name;')
  println('    if (!instance.root) return {};')
  println('    const auto callback = instance.root->property((QByteArray("polyIn:") + name.toUtf8()).constData()).value<std::function<QString()>>();')
  println('    return callback ? callback() : QString();')
  println('  }')
  println('};')
  println('auto *poly = new PolyManager(&form);')
  println('poly->setObjectName(QStringLiteral("', element, _id_, '"));')
  println('poly->widgetParent = widgetParent;')
  println('poly->setProperty("polyWork", QVariant::fromValue(std::function<void(QString, QString)>([poly](const QString &name, const QString &payload) { poly->dispatch(name, payload); })));')
  println('poly->setProperty("polyRead", QVariant::fromValue(std::function<QString(QString)>([poly](const QString &name) { return poly->read(name); })));')
  println('poly->setProperty("polyNumber", QVariant::fromValue(std::function<int(QString)>([poly](const QString &name) {')
  println('  if (name == QStringLiteral("##count")) return int(poly->instances.size());')
  println('  if (name == QStringLiteral("##handle")) return poly->selected;')
  println('  if (name == QStringLiteral("##eventhandle")) return poly->source;')
  println('  return poly->indexOf(name == QStringLiteral("##eventindex") ? poly->source : poly->selected);')
  println('})));')
  for(i = 0; i < this.numevents; i++)
    port = this.pt_event(i).name
    if(linked(port))
      println('poly->setProperty("polyEvent:" ', cstr(lower(port)), ', QVariant::fromValue(std::function<void(QWidget *, QString)>([&form, poly](QWidget *root, const QString &payload) {')
      println('  const int handle = poly->handleOf(root);')
      println('  if (!handle) return;')
      println('  const int previous = poly->source;')
      println('  poly->source = handle;')
      println('  poly->activeSources.append(handle);')
      event(port, code('payload'))
      println('  poly->activeSources.removeLast();')
      println('  poly->source = previous;')
      println('})));')
    end
  end
  for(i = 0; i < this.numdatas; i++)
    port = this.pt_data(i).name
    if(linked(port))
      println('poly->setProperty("polyData:" ', cstr(lower(port)), ', QVariant::fromValue(std::function<QString(QWidget *)>([&form, poly](QWidget *root) {')
      println('  const int handle = poly->handleOf(root);')
      println('  if (!handle) return QString();')
      println('  const int previous = poly->source;')
      println('  poly->source = handle;')
      println('  poly->activeSources.append(handle);')
      println('  const auto value = qt_text(', d(port), ');')
      println('  poly->activeSources.removeLast();')
      println('  poly->source = previous;')
      println('  return value;')
      println('})));')
    end
  end
  for(i = 1; i <= get('qtPolyClassCount'); i++)
    sdk = this.get_sdk(i)
    frame = sdk.child(0)
    name = frame.props('qtPolyClassName').value
    println('poly->classes.append({qt_text(', cstr(name), '), [](QWidget *owner, QObject *bridge) -> QWidget * {')
    block.inclvl()
    if(isWindow)
      println('auto *root = new HiasmForm(owner, Qt::Window);')
    else
      println('auto *root = new HiasmForm(owner);')
    end
    println('auto &form = *root;')
    // Repeated instances share generated widget names. Each factory provides its own lookup root.
    println('QWidget *widgetParent = root;')
    println('root->setProperty("polyBridge", QVariant::fromValue(bridge));')
    if(isWindow)
      sdk.run_child(1, 'qtPolyStart')
    else
      sdk.run_child(1, 'dostart')
      println('widgetParent = qt_widget<QWidget>(form, "Panel', number(frame.props('qtPolyHostId')), '");')
      println('root->setGeometry(widgetParent->geometry());')
      println('widgetParent->move(0, 0);')
    end
    sdk.run_all('dostart')
    sdk.run_child(0, 'polyBind')
    if(isWindow)
      sdk.run_child(1, 'qtPolyReady')
    else
      println('root->show();')
    end
    println('return root;')
    block.declvl()
    println('}});')
  end
  println('}')
end

func polyWork(pointIndex, payload)
  fvar(port)
  port = this.pt_work(pointIndex).name
  println('if (auto *poly = ', PolyManager(), ') {')
  println('  auto call = poly->property("polyWork").value<std::function<void(QString, QString)>>();')
  println('  if (call) call(qt_text(', cstr(lower(port)), '), ', PolyArgument(payload), ');')
  println('}')
end

func polyVar(pointIndex)
  fvar(port, manager)
  port = lower(this.pt_var(pointIndex).name)
  manager = PolyManager()
  if(port == '##count' or port == '##index' or port == '##handle' or port == '##eventindex' or port == '##eventhandle')
    return('([&] { auto *poly = ' && manager && '; return poly ? poly->property("polyNumber").value<std::function<int(QString)>>()(qt_text(' && cstr(port) && ')) : -1; }())')
  end
  return('([&] { auto *poly = ' && manager && '; return poly ? poly->property("polyRead").value<std::function<QString(QString)>>()(qt_text(' && cstr(port) && ')) : QString(); }())')
end
