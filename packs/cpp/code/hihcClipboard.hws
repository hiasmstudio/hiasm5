func doPutText(_data)
  fvar(text)
  if(is_gui_project())
    text = '"' && code(d('Text')) && '"'
    println('gdk_clipboard_set_text(gdk_display_get_clipboard(gdk_display_get_default()), ', text, ');')
    event(onPutText)
  else
    error('hcClipboard needs a GUI project')
  end
end

func CurrentText()
  if(is_gui_project())
    return('hiasm_clipboard_text()')
  else
    error('hcClipboard needs a GUI project')
    return('""')
  end
end
