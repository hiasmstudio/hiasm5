include('qtMstClient')

func VirtualTarget()
  return('dynamic_cast<HiasmMstVirtual *>(form.findChild<QObject *>(QStringLiteral("MST_Virtual' && _id_ && '")))')
end

func doStart
  println('{ auto *page = new HiasmMstVirtual(&form);')
  println('page->setObjectName(QStringLiteral("MST_Virtual', _id_, '"));')
  println('page->initialPage = qMax(0, int(', DefaultPage, '));')
  println('page->columnByName = ', get('SubItemName') == 0, ';')
  if(linked('VirtualData'))
    // Forward the cell request to the linked variable through its MT arguments.
    println('page->provider = [&form](qint64 virtualIndex, int rowIndex, const QVariant &subitem) {')
    println('  Q_UNUSED(virtualIndex); Q_UNUSED(rowIndex); Q_UNUSED(subitem);')
    println('  return qt_mst_tuple(', event('VirtualData', 'virtualIndex', 'rowIndex', 'subitem'), ');')
    println('};')
  end
  println('QTimer::singleShot(0, page, [&form, page] {')
  println('  if (page->attach(', MstTarget(), ') && !page->rendered) page->refresh();')
  println('}); }')
end

func ChangePage(position)
  fvar(page)
  page = 'virtualPage' && _id_
  println('if (auto *', page, ' = ', VirtualTarget(), '; ', page, ' && ', page, '->attach(', MstTarget(), ')) {')
  println(page, '->moveTo(', position, ');')
  println(page, '->refresh();')
  event(onChangeVirtIdx, page && '->index')
  println('}')
end

func doNextPage(_data)
  fvar(page)
  page = 'virtualPage' && _id_
  ChangePage('qint64(' && page && '->index) + ' && page && '->perPage()')
end

func doPrevPage(_data)
  fvar(page)
  page = 'virtualPage' && _id_
  ChangePage('qint64(' && page && '->index) - ' && page && '->perPage()')
end

func doSetPage(_data)
  fvar(value, requested)
  value = mt_arg(0)
  if(linked('Page'))
    value = d('Page')
  end
  requested = 'mstRequestedPage' && _id_
  println('{ const int ', requested, ' = ', MstInt(MstDefault(value, get('DefaultPage'))), ';')
  println('if (', requested, ' >= 0) {')
  ChangePage('qint64(' && requested && ') * virtualPage' && _id_ && '->perPage()')
  println('} }')
end

func doResetPage(_data)
  ChangePage('qint64(virtualPage' && _id_ && '->initialPage) * virtualPage' && _id_ && '->perPage()')
end

func doInitPage(_data)
  ChangePage('virtualPage' && _id_ && '->index')
end

func doSetVirtIdx(_data)
  fvar(value)
  value = mt_arg(0)
  if(linked('VirtIdx'))
    value = d('VirtIdx')
  end
  ChangePage(MstInt(value))
end

func VirtualValue(expression)
  return('([](HiasmMstVirtual *page, HiasmMstTable *table) { return page && page->attach(table) ? page->' && expression && ' : 0; }(' && VirtualTarget() && ', ' && MstTarget() && '))')
end

func CurVirtIdx()
  return(VirtualValue('index'))
end

func CurPage()
  return(VirtualValue('pageNumber()'))
end

func PerPage()
  return(VirtualValue('perPage()'))
end
