func Counter()
  return('hiasm_int_state(' && _id_ && ', ' && get('Default') && ')')
end

func doNext(_data)
  println('{')
  block.inclvl()
  println('int &hiasm_cnt', _id_, ' = ', Counter(), ';')
  println('const int hiasm_cmin', _id_, ' = ', get('Min'), ';')
  println('const int hiasm_cmax', _id_, ' = ', get('Max'), ';')
  println('const int hiasm_cstep', _id_, ' = ', get('Step'), ';')
  if(get('Type') == 1)
    println('hiasm_cnt', _id_, ' -= hiasm_cstep', _id_, ';')
    println('if(hiasm_cnt', _id_, ' < hiasm_cmin', _id_, ') hiasm_cnt', _id_, ' = hiasm_cmax', _id_, ';')
  else
    println('hiasm_cnt', _id_, ' += hiasm_cstep', _id_, ';')
    println('if(hiasm_cnt', _id_, ' > hiasm_cmax', _id_, ') hiasm_cnt', _id_, ' = hiasm_cmin', _id_, ';')
  end
  event(onNext, 'hiasm_cnt' && _id_)
  block.declvl()
  println('}')
end

func doPrev(_data)
  println('{')
  block.inclvl()
  println('int &hiasm_cnt', _id_, ' = ', Counter(), ';')
  println('const int hiasm_cmin', _id_, ' = ', get('Min'), ';')
  println('const int hiasm_cmax', _id_, ' = ', get('Max'), ';')
  println('const int hiasm_cstep', _id_, ' = ', get('Step'), ';')
  if(get('Type') == 1)
    println('hiasm_cnt', _id_, ' += hiasm_cstep', _id_, ';')
    println('if(hiasm_cnt', _id_, ' > hiasm_cmax', _id_, ') hiasm_cnt', _id_, ' = hiasm_cmin', _id_, ';')
  else
    println('hiasm_cnt', _id_, ' -= hiasm_cstep', _id_, ';')
    println('if(hiasm_cnt', _id_, ' < hiasm_cmin', _id_, ') hiasm_cnt', _id_, ' = hiasm_cmax', _id_, ';')
  end
  event(onNext, 'hiasm_cnt' && _id_)
  block.declvl()
  println('}')
end

func doReset(_data)
  println('hiasm_int_state(', _id_, ', ', get('Default'), ') = ', get('Default'), ';')
end

func doValue(_data)
  fvar(value)
  value = _data
  if(len(value) == 0)
    value = get('Default')
  end
  println('hiasm_int_state(', _id_, ', ', get('Default'), ') = static_cast<int>(', value, ');')
end

func Count()
  return(Counter())
end

func Min()
  return(get('Min'))
end

func Max()
  return(get('Max'))
end

func Step()
  return(get('Step'))
end
