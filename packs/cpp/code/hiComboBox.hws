func Arg(value)
  if(len(value) > 0)
    return(value)
  else
    return('""')
  end
end

func doStart
  println('{')
  fvar(first, parts, i)
  first = 0
  switch(d('AddType'))
    case 1: first = 1
  end
  println('GtkWidget *combo = gtk_combo_box_text_new();')
  println('hiasm_set_background(combo, ', cstr(d('Color')), ');')
  parts = split(Strings, "\n")
  i = 0
  while(i < parts.size())
    println('hiasm_combo_add(GTK_COMBO_BOX(combo), ', cstr(parts.get(i)), ', ', first, ');')
    i = i + 1
  end
  switch(get('Sort'))
    case "True": println('hiasm_combo_sort(GTK_COMBO_BOX(combo));')
  end
  if(get('ItemHeight') > 0)
    println('hiasm_combo_set_item_height(combo, ', get('ItemHeight'), ');')
  end
  if(get('DropDownCount') > 0)
    println('hiasm_combo_set_dropdown(combo, ', get('DropDownCount'), ');')
  end
  println('hiasm_place("ComboBox', _id_, '", combo, ', Left, ', ', Top, ');')
  println('GtkWidget *hiasm_entry', _id_, ' = gtk_combo_box_get_child(GTK_COMBO_BOX(combo));')
  switch(get('ReadOnly'))
    case 0: println('if(hiasm_entry', _id_, ' && GTK_IS_EDITABLE(hiasm_entry', _id_, ')) gtk_editable_set_editable(GTK_EDITABLE(hiasm_entry', _id_, '), FALSE);')
  end
  println('if(hiasm_entry', _id_, ' && GTK_IS_EDITABLE(hiasm_entry', _id_, ')) gtk_editable_set_text(GTK_EDITABLE(hiasm_entry', _id_, '), ', cstr(d('Text')), ');')
  if(linked(onClick))
    println('g_signal_connect(combo, "changed", G_CALLBACK(+[](GtkComboBox *combo, gpointer) {')
  println('if(!hiasm_form_ready) return;')
    block.inclvl()
    switch(d('DataType'))
      case 1: event(onClick, 'hiasm_combo_text(combo)')
      default: event(onClick, 'gtk_combo_box_get_active(combo)')
    end
    block.declvl()
    println('}), NULL);')
  end
  if(linked(onChangeText))
    println('if(hiasm_entry', _id_, ' && GTK_IS_EDITABLE(hiasm_entry', _id_, ')) g_signal_connect(hiasm_entry', _id_, ', "changed", G_CALLBACK(+[](GtkEditable *editable, gpointer) {')
    println('if(!hiasm_form_ready) return;')
    block.inclvl()
    event(onChangeText, 'std::string(gtk_editable_get_text(editable))')
    block.declvl()
    println('}), NULL);')
  end
  println('}')
end

func First()
  fvar(first)
  first = 0
  switch(get('AddType'))
    case 1: first = 1
  end
  return(first)
end

func doAdd(_data)
  println('hiasm_combo_add(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str(), ', First(), ');')
  event(onChange)
end

func doText(_data)
  println('hiasm_combo_from_text(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str(), ', First(), ');')
  event(onChange)
end

func doClear(_data)
  println('hiasm_combo_clear(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get()));')
  event(onChange)
end

func doSelect(_data)
  println('gtk_combo_box_set_active(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get()), static_cast<int>(', _data, '));')
  event(onSelect, _data)
end

func doReplace(_data)
  println('hiasm_combo_replace(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str());')
  event(onChange)
end

func doAddDir(_data)
  println('hiasm_combo_add_dir(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str());')
  event(onChange)
end

func doEditText(_data)
  println('{ GtkWidget *entry = gtk_combo_box_get_child(GTK_COMBO_BOX(hiasm_widget("ComboBox', _id_, '").get())); if(entry && GTK_IS_EDITABLE(entry)) gtk_editable_set_text(GTK_EDITABLE(entry), hiasm_text(', Arg(_data), ').c_str()); }')
end

func doEditTextNoEvents(_data)
  doEditText(_data)
end

func Array()
  return('hiasm_combo_lines(hiasm_combo("ComboBox' && _id_ && '"))')
end

func String()
  return('hiasm_combo_text(hiasm_combo("ComboBox' && _id_ && '"))')
end

func Index()
  return('gtk_combo_box_get_active(hiasm_combo("ComboBox' && _id_ && '"))')
end

func Text()
  return('hiasm_join_lines(hiasm_combo_lines(hiasm_combo("ComboBox' && _id_ && '")))')
end

func Count()
  return('static_cast<int>(hiasm_combo_lines(hiasm_combo("ComboBox' && _id_ && '")).size())')
end

func EndIdx()
  return('(static_cast<int>(hiasm_combo_lines(hiasm_combo("ComboBox' && _id_ && '")).size()) - 1)')
end

func EditText()
  return('std::string(gtk_editable_get_text(GTK_EDITABLE(gtk_combo_box_get_child(GTK_COMBO_BOX(hiasm_combo("ComboBox' && _id_ && '"))))))')
end

