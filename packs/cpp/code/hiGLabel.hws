func GradientLabel()
  return('qt_widget<HiasmGradientLabel>(form, "GLabel' && _id_ && '")')
end

func doStart
  println('{')
  println('auto *label = new HiasmGradientLabel(widgetParent);')
  println('label->setObjectName(QStringLiteral("GLabel', _id_, '"));')
  println('label->setTextFormat(Qt::PlainText);')
  println('label->setGeometry(', Left, ', ', Top, ', ', Width, ', ', Height, ');')
  println('label->background = qt_led_color(qt_text(', cstr(d('Color')), '), label->palette().color(QPalette::Window));')
  println('label->shadow = qt_led_color(qt_text(', cstr(d('ColorShadow')), '), Qt::black);')
  println('label->hover = qt_led_color(qt_text(', cstr(d('ColorHover')), '), Qt::black);')
  println('label->autoSize = ', get('AutoSize') == 'True', ';')
  println('label->setAutoFillBackground(', get('Transparent') == 'False', ');')
  println('label->setEnabled(', get('Enabled') == 'True', ');')
  println('label->setVisible(', get('Visible') == 'True', ');')
  println('label->setToolTip(qt_text(', cstr(d('Hint')), '));')
  println('label->textGradient = ', get('TextGradient') == 'True', ';')
  println('label->backgroundGradient = ', get('FonGradient') == 'True', ';')
  println('label->horizontal = ', get('Horizontal') == 'True', ';')
  println('label->backgroundHorizontal = ', get('HorizFonGrad') == 'True', ';')
  println('label->reverse = ', get('InversGrad') == 'True', ';')
  println('label->backgroundReverse = ', get('InvFonGrad') == 'True', ';')
  println('label->smooth = ', get('Antialiased') == 'True', ';')
  println('label->symbolGradient = ', get('HSymbolGrad') == 'True', ';')
  println('label->underline = ', get('Underline') == 'True', ';')
  println('label->depth = ', DepthGrad, ';')
  println('label->contrast = ', Contrast, ';')
  println('label->backgroundContrast = ', ContrastFon, ';')
  println('label->shadowDepth = ', DepthShadow, ';')
  fvar(horizontal, vertical)
  horizontal = 'Qt::AlignLeft'
  vertical = 'Qt::AlignVCenter'
  switch(get('Alignment'))
    case 'taRight': horizontal = 'Qt::AlignRight'
    case 'taCenter': horizontal = 'Qt::AlignHCenter'
  end
  switch(get('VAlignment'))
    case 'vaTop': vertical = 'Qt::AlignTop'
    case 'vaBottom': vertical = 'Qt::AlignBottom'
  end
  println('label->setAlignment(', horizontal, ' | ', vertical, ');')
  println('qt_apply_font(label, qt_text(', cstr(get('Font')), '));')
  println('label->setCaption(qt_text(', cstr(d('Caption')), '));')
  if(linked(onClick))
    println('label->clicked = [&form] {')
    event(onClick)
    println('};')
  end
  println('}')
end

func doText(_data)
  fvar(value)
  value = _data
  if(linked('Text'))
    value = d('Text')
  elseif(len(value) == 0)
    value = '""'
  end
  println(GradientLabel(), '->setCaption(qt_text(', value, '));')
end

func Caption()
  return(GradientLabel() && '->text()')
end

func GradientFlag(field, value)
  println('{ auto *label = ', GradientLabel(), '; label->', field, ' = qt_flag(qt_text(', Arg(value), ')); label->update(); }')
end

func GradientNumber(field, value)
  println('{ auto *label = ', GradientLabel(), '; label->', field, ' = qt_text(', Arg(value), ').toInt(); label->update(); }')
end

func GradientColor(field, value)
  println('{ auto *label = ', GradientLabel(), '; label->', field, ' = qt_led_color(qt_text(', Arg(value), '), label->', field, '); label->update(); }')
end

func Arg(value)
  if(len(value) > 0)
    return(value)
  end
  return('0')
end

func doTextGradient(_data)
  GradientFlag('textGradient', _data)
end

func doFonGradient(_data)
  GradientFlag('backgroundGradient', _data)
end

func doAntialiased(_data)
  GradientFlag('smooth', _data)
end

func doUnderline(_data)
  GradientFlag('underline', _data)
end

func doHorizontal(_data)
  GradientFlag('horizontal', _data)
end

func doHorizFonGrad(_data)
  GradientFlag('backgroundHorizontal', _data)
end

func doInversGrad(_data)
  GradientFlag('reverse', _data)
end

func doInvFonGrad(_data)
  GradientFlag('backgroundReverse', _data)
end

func doHSymbolGrad(_data)
  GradientFlag('symbolGradient', _data)
end

func doDepthShadow(_data)
  GradientNumber('shadowDepth', _data)
end

func doDepthGrad(_data)
  GradientNumber('depth', _data)
end

func doContrast(_data)
  GradientNumber('contrast', _data)
end

func doContrastFon(_data)
  GradientNumber('backgroundContrast', _data)
end

func doColor(_data)
  GradientColor('background', _data)
end

func doColorShadow(_data)
  GradientColor('shadow', _data)
end

func doColorHover(_data)
  GradientColor('hover', _data)
end

func doFont(_data)
  println('{ auto *label = ', GradientLabel(), '; qt_apply_font(label, qt_text(', Arg(_data), ')); label->setCaption(label->text()); }')
end

func doAlignment(_data)
  println('{ auto *label = ', GradientLabel(), '; const Qt::Alignment align[] = {Qt::AlignLeft, Qt::AlignRight, Qt::AlignHCenter};')
  println('label->setAlignment((label->alignment() & Qt::AlignVertical_Mask) | align[qBound(0, qt_text(', Arg(_data), ').toInt(), 2)]); }')
end

func doVAlignment(_data)
  println('{ auto *label = ', GradientLabel(), '; const Qt::Alignment align[] = {Qt::AlignVCenter, Qt::AlignTop, Qt::AlignBottom};')
  println('label->setAlignment((label->alignment() & Qt::AlignHorizontal_Mask) | align[qBound(0, qt_text(', Arg(_data), ').toInt(), 2)]); }')
end
