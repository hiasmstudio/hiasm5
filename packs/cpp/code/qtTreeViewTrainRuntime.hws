func qtEmitTreeViewTrainRuntime()
  println('#include <QDrag>')
  println('#include <QPersistentModelIndex>')
  println('static QString qt_text(const QVariant &value) { return value.toString(); }')
  println('static QString qt_text(const QVariantList &row) { return row.value(0).toString(); }')
  println('static QVariant qt_tvt_value(const char *value) { return QString::fromUtf8(value); }')
  println('template<class T> static QVariant qt_tvt_value(T value) { return QVariant::fromValue(value); }')
  println('static QVariantList qt_tvt_row(const QVariantList &row) { return row; }')
  println('static QVariantList qt_tvt_row(const QStringList &cells) {')
  println('  QVariantList row; for (const auto &cell : cells) row.append(cell); return row;')
  println('}')
  println('template<class T> static QVariantList qt_tvt_row(const T &value) { return {qt_tvt_value(value)}; }')
  println('static QVariant qt_tvt_id(const QVariantList &row) { return row.value(0); }')
  println('template<class T> static QVariant qt_tvt_id(const T &value) { return qt_tvt_value(value); }')
  println('static bool qt_tvt_integer(const QVariant &value) {')
  println('  const int type = value.typeId();')
  println('  return type == QMetaType::Int || type == QMetaType::LongLong || type == QMetaType::UInt || type == QMetaType::ULongLong;')
  println('}')
  println('static QVariant qt_tvt_cell(const QString &text) {')
  println('  const auto value = text.trimmed();')
  println('  bool ok = false; const int integer = value.toInt(&ok);')
  println('  if (ok) return integer;')
  println('  static const QRegularExpression decimal(QStringLiteral("^-?[0-9]*[.][0-9]*$"));')
  println('  if (decimal.match(value).hasMatch()) { const double real = value.toDouble(&ok); if (ok) return real; }')
  println('  return text;')
  println('}')
  println('class HiasmTreeViewTrain : public QTreeWidget {')
  println('public:')
  println('  using QTreeWidget::QTreeWidget;')
  println('  int captionIndex = 0, parentIndex = 0, idIndex = 0, iconIndex = 0, numeric = -1;')
  println('  QString emptyString;')
  println('  bool hashed = false, hints = false;')
  println('  QPointer<HiasmIconsManager> icons;')
  println('  std::function<void(const QVariantList &)> deleted, dropped;')
  println('  std::function<bool(const QVariantList &)> dropAccept;')
  println('  static QVariantList tuple(const QTreeWidgetItem *item) { return item ? item->data(0, Qt::UserRole).toList() : QVariantList(); }')
  println('  QVariantList selection() const { return tuple(currentItem()); }')
  println('  bool emptyField(const QVariant &value) const {')
  println('    return (qt_tvt_integer(value) && value.toLongLong() == numeric) ||')
  println('           (value.typeId() == QMetaType::QString && value.toString() == emptyString);')
  println('  }')
  println('  QTreeWidgetItem *find(const QVariant &id) const {')
  println('    if (!id.isValid()) return nullptr;')
  println('    if (hashed) { const auto matches = index.constFind(id.toString()); if (matches != index.cend() && !matches->isEmpty()) return matches->first(); }')
  println('    for (QTreeWidgetItemIterator it(const_cast<HiasmTreeViewTrain *>(this)); *it; ++it) {')
  println('      const auto row = tuple(*it);')
  println('      if (idIndex < 0 || idIndex >= row.size()) continue;')
  println('      const auto value = row.at(idIndex);')
  println('      if ((value.typeId() == id.typeId() || (qt_tvt_integer(value) && qt_tvt_integer(id))) && value == id) return *it;')
  println('    }')
  println('    return nullptr;')
  println('  }')
  println('  void refreshIcons() {')
  println('    if (icons) setIconSize(QSize(icons->size, icons->size));')
  println('    for (QTreeWidgetItemIterator it(this); *it; ++it) applyIcon(*it, tuple(*it));')
  println('  }')
  println('  QTreeWidgetItem *addAt(QTreeWidgetItem *parent, const QVariantList &row) {')
  println('    auto *item = new QTreeWidgetItem(parent ? parent : invisibleRootItem());')
  println('    updateItem(item, row);')
  println('    if (hashed) index[key(row)].append(item);')
  println('    return item;')
  println('  }')
  println('  bool add(const QVariantList &row) {')
  println('    QTreeWidgetItem *parent = nullptr;')
  println('    if (parentIndex >= 0 && parentIndex < row.size() && !emptyField(row.at(parentIndex))) {')
  println('      parent = find(row.at(parentIndex));')
  println('      if (!parent) return false;')
  println('    }')
  println('    addAt(parent, row); return true;')
  println('  }')
  println('  bool change(const QVariantList &patch) {')
  println('    if (idIndex < 0 || idIndex >= patch.size()) return false;')
  println('    auto *item = find(patch.at(idIndex)); if (!item) return false;')
  println('    auto row = tuple(item); const auto oldKey = key(row);')
  println('    for (qsizetype i = 0; i < row.size() && i < patch.size(); ++i)')
  println('      if (!emptyField(patch.at(i))) row[i] = patch.at(i);')
  println('    updateItem(item, row);')
  println('    if (hashed && oldKey != key(row)) { unindex(oldKey, item); index[key(row)].append(item); }')
  println('    return true;')
  println('  }')
  println('  bool remove(const QVariantList &row) {')
  println('    if (idIndex < 0 || idIndex >= row.size()) return false;')
  println('    auto *item = find(row.at(idIndex)); if (!item) return false;')
  println('    if (!removing.isEmpty()) return false;')
  println('    for (auto *node : branch(item)) removing.append(indexFromItem(node));')
  println('    const auto pending = removing;')
  println('    for (auto it = pending.crbegin(); it != pending.crend(); ++it)')
  println('      if (it->isValid() && deleted) deleted(tuple(itemFromIndex(*it)));')
  println('    for (const auto &entry : pending) if (entry.isValid() && hashed) {')
  println('      auto *node = itemFromIndex(entry); unindex(key(tuple(node)), node);')
  println('    }')
  println('    if (pending.first().isValid()) delete itemFromIndex(pending.first());')
  println('    removing.clear(); return true;')
  println('  }')
  println('  void clearTrain() { index.clear(); clear(); }')
  println('  qlonglong nextID() const {')
  println('    qlonglong next = 1;')
  println('    for (auto *item : branch(invisibleRootItem(), false)) {')
  println('      bool ok = false; const int id = tuple(item).value(idIndex).toInt(&ok);')
  println('      if (ok && id >= next) next = qlonglong(id) + 1;')
  println('    }')
  println('    return next;')
  println('  }')
  println('  void expandTrain(const QVariant &id, int mode) {')
  println('    if (auto *item = find(id); item && item->childCount()) item->setExpanded(mode == 2 ? !item->isExpanded() : mode == 1);')
  println('  }')
  println('  void expandBranches(bool expand) {')
  println('    QList<QPersistentModelIndex> branches;')
  println('    for (auto *item : branch(invisibleRootItem(), false)) if (item->childCount()) branches.append(indexFromItem(item));')
  println('    for (const auto &entry : branches) if (entry.isValid()) itemFromIndex(entry)->setExpanded(expand);')
  println('  }')
  println('  QList<QVariantList> enumerate(const QVariant &id = {}) const {')
  println('    QList<QVariantList> result;')
  println('    auto *parent = id.isValid() ? find(id) : invisibleRootItem();')
  println('    if (parent) for (auto *item : branch(parent, false)) result.append(tuple(item));')
  println('    return result;')
  println('  }')
  println('  static QString path(const QTreeWidgetItem *item, const QString &delimiter) {')
  println('    QStringList parts; for (; item; item = item->parent()) parts.prepend(item->text(0));')
  println('    return parts.join(delimiter.left(1));')
  println('  }')
  println('  void loadText(const QString &text, const QString &delimiter) {')
  println('    clearTrain();')
  println('    auto lines = text.split(QChar(10)); if (lines.last().isEmpty()) lines.removeLast();')
  println('    QList<QTreeWidgetItem *> parents{nullptr}; QTreeWidgetItem *last = nullptr;')
  println('    for (auto line : lines) {')
  println('      if (line.endsWith(QChar(13))) line.chop(1);')
  println('      if (line == QStringLiteral("(")) { if (last) parents.append(last); last = nullptr; continue; }')
  println('      if (line == QStringLiteral(")")) { last = parents.size() > 1 ? parents.takeLast() : nullptr; continue; }')
  println('      QVariantList row;')
  println('      const auto cells = delimiter.isEmpty() ? QStringList{line} : line.split(delimiter);')
  println('      for (const auto &cell : cells) row.append(qt_tvt_cell(cell));')
  println('      last = addAt(parents.last(), row);')
  println('    }')
  println('  }')
  println('  QString saveText(const QString &delimiter) const {')
  println('    QStringList lines; QList<QTreeWidgetItem *> parents;')
  println('    for (auto *item : branch(invisibleRootItem(), false)) {')
  println('      while (!parents.isEmpty() && parents.last() != item->parent()) { parents.removeLast(); lines.append(QStringLiteral(")")); }')
  println('      QStringList fields;')
  println('      for (const auto &value : tuple(item)) {')
  println('        auto field = value.toString();')
  println('        if ((value.typeId() == QMetaType::Double || value.typeId() == QMetaType::Float) && !field.contains(QChar(46)) && !field.contains(QChar(101))) field += QStringLiteral(".0");')
  println('        fields.append(field);')
  println('      }')
  println('      lines.append(fields.join(delimiter));')
  println('      if (item->childCount()) { parents.append(item); lines.append(QStringLiteral("(")); }')
  println('    }')
  println('    for (qsizetype i = 0; i < parents.size(); ++i) lines.append(QStringLiteral(")"));')
  println('    const auto newline = QString(QChar(13)) + QChar(10);')
  println('    return lines.isEmpty() ? QString() : lines.join(newline) + newline;')
  println('  }')
  println('protected:')
  println('  void startDrag(Qt::DropActions actions) override {')
  println('    if (!currentItem() || !actions.testFlag(Qt::MoveAction)) return;')
  println('    auto *mime = mimeData({currentItem()}); if (!mime) return;')
  println('    dragItem = currentIndex();')
  println('    QDrag drag(this); drag.setMimeData(mime); drag.exec(Qt::MoveAction);')
  println('    dragItem = QPersistentModelIndex();')
  println('  }')
  println('  void dragMoveEvent(QDragMoveEvent *event) override {')
  println('    const QPersistentModelIndex target(indexAt(event->position().toPoint()));')
  println('    if (!acceptsDrop(event, target)) { event->ignore(); return; }')
  println('    event->setDropAction(Qt::MoveAction); event->accept();')
  println('  }')
  println('  void dropEvent(QDropEvent *event) override {')
  println('    const QPersistentModelIndex target(indexAt(event->position().toPoint()));')
  println('    if (!acceptsDrop(event, target)) { event->ignore(); return; }')
  println('    auto *node = itemFromIndex(dragItem); auto *destination = itemFromIndex(target);')
  println('    auto row = tuple(node);')
  println('    const auto oldKey = key(row);')
  println('    if (parentIndex >= 0 && parentIndex < row.size()) row[parentIndex] = tuple(destination).value(idIndex);')
  println('    { const QSignalBlocker blocker(this);')
  println('      auto *parent = node->parent() ? node->parent() : invisibleRootItem();')
  println('      destination->addChild(parent->takeChild(parent->indexOfChild(node)));')
  println('      updateItem(node, row); setCurrentItem(node);')
  println('    }')
  println('    if (hashed && oldKey != key(row)) { unindex(oldKey, node); index[key(row)].append(node); }')
  println('    event->setDropAction(Qt::MoveAction); event->accept();')
  println('    if (dropped) dropped(row);')
  println('  }')
  println('private:')
  println('  QHash<QString, QList<QTreeWidgetItem *>> index;')
  println('  QPersistentModelIndex dragItem;')
  println('  QList<QPersistentModelIndex> removing;')
  println('  QString key(const QVariantList &row) const { return row.value(idIndex, row.value(0)).toString(); }')
  println('  void unindex(const QString &key, QTreeWidgetItem *item) {')
  println('    auto entry = index.find(key); if (entry == index.end()) return;')
  println('    entry->removeOne(item); if (entry->isEmpty()) index.erase(entry);')
  println('  }')
  println('  static QList<QTreeWidgetItem *> branch(QTreeWidgetItem *item, bool includeRoot = true) {')
  println('    QList<QTreeWidgetItem *> rows, pending;')
  println('    if (includeRoot) pending.append(item);')
  println('    else for (int i = item->childCount(); i > 0; --i) pending.append(item->child(i - 1));')
  println('    while (!pending.isEmpty()) {')
  println('      auto *node = pending.takeLast(); rows.append(node);')
  println('      for (int i = node->childCount(); i > 0; --i) pending.append(node->child(i - 1));')
  println('    }')
  println('    return rows;')
  println('  }')
  println('  void applyIcon(QTreeWidgetItem *item, const QVariantList &row) {')
  println('    bool valid = false; const int icon = row.value(iconIndex).toInt(&valid);')
  println('    item->setIcon(0, icons && valid ? QIcon(QPixmap::fromImage(icons->icons.value(icon))) : QIcon());')
  println('  }')
  println('  void updateItem(QTreeWidgetItem *item, const QVariantList &row) {')
  println('    item->setData(0, Qt::UserRole, row);')
  println('    item->setText(0, row.value(captionIndex, QStringLiteral("node")).toString());')
  println('    if (hints) item->setToolTip(0, item->text(0));')
  println('    applyIcon(item, row);')
  println('  }')
  println('  bool acceptsDrop(QDropEvent *event, const QPersistentModelIndex &target) const {')
  println('    if (event->source() != this || !dragItem.isValid() || !target.isValid()) return false;')
  println('    for (QModelIndex p = target; p.isValid(); p = p.parent()) if (p == dragItem) return false;')
  println('    const auto accepts = !dropAccept || dropAccept(tuple(itemFromIndex(target)));')
  println('    return accepts && dragItem.isValid() && target.isValid();')
  println('  }')
  println('};')
  println('static QString qt_tvt_delimiter(QString value) { return value.replace(QString(QChar(92)) + QChar(116), QString(QChar(9))); }')
  println('static QList<int> qt_tvt_columns(const HiasmStaticData &source, QString fields) {')
  println('  QList<int> indexes;')
  println('  fields.replace(QChar(10), QChar(44));')
  println('  for (auto field : fields.split(QChar(44), Qt::SkipEmptyParts)) {')
  println('    field = field.trimmed(); if (field.isEmpty()) continue;')
  println('    const int index = source.columns.indexOf(field); if (index < 0 || indexes.contains(index)) return {};')
  println('    indexes.append(index);')
  println('  }')
  println('  return indexes;')
  println('}')
end
