func Arg(value)
  if(len(value) > 0)
    return(value)
  else
    return('""')
  end
end

func doStart
  if(is_qt_project())
    qtStart()
  else
    gtkStart()
  end
end

func qtTarget()
  return('qt_widget<QListWidget>(form, "ListBox' && _id_ && '")')
end

func qtFill(text)
  println('target->clear();')
  println('if (const auto text = ', text, '; !text.isEmpty())')
  println('  target->addItems(QString(text).remove(QChar(13)).split(QChar(10)));')
end

func qtSelection(point, target)
  fvar(payload)
  payload = 'listSelection' && _id_
  if(get('DataType') == 1)
    println('const auto ', payload, ' = ', target, '->currentItem() ? ', target, '->currentItem()->text() : QString();')
  else
    println('const auto ', payload, ' = ', target, '->currentRow();')
  end
  event(point, payload)
end

func qtStart
  println('{')
  block.inclvl()
  println('auto *target = new QListWidget(widgetParent);')
  println('target->setObjectName(QStringLiteral("ListBox', _id_, '"));')
  println('target->setGeometry(', Left, ', ', Top, ', ', Width, ', ', Height, ');')
  if(get('Visible') == 'False')
    println('target->hide();')
  end
  if(get('Enabled') == 'False')
    println('target->setEnabled(false);')
  end
  if(get('Transparent') == 'True')
    println('target->setStyleSheet(QStringLiteral("QListWidget { background: transparent; }"));')
  elseif(isndef(Color))
    println('if (auto color = QColor::fromString(qt_text(', cstr(get('Color')), ')); color.isValid()) { auto palette = target->palette(); palette.setColor(QPalette::Base, color); target->setPalette(palette); }')
  end
  if(get('Ctl3D') == 0)
    println('target->setFrameShape(QFrame::NoFrame);')
  end
  if(get('ItemHeight') > 0)
    println('target->setStyleSheet(target->styleSheet() + QStringLiteral(" QListWidget::item { min-height: ', get('ItemHeight'), 'px; }"));')
  end
  if(get('MultiSelect') == 'True')
    println('target->setSelectionMode(QAbstractItemView::MultiSelection);')
  end
  if(get('Sort') == 'True')
    println('target->setSortingEnabled(true);')
  end
  qtFill('qt_text(' && cstr(get('Strings')) && ')')
  println('QTimer::singleShot(0, target, [&form, target] { qt_list_icons(target, form, qt_text(', cstr(get('qtIconsManager')), '), qt_text(', cstr(get('qtIndexManager')), ')); });')
  println('QTimer::singleShot(0, target, [&form, target] { qt_box_draw(target, form, qt_text(', cstr(get('qtBoxDrawManager')), ')); });')
  if(linked(onClick))
    println('QObject::connect(target, &QListWidget::itemClicked, &form, [&form, target](QListWidgetItem *) {')
    block.inclvl()
    qtSelection(onClick, 'target')
    block.declvl()
    println('});')
  end
  block.declvl()
  println('}')
end

func gtkStart
  println('{')
  fvar(first, select, parts, i)
  first = 0
  switch(d('AddType'))
    case 1: first = 1
  end
  select = 0
  switch(d('SelectAdd'))
    case "True": select = 1
  end
  println('GtkWidget *list = gtk_list_box_new();')
  println('hiasm_set_background(list, ', cstr(d('Color')), ');')
  switch(get('Transparent'))
    case "True": println('hiasm_set_background(list, "transparent");')
  end
  switch(get('Ctl3D'))
    case 0: println('hiasm_set_border(list);')
  end
  switch(d('MultiSelect'))
    case "True": println('gtk_list_box_set_selection_mode(GTK_LIST_BOX(list), GTK_SELECTION_MULTIPLE);')
  end
  parts = split(Strings, "\n")
  i = 0
  while(i < parts.size())
    println('hiasm_list_add(GTK_LIST_BOX(list), ', cstr(parts.get(i)), ', ', first, ', ', select, ');')
    i = i + 1
  end
  switch(get('Sort'))
    case "True": println('hiasm_list_sort(GTK_LIST_BOX(list));')
  end
  if(get('ItemHeight') > 0)
    println('hiasm_list_set_item_height(GTK_LIST_BOX(list), ', get('ItemHeight'), ');')
  end
  println('hiasm_place("ListBox', _id_, '", list, ', Left, ', ', Top, ');')
  if(linked(onClick))
    println('g_signal_connect(list, "row-selected", G_CALLBACK(+[](GtkListBox *, GtkListBoxRow *row, gpointer) {')
  println('if(!hiasm_form_ready) return;')
    block.inclvl()
    println('if(row) {')
    block.inclvl()
    println('int index = gtk_list_box_row_get_index(row);')
    switch(d('DataType'))
      case 1: event(onClick, 'hiasm_list_row_text(row)')
      default: event(onClick, 'index')
    end
    block.declvl()
    println('}')
    block.declvl()
    println('}), NULL);')
  end
  println('}')
end

func First()
  fvar(first)
  first = 0
  switch(get('AddType'))
    case 1: first = 1
  end
  return(first)
end

func Select()
  fvar(select)
  select = 0
  switch(get('SelectAdd'))
    case "True": select = 1
  end
  return(select)
end

func doAdd(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), ';')
    println('const int row = target->count() * ', 1 - First(), ';')
    println('auto *item = new QListWidgetItem(qt_text(', cstr(d('Str')), '));')
    qtInsertItem()
    println('}')
    event(onChange)
    return()
  end
  println('hiasm_list_add(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str(), ', First(), ', ', Select(), ');')
  event(onChange)
end

func doText(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), ';')
    qtFill('qt_text(' && Arg(_data) && ')')
    println('}')
    event(onChange)
    return()
  end
  println('hiasm_list_from_text(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str(), ', First(), ', ', Select(), ');')
  event(onChange)
end

func doClear(_data)
  if(is_qt_project())
    println(qtTarget(), '->clear();')
    event(onChange)
    return()
  end
  println('hiasm_list_clear(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()));')
  event(onChange)
end

func doDelete(_data)
  if(is_qt_project())
    println('delete ', qtTarget(), '->takeItem(qt_text(', Arg(_data), ').toInt());')
    event(onChange)
    return()
  end
  println('hiasm_list_remove(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), static_cast<int>(', _data, '));')
  event(onChange)
end

func doSelect(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), ';')
    println('const int row = qt_text(', Arg(_data), ').toInt();')
    qtSetRow()
  if(linked(onSelect))
    qtSelection(onSelect, 'target')
  end
    println('}')
    return()
  end
  println('hiasm_list_select(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), static_cast<int>(', _data, '));')
  event(onSelect, _data)
end

func doSelectAll(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), ';')
    println('if (qt_flag(qt_text(', Arg(_data), '))) target->selectAll(); else target->clearSelection(); }')
    return()
  end
  println('hiasm_list_select_all(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()));')
end

func Text()
  if(is_qt_project())
    return('([](QListWidget *list) { QStringList lines; for (int i = 0; i < list->count(); ++i) lines.append(list->item(i)->text()); return lines.join(QString(QChar(13)) + QChar(10)); }(' && qtTarget() && '))')
  end
  return('hiasm_join_lines(hiasm_list_lines(hiasm_list_box("ListBox' && _id_ && '")))')
end

func Count()
  if(is_qt_project())
    return(qtTarget() && '->count()')
  end
  return('static_cast<int>(hiasm_list_lines(hiasm_list_box("ListBox' && _id_ && '")).size())')
end

func Array()
  return('hiasm_list_lines(hiasm_list_box("ListBox' && _id_ && '"))')
end

func Index()
  if(is_qt_project())
    return(qtTarget() && '->currentRow()')
  end
  return('hiasm_list_index(hiasm_list_box("ListBox' && _id_ && '"))')
end

func String()
  if(is_qt_project())
    return('([](QListWidget *list) { return list->currentItem() ? list->currentItem()->text() : QString(); }(' && qtTarget() && '))')
  end
  return('hiasm_list_row_text(gtk_list_box_get_selected_row(hiasm_list_box("ListBox' && _id_ && '")))')
end

func EndIdx()
  if(is_qt_project())
    return('(' && Count() && ' - 1)')
  end
  return('(static_cast<int>(hiasm_list_lines(hiasm_list_box("ListBox' && _id_ && '")).size()) - 1)')
end

func SelectArray()
  return('hiasm_list_selection(hiasm_list_box("ListBox' && _id_ && '"))')
end

func ValueArray()
  return('hiasm_list_values(hiasm_list_box("ListBox' && _id_ && '"))')
end

func doUp(_data)
  if(is_qt_project())
    qtMove(-1)
    return()
  end
  println('hiasm_list_move(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), -1);')
  event(onChange)
end

func doDown(_data)
  if(is_qt_project())
    qtMove(1)
    return()
  end
  println('hiasm_list_move(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), 1);')
  event(onChange)
end

func doReplace(_data)
  if(is_qt_project())
    if(linked('Str'))
      println('if (auto *item = ', qtTarget(), '->item(qt_text(', Arg(_data), ').toInt())) item->setText(qt_text(', cstr(d('Str')), '));')
    end
    return()
  end
  println('hiasm_list_replace(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str());')
  event(onChange)
end

func doAddDir(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), ';')
    println('const auto directory = qt_text(', Arg(_data), ');')
    println('if (!directory.isEmpty()) { target->clear(); target->addItems(QDir(directory).entryList(QDir::Files, QDir::Name)); } }')
    return()
  end
  println('hiasm_list_add_dir(GTK_LIST_BOX(hiasm_widget("ListBox', _id_, '").get()), hiasm_text(', Arg(_data), ').c_str());')
  event(onChange)
end

func doEnsureVisible(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), ';')
    println('if (auto *item = target->item(qt_text(', Arg(_data), ').toInt())) target->scrollToItem(item, QAbstractItemView::PositionAtTop); }')
  end
end

func qtMove(offset)
  println('{ auto *target = ', qtTarget(), '; const int row = target->currentRow(); const int destination = row + (', offset, ');')
  println('if (!target->isSortingEnabled() && row >= 0 && destination >= 0 && destination < target->count()) {')
  println('auto *item = target->takeItem(row); target->insertItem(destination, item); target->setCurrentItem(item); } }')
end

func qtSetRow()
  if(get('MultiSelect') == 'True')
    println('if (auto *item = target->item(row)) target->setCurrentItem(item, QItemSelectionModel::Toggle);')
  else
    println('target->setCurrentRow(row >= 0 && row < target->count() ? row : -1);')
  end
end

func doSelectString(_data)
  if(is_qt_project())
    println('{ auto *target = ', qtTarget(), '; const auto text = qt_text(', Arg(_data), ');')
    println('if (!text.isEmpty()) { const auto star = text.indexOf(QChar(42));')
    println('const auto matches = star < 0 ? target->findItems(text, Qt::MatchFixedString) : target->findItems(text.left(star), Qt::MatchStartsWith);')
    println('const int row = matches.isEmpty() ? -1 : target->row(matches.first());')
    qtSetRow()
    println('} }')
  end
end

func qtInsertItem()
  if(linked('Value'))
    println('item->setData(Qt::UserRole, qt_text(', cstr(d('Value')), ').toInt());')
  end
  println('target->insertItem(row < 0 ? target->count() : row, item);')
  if(get('SelectAdd') == 'True')
    println('target->setCurrentItem(item);')
  end
end

func doInsert(_data)
  if(is_qt_project())
    fvar(text)
    text = '""'
    if(linked('Str'))
      text = cstr(d('Str'))
    end
    println('{ auto *target = ', qtTarget(), '; const int row = qt_text(', Arg(_data), ').toInt();')
    println('if (row >= -1 && row <= target->count()) {')
    println('auto *item = new QListWidgetItem(qt_text(', text, '));')
    qtInsertItem()
    event(onChange)
    println('} }')
  end
end

func doLoad(_data)
  if(is_qt_project())
    println('{ QFile file(qt_text(', cstr(d('FileName')), '));')
    println('if (file.open(QIODevice::ReadOnly)) {')
    println('{ auto *target = ', qtTarget(), ';')
    qtFill('QString::fromUtf8(file.readAll())')
    println('file.close();')
    println('}')
    event(onChange)
    println('} }')
  end
end

func doSave(_data)
  if(is_qt_project())
    println('{ QFile file(qt_text(', cstr(d('FileName')), '));')
    println('if (file.open(QIODevice::WriteOnly)) file.write((', Text(), ').toUtf8()); }')
  end
end

func doAppend(_data)
  if(is_qt_project())
    println('{ QFile file(qt_text(', cstr(d('FileName')), '));')
    println('if (file.open(QIODevice::ReadWrite | QIODevice::Append)) {')
    println('const auto text = (', Text(), ').toUtf8();')
    println('if (!text.isEmpty()) { if (file.size() > 0 && file.seek(file.size() - 1) && file.read(1) != QByteArray(1, char(10))) file.write(QByteArray(1, char(13)) + char(10)); file.write(text); } } }')
  end
end
