func ProgName()
  if(linked('FileName'))
    return(d('FileName'))
  else
    return(cstr(get('FileName')))
  end
end

func ParamsOf()
  if(linked('Params'))
    return(d('Params'))
  else
    return(cstr(get('Param')))
  end
end

func DirOf()
  if(linked('WorkingDir'))
    return(d('WorkingDir'))
  else
    return(cstr(get('WorkingDir')))
  end
end

func LaunchBlock(wait, shell)
  println('std::string hiasm_prg', _id_, ' = std::string(', ProgName(), ');')
  println('std::string hiasm_prm', _id_, ' = std::string(', ParamsOf(), ');')
  println('std::string hiasm_wdir', _id_, ' = std::string(', DirOf(), ');')
  println('int hiasm_rc', _id_, ' = -1;')
  println('if(!hiasm_prg', _id_, '.empty()) {')
  block.inclvl()
  println('hiasm_rc', _id_, ' = ([](const std::string &exe, const std::string &params, const std::string &dir, int wait, int mode, int shell) -> int {')
  block.inclvl()
  println('bool hp = !params.empty();')
  println('bool hd = !dir.empty();')
  println('(void)mode;')
  println('#if defined(_WIN32)')
  println('std::string cmd;')
  println('if(wait && !shell) {')
  block.inclvl()
  println('cmd = std::string("\042") + exe + std::string("\042");')
  println('if(hp) cmd += std::string(" ") + params;')
  block.declvl()
  println('} else {')
  block.inclvl()
  println('cmd = std::string("cmd.exe /c start \042\042");')
  println('if(hd) cmd += std::string(" /D \042") + dir + std::string("\042");')
  println('if(!wait && mode == 2) cmd += std::string(" /Min");')
  println('if(!wait && mode == 3) cmd += std::string(" /Max");')
  println('cmd += std::string(" \042") + exe + std::string("\042");')
  println('if(hp) cmd += std::string(" ") + params;')
  block.declvl()
  println('}')
  println('return std::system(cmd.c_str());')
  println('#else')
  println('std::string cmd;')
  println('if(hd) cmd = std::string("cd \042") + dir + std::string("\042; ");')
  println('if(shell) {')
  block.inclvl()
  println('cmd += std::string("xdg-open \042") + exe + std::string("\042");')
  block.declvl()
  println('} else {')
  block.inclvl()
  println('cmd += std::string("\042") + exe + std::string("\042");')
  println('if(hp) cmd += std::string(" ") + params;')
  println('if(!wait) cmd += std::string(" &");')
  block.declvl()
  println('}')
  println('return std::system(cmd.c_str());')
  println('#endif')
  block.declvl()
  println('})(')
  println('hiasm_prg', _id_, ', hiasm_prm', _id_, ', hiasm_wdir', _id_, ', ', wait, ', ', get('Mode'), ', ', shell, ');')
  block.declvl()
  println('}')
end

func doExec(_data)
  println('{')
  block.inclvl()
  LaunchBlock(get('RunEvent'), 0)
  println('hiasm_int_state(', _id_, ', 0) = hiasm_rc', _id_, ';')
  event(onExec, 'hiasm_int_state(' && _id_ && ')')
  block.declvl()
  println('}')
end

func doShellExec(_data)
  println('{')
  block.inclvl()
  LaunchBlock(0, 1)
  println('hiasm_int_state(', _id_, ', 0) = hiasm_rc', _id_, ';')
  event(onExec, 'hiasm_int_state(' && _id_ && ')')
  block.declvl()
  println('}')
end

func doRunCpl(_data)
  println('{')
  block.inclvl()
  LaunchBlock(0, 1)
  println('hiasm_int_state(', _id_, ', 0) = hiasm_rc', _id_, ';')
  event(onExec, 'hiasm_int_state(' && _id_ && ')')
  block.declvl()
  println('}')
end

func doConsoleExec(_data)
  println('{')
  block.inclvl()
  println('std::string hiasm_prg', _id_, ' = std::string(', ProgName(), ');')
  println('std::string hiasm_prm', _id_, ' = std::string(', ParamsOf(), ');')
  println('std::string hiasm_out', _id_, ';')
  println('int hiasm_rc', _id_, ' = -1;')
  println('if(!hiasm_prg', _id_, '.empty()) {')
  block.inclvl()
  println('std::string hiasm_cmd', _id_, ' = std::string("\042") + hiasm_prg', _id_, ' + std::string("\042");')
  println('if(!hiasm_prm', _id_, '.empty()) hiasm_cmd', _id_, ' += std::string(" ") + hiasm_prm', _id_, ';')
  println('FILE *hiasm_fp', _id_, ' = NULL;')
  println('#if defined(_WIN32)')
  println('hiasm_fp', _id_, ' = _popen(hiasm_cmd', _id_, '.c_str(), "r");')
  println('#else')
  println('hiasm_fp', _id_, ' = popen(hiasm_cmd', _id_, '.c_str(), "r");')
  println('#endif')
  println('if(hiasm_fp', _id_, ') {')
  block.inclvl()
  println('char hiasm_buf', _id_, '[4096];')
  println('while(fgets(hiasm_buf', _id_, ', sizeof(hiasm_buf', _id_, '), hiasm_fp', _id_, ')) hiasm_out', _id_, ' += hiasm_buf', _id_, ';')
  println('#if defined(_WIN32)')
  println('hiasm_rc', _id_, ' = _pclose(hiasm_fp', _id_, ');')
  println('#else')
  println('hiasm_rc', _id_, ' = pclose(hiasm_fp', _id_, ');')
  println('#endif')
  block.declvl()
  println('}')
  block.declvl()
  println('}')
  println('hiasm_str_state(', _id_, ') = hiasm_out', _id_, ';')
  println('hiasm_int_state(', _id_, ', 0) = hiasm_rc', _id_, ';')
  event(onConsoleResult, 'hiasm_str_state(' && _id_ && ')')
  event(onConsoleTerminate, 'hiasm_int_state(' && _id_ && ')')
  block.declvl()
  println('}')
end

func ExitCode()
  return('hiasm_int_state(' && _id_ && ')')
end

func ConsoleResult()
  return('hiasm_str_state(' && _id_ && ')')
end
