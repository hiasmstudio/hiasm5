func Marker()
  return('dynamic_cast<HiasmPlotAxis *>(form.findChild<QObject *>(QStringLiteral("PlotMarker' && _id_ && '")))')
end

func doStart
  println('{ auto *marker = new HiasmPlotAxis(widgetParent);')
  println('marker->setObjectName(QStringLiteral("PlotMarker', _id_, '"));')
  println('marker->marker = true;')
  println('marker->target = qt_text(', cstr(get('qtPlotterTarget')), ');')
  println('marker->horizontalAxis = qt_text(', cstr(get('qtPlotAxisX')), ');')
  println('marker->verticalAxis = qt_text(', cstr(get('qtPlotAxisY')), ');')
  println('marker->origin = QPointF(', get('X'), ', ', get('Y'), ');')
  println('marker->caption = qt_text(', cstr(get('Text')), ');')
  println('marker->pen = QPen(qt_led_color(qt_text(', cstr(get('Color')), '), Qt::red), qMax(0, int(', Size, ')));')
  println('marker->framePen = QPen(qt_led_color(qt_text(', cstr(get('FrameColor')), '), Qt::black));')
  println('const Qt::PenStyle styles[] = {Qt::SolidLine, Qt::DashLine, Qt::DotLine, Qt::DashDotLine, Qt::DashDotDotLine, Qt::NoPen, Qt::SolidLine};')
  println('marker->pen.setStyle(styles[qBound(0, int(', Style, '), 6)]);')
  println('marker->framePen.setStyle(styles[qBound(0, int(', FrameStyle, '), 6)]);')
  println('marker->background = qt_led_color(qt_text(', cstr(get('BgColor')), '), Qt::white);')
  println('marker->filled = ', get('BgStyle') == 0, ';')
  println('marker->horizontalAlign = ', HAlign, '; marker->verticalAlign = ', VAlign, ';')
  println('QWidget fontSource(widgetParent);')
  println('qt_apply_font(&fontSource, qt_text(', cstr(get('Font')), '));')
  println('marker->font = fontSource.font();')
  println('marker->foreground = fontSource.palette().color(fontSource.foregroundRole()); }')
end

func doAxis(_data)
  fvar(x, y)
  x = d('X')
  y = d('Y')
  if(isnull(x))
    x = get('X')
  end
  if(isnull(y))
    y = get('Y')
  end
  println('{ auto *plotMarker', _id_, ' = ', Marker(), ';')
  println('plotMarker', _id_, '->origin = QPointF(qt_plot_value(', x, '), qt_plot_value(', y, '));')
  println('plotMarker', _id_, '->redraw(); }')
  event(onAxis)
end
