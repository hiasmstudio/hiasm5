// Emit once at file scope, after qt_bitmap and HiasmToolBar.
func qtCommandFamilyRuntime
  println('#include <QAction>')
  println('#include <QFrame>')
  println('#include <QMap>')
  println('#include <cmath>')
  println('template<class T> static bool qt_command_nonzero(T value) {')
  println('  if constexpr (std::is_floating_point_v<T>) return std::nearbyint(value) != 0;')
  println('  else return qt_text(value).toLongLong() != 0;')
  println('}')
  println('class HiasmCommandCenter final : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  using Action = std::function<void(const QString &)>;')
  println('  struct Command {')
  println('    QString name, caption;')
  println('    QIcon icon;')
  println('    bool toggle = false, enabled = false, checked = false;')
  println('    QList<QPointer<QAction>> actions;')
  println('    void apply(bool available) {')
  println('      actions.removeIf([](const auto &action) { return action.isNull(); });')
  println('      for (const auto &action : actions) {')
  println('        const QSignalBlocker quiet(action.data());')
  println('        action->setCheckable(toggle || checked);')
  println('        action->setChecked(checked);')
  println('        action->setEnabled(available);')
  println('      }')
  println('      // QToolButton and QMenu observe ActionChanged events from QAction.')
  println('    }')
  println('  };')
  println('  struct Monitor { QPointer<QObject> owner; std::function<void()> refresh; };')
  println('  QMap<QString, Command> commands;')
  println('  QList<Monitor> monitors;')
  println('  Action onAction;')
  println('  std::function<void()> onRefresh;')
  println('  void load(const QString &source) {')
  println('    // Array<Icon> serialized as [quoted name=bracketed icon, ...].')
  println('    static const QRegularExpression entry(QStringLiteral("%1([^%1]*)%1=([[][^]]*[]])").arg(QChar(39)));')
  println('    for (auto entries = entry.globalMatch(source); entries.hasNext();) {')
  println('      const auto item = entries.next();')
  println('      const auto definition = item.captured(1);')
  println('      const auto equals = definition.indexOf(QChar(61));')
  println('      const auto caption = equals < 0 ? definition : definition.mid(equals + 1);')
  println('      auto name = equals > 0 ? definition.left(equals) : caption;')
  println('      const bool toggle = name.startsWith(QChar(94));')
  println('      if (toggle) name.remove(0, 1);')
  println('      if (name.isEmpty() || commands.contains(name.toCaseFolded())) continue;')
  println('      const auto payload = item.captured(2);')
  println('      const auto image = payload == QStringLiteral("[]") ? QImage() : qt_bitmap(payload, "ico");')
  println('      commands.insert(name.toCaseFolded(), {name, caption, image.isNull() ? QIcon() : QIcon(QPixmap::fromImage(image)), toggle});')
  println('    }')
  println('  }')
  println('  Command *find(const QString &name) {')
  println('    const auto it = commands.find(name.toCaseFolded());')
  println('    return it == commands.end() ? nullptr : &it.value();')
  println('  }')
  println('  void state(const QString &name, bool enabled, bool checked) {')
  println('    if (auto *command = find(name)) {')
  println('      command->enabled = enabled;')
  println('      command->checked = checked;')
  println('    }')
  println('  }')
  println('  void refresh() {')
  println('    const QPointer<HiasmCommandCenter> alive(this);')
  println('    for (auto &command : commands) command.enabled = command.checked = false;')
  println('    monitors.removeIf([](const auto &monitor) { return monitor.owner.isNull(); });')
  println('    const auto currentMonitors = monitors;')
  println('    for (const auto &monitor : currentMonitors) {')
  println('      if (monitor.owner && monitor.refresh) monitor.refresh();')
  println('      if (!alive) return;')
  println('    }')
  println('    const auto refreshEvent = onRefresh;')
  println('    if (refreshEvent) refreshEvent();')
  println('    if (!alive) return;')
  println('    for (auto &command : commands) command.apply(command.enabled);')
  println('  }')
  println('  void bind(QAction *action, Command &command, const Action &localAction) {')
  println('    action->setCheckable(command.toggle);')
  println('    command.actions.append(QPointer<QAction>(action));')
  println('    connect(action, &QAction::triggered, this, [this, action, &command, localAction](bool checked) {')
  println('      const QPointer<HiasmCommandCenter> alive(this);')
  println('      const auto name = command.name;')
  println('      // Undo the native auto-toggle before running scheme events.')
  println('      if (action->isCheckable()) {')
  println('        const QSignalBlocker quiet(action);')
  println('        action->setChecked(!checked);')
  println('      }')
  println('      if (localAction) localAction(name);')
  println('      if (!alive) return;')
  println('      const auto centerAction = onAction;')
  println('      if (centerAction) centerAction(name);')
  println('      if (!alive) return;')
  println('      if (command.toggle) {')
  println('        command.checked = !command.checked;')
  println('        command.apply(true);')
  println('      }')
  println('    });')
  println('  }')
  println('  static QStringList lines(QString source) {')
  println('    source.remove(QChar(13));')
  println('    return source.split(QChar(10), Qt::SkipEmptyParts);')
  println('  }')
  println('  void buildMenu(QMenu &root, const QStringList &entries, qsizetype &index, const Action &localAction, bool nested = false) {')
  println('    QList<QMenu *> parents{&root};')
  println('    while (index < entries.size()) {')
  println('      const auto name = entries.at(index++);')
  println('      auto *menu = parents.constLast();')
  println('      if (name == QStringLiteral(")")) {')
  println('        if (parents.size() > 1) parents.removeLast();')
  println('        else if (nested) return;')
  println('      } else if (name == QStringLiteral("-")) {')
  println('        menu->addSeparator();')
  println('      } else if (name != QStringLiteral("(")) {')
  println('        auto *command = find(name);')
  println('        const auto caption = command ? command->caption : name;')
  println('        const auto icon = command ? command->icon : QIcon();')
  println('        if (entries.value(index) == QStringLiteral("(")) {')
  println('          ++index;')
  println('          auto *submenu = menu->addMenu(icon, caption);')
  println('          if (command) bind(submenu->menuAction(), *command, localAction);')
  println('          parents.append(submenu);')
  println('        } else {')
  println('          auto *action = menu->addAction(icon, caption);')
  println('          if (command) bind(action, *command, localAction);')
  println('          else action->setEnabled(false);')
  println('        }')
  println('      }')
  println('    }')
  println('  }')
  println('  void buildToolbar(HiasmToolBar &toolbar, const QString &source, const Action &localAction) {')
  println('    const auto entries = lines(source);')
  println('    for (qsizetype index = 0; index < entries.size();) {')
  println('      const auto name = entries.at(index++);')
  println('      if (name == QStringLiteral("-")) {')
  println('        auto *line = new QFrame(&toolbar);')
  println('        line->setFrameShape(QFrame::VLine);')
  println('        line->setFixedSize(6, 22);')
  println('        toolbar.items.append(line);')
  println('        line->show();')
  println('        continue;')
  println('      }')
  println('      auto *command = find(name);')
  println('      const bool dropdown = entries.value(index) == QStringLiteral("(");')
  println('      if (!command) {')
  println('        if (dropdown) {')
  println('          ++index;')
  println('          for (int depth = 1; index < entries.size() && depth;) {')
  println('            const auto token = entries.at(index++);')
  println('            if (token == QStringLiteral("(")) ++depth;')
  println('            else if (token == QStringLiteral(")")) --depth;')
  println('          }')
  println('        }')
  println('        continue;')
  println('      }')
  println('      auto *button = new QToolButton(&toolbar);')
  println('      auto *action = new QAction(command->icon, command->caption, button);')
  println('      action->setToolTip(command->caption);')
  println('      bind(action, *command, localAction);')
  println('      button->setDefaultAction(action);')
  println('      button->setAutoRaise(toolbar.flat);')
  println('      button->setToolButtonStyle(command->icon.isNull() ? Qt::ToolButtonTextOnly : Qt::ToolButtonIconOnly);')
  println('      if (dropdown) {')
  println('        ++index;')
  println('        auto *menu = new QMenu(button);')
  println('        buildMenu(*menu, entries, index, localAction, true);')
  println('        button->setMenu(menu);')
  println('        button->setPopupMode(QToolButton::MenuButtonPopup);')
  println('      }')
  println('      toolbar.items.append(button);')
  println('      button->show();')
  println('    }')
  println('    toolbar.load(QString()); // Reflow the existing items, including the appended command buttons.')
  println('  }')
  println('};')
  println('class HiasmCommandBindings final : public QObject {')
  println('public:')
  println('  using QObject::QObject;')
  println('  QList<std::function<void()>> pending;')
  println('  static HiasmCommandBindings *get(QWidget &form) {')
  println('    const auto name = QStringLiteral("qtCommandBindings");')
  println('    if (auto *object = form.findChild<QObject *>(name, Qt::FindDirectChildrenOnly))')
  println('      return static_cast<HiasmCommandBindings *>(object);')
  println('    auto *bindings = new HiasmCommandBindings(&form);')
  println('    bindings->setObjectName(name);')
  println('    return bindings;')
  println('  }')
  println('};')
  println('static void qt_command_bind(QWidget &form) {')
  println('  const auto name = QStringLiteral("qtCommandBindings");')
  println('  auto *bindings = static_cast<HiasmCommandBindings *>(form.findChild<QObject *>(name, Qt::FindDirectChildrenOnly));')
  println('  if (!bindings) return;')
  println('  QList<std::function<void()>> pending;')
  println('  pending.swap(bindings->pending);')
  println('  for (const auto &bind : pending) bind();')
  println('}')
  println('static HiasmCommandCenter *qt_command_center(QWidget &form, const QString &name) {')
  println('  return name.isEmpty() ? nullptr : dynamic_cast<HiasmCommandCenter *>(form.findChild<QObject *>(name));')
  println('}')
end

func QtCommandCenterTarget()
  return('qt_command_center(form, qt_text(' && cstr(get('qtCommandCenter')) && '))')
end

func QtCommandMonitor(owner)
  println('center->monitors.append({', owner, ', [&form] {')
  event(onRefresh)
  println('}});')
end

func QtCommandAction()
  println('const HiasmCommandCenter::Action localAction = [&form](const QString &commandName', _id_, ') {')
  event(onAction, 'commandName' && _id_)
  println('};')
end
