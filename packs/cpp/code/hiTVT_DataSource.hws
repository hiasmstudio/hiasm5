include('qtTVT')

func TVSource()
  return('dynamic_cast<HiasmStaticData *>(form.findChild<QObject *>(qt_text(' && cstr(get('qtDataSource')) && ')))')
end

func doLoad(_data)
  println('{ auto *source = ', TVSource(), '; auto *tree = ', TVTree(), ';')
  println('if (tree) tree->clearTrain();')
  println('if (!tree || !source || !source->beginRead()) {')
  event(onError, 'QStringLiteral("Tree or data source unavailable")')
  println('} else {')
  println('const auto columns = qt_tvt_columns(*source, qt_text(', cstr(get('Columns')), '));')
  println('const auto records = source->rows; source->endRead();')
  println('if (columns.isEmpty()) {')
  event(onError, 'QStringLiteral("Invalid tree columns")')
  println('} else {')
  println('for (const auto &record : records) {')
  println('  QVariantList row; for (int column : columns) row.append(qt_tvt_cell(record.value(column)));')
  println('  if (!tree->add(row)) {')
  event(onError, '1000')
  println('  }')
  println('}')
  event(onLoad)
  println('} } }')
end

func doSave(_data)
  println('{ auto *source = ', TVSource(), '; auto *tree = ', TVTree(), ';')
  println('const auto columns = source ? qt_tvt_columns(*source, qt_text(', cstr(get('Columns')), ')) : QList<int>();')
  println('if (!source || !tree || source->reading || source->open || columns.isEmpty()) {')
  event(onError, 'QStringLiteral("Tree or writable data source unavailable, or invalid columns")')
  println('} else {')
  println('QList<QStringList> records; bool valid = true;')
  println('for (const auto &row : tree->enumerate()) {')
  println('  if (row.size() != columns.size()) { valid = false; break; }')
  println('  QStringList record; record.resize(source->columns.size());')
  println('  for (qsizetype i = 0; i < columns.size(); ++i) record[columns.at(i)] = row.at(i).toString();')
  println('  records.append(record);')
  println('}')
  println('if (valid) source->rows = std::move(records); else {')
  event(onError, 'QStringLiteral("Tree tuple size does not match the configured columns")')
  println('} } }')
end
