func doStart
  block.reg("result")
  block.select("result")
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#endif')
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  println('')
  println('int main(int argc, char **argv)')
  println('{')
  block.inclvl()
  println('  (void)argc;')
  println('  (void)argv;')
  println('  std::printf(', Title, ');')
  println('  std::printf("\\n");')
  event(onStart)
  println('  return 0;')
  block.declvl()
  println('}')
end
