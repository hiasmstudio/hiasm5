func doStart
  block.reg("result")
  block.select("result")
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#endif')
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  if(TargetPlatform > 1)
    println('#error "WinDll is a Windows-only project type; select the Windows target"')
  end
  println('#include <windows.h>')
  println('')
  println('extern "C" __declspec(dllexport) int hiasm_run(void)')
  println('{')
  block.inclvl()
  event(onStart)
  println('  return 0;')
  block.declvl()
  println('}')
  println('')
  println('BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved)')
  println('{')
  println('  (void)reserved;')
  println('  if(reason == DLL_PROCESS_ATTACH) DisableThreadLibraryCalls(instance);')
  println('  return TRUE;')
  println('}')
end
