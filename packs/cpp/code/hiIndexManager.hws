func IndexTarget()
  return('static_cast<HiasmIndexManager *>(form.findChild<QObject *>(QStringLiteral("IndexManager' && _id_ && '")))')
end

func doStart
  println('{')
  println('auto *manager = new HiasmIndexManager(&form);')
  println('manager->setObjectName(QStringLiteral("IndexManager', _id_, '"));')
  println('manager->load(qt_text(', cstr(get('Index')), '));')
  println('}')
end

func doDelete(_data)
  if(len(_data) > 0)
    println(IndexTarget(), '->remove(qt_text(', _data, ').toInt());')
  else
    println(IndexTarget(), '->remove(0);')
  end
end

func doClear(_data)
  println('{ auto *manager = ', IndexTarget(), '; manager->indexes.clear(); manager->refresh(); }')
end

func Indexes()
  return(IndexTarget() && '->indexes')
end
