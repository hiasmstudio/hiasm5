func doStart
  block.reg("result")
  block.select("result")
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#else')
  println('#include <unistd.h>')
  println('#include <sys/types.h>')
  println('#endif')
  println('')
  println('static int hiasm_daemon_body(void)')
  println('{')
  block.inclvl()
  event(onStart)
  println('  return 0;')
  block.declvl()
  println('}')
  println('')
  println('#if defined(_WIN32)')
  println('int WINAPI WinMain(HINSTANCE instance, HINSTANCE previous, LPSTR command, int show)')
  println('{')
  println('  (void)instance; (void)previous; (void)command; (void)show;')
  println('  return hiasm_daemon_body();')
  println('}')
  println('#else')
  println('int main(void)')
  println('{')
  println('  pid_t pid = fork();')
  println('  if(pid < 0) return 1;')
  println('  if(pid > 0) return 0;')
  println('  setsid();')
  println('  pid = fork();')
  println('  if(pid < 0) return 1;')
  println('  if(pid > 0) return 0;')
  println('  return hiasm_daemon_body();')
  println('}')
  println('#endif')
end
