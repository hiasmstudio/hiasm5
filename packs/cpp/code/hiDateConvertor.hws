// DateConvertor: Real = KOL date (days since 0001-01-01, 1 = 0001-01-01),
// VCL = TDateTime (days since 1899-12-30) = Real - 693594, Unix = seconds since 1970.
// Format picture tokens: d(dd,ddd,dddd) M(MM,MMM,MMMM) y(yy,yyyy) gg h(hh) H(HH) m(mm) s(ss) t(tt).
// Month/weekday/AM-PM names are English for cross-platform determinism.

func DataExpr(value)
  if(linked('Data'))
    return(d('Data'))
  end
  return(value)
end

func NumOf(expr)
  return('std::atoi(hiasm_text(' && expr && ').c_str())')
end

func RealOf(expr)
  return('std::atof(hiasm_text(' && expr && ').c_str())')
end

func FieldOf(name)
  if(linked(name))
    return(NumOf(d(name)))
  end
  return('0')
end

func SplitLambda()
  return('[](double kol, long long *o) { for(int i = 0; i < 7; ++i) o[i] = 0; if(kol <= 0) return; long long dd = (long long)kol; long long ms = (long long)((kol - (double)dd) * 86400000.0 + 0.5); long long z = dd - 719163 + 719468; long long era = (z >= 0 ? z : z - 146096) / 146097; unsigned doe = (unsigned)(z - era * 146097); unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; long long y = (long long)yoe + era * 400; unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100); unsigned mp = (5 * doy + 2) / 153; unsigned dn = doy - (153 * mp + 2) / 5 + 1; unsigned mn = mp < 10 ? mp + 3 : mp - 9; if(mn <= 2) ++y; o[0] = y; o[1] = mn; o[2] = dn; o[3] = (ms / 3600000) % 24; o[4] = (ms / 60000) % 60; o[5] = (ms / 1000) % 60; o[6] = ms % 1000; }')
end

func JoinLambda()
  return('[](long long y, long long m, long long d, long long hh, long long mi, long long ss, long long ms) -> double { if(y > 9999 || m < 1 || m > 12 || hh > 23 || mi > 59 || ss > 59 || ms > 999) return 0.0; int ml = (m == 2) ? (((y % 4 == 0 && (y % 100 != 0)) || y % 400 == 0) ? 29 : 28) : ((m == 4 || m == 6 || m == 9 || m == 11) ? 30 : 31); if(d < 1 || d > ml) return 0.0; long long yy = y - (m <= 2 ? 1 : 0); long long era = (yy >= 0 ? yy : yy - 399) / 400; unsigned yoe = (unsigned)(yy - era * 400); unsigned doy = (153 * (unsigned)(m + (m > 2 ? -3 : 9)) + 2) / 5 + (unsigned)(d - 1); unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy; long long days = era * 146097 + (long long)doe - 719468; return (double)(days + 719163) + (hh * 3600000.0 + mi * 60000.0 + ss * 1000.0 + ms) / 86400000.0; }')
end

func FmtLambda()
  return('[](const std::string &fmt, double kol) -> std::string { long long o[7]; for(int i = 0; i < 7; ++i) o[i] = 0; long long dw = 0; if(kol > 0) { long long dd = (long long)kol; long long ms = (long long)((kol - (double)dd) * 86400000.0 + 0.5); long long z = dd - 719163 + 719468; long long era = (z >= 0 ? z : z - 146096) / 146097; unsigned doe = (unsigned)(z - era * 146097); unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; long long y = (long long)yoe + era * 400; unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100); unsigned mp = (5 * doy + 2) / 153; unsigned dn = doy - (153 * mp + 2) / 5 + 1; unsigned mn = mp < 10 ? mp + 3 : mp - 9; if(mn <= 2) ++y; o[0] = y; o[1] = mn; o[2] = dn; o[3] = (ms / 3600000) % 24; o[4] = (ms / 60000) % 60; o[5] = (ms / 1000) % 60; o[6] = ms % 1000; dw = ((dd + 6) % 7 + 7) % 7 + 1; } static const char *MON[12] = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}; static const char *DOW[7] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}; std::string out; int i = 0; while(i < (int)fmt.size()) { char c = fmt[i]; if(c == 39) { if(i + 1 < (int)fmt.size() && fmt[i + 1] == 39) { out += (char)39; i += 2; continue; } int j = i + 1; while(j < (int)fmt.size() && fmt[j] != 39) ++j; out += fmt.substr(i + 1, j - i - 1); i = j + 1; continue; } if(c != 100 && c != 77 && c != 121 && c != 104 && c != 72 && c != 109 && c != 115 && c != 103 && c != 116) { out += c; ++i; continue; } int j = i; while(j < (int)fmt.size() && fmt[j] == c) ++j; int n = j - i; std::string rep; if(c == 100) { if(n == 1) rep = std::to_string(o[2]); else if(n == 2) rep = (o[2] < 10 ? "0" : "") + std::to_string(o[2]); else rep = n == 3 ? std::string(DOW[dw % 7]).substr(0, 3) : std::string(DOW[dw % 7]); } else if(c == 77) { if(n == 1) rep = std::to_string(o[1]); else if(n == 2) rep = (o[1] < 10 ? "0" : "") + std::to_string(o[1]); else rep = n == 3 ? std::string(MON[o[1] - 1]).substr(0, 3) : std::string(MON[o[1] - 1]); } else if(c == 121) { if(n >= 4 || n == 3) rep = std::to_string(o[0]); else if(n == 2) rep = (o[0] % 100 < 10 ? "0" : "") + std::to_string(o[0] % 100); else rep = std::to_string(o[0] % 100); } else if(c == 104) { long long h12 = o[3] % 12; if(h12 == 0) h12 = 12; rep = n == 1 ? std::to_string(h12) : (h12 < 10 ? "0" : "") + std::to_string(h12); } else if(c == 72) { rep = n == 1 ? std::to_string(o[3]) : (o[3] < 10 ? "0" : "") + std::to_string(o[3]); } else if(c == 109) { rep = n == 1 ? std::to_string(o[4]) : (o[4] < 10 ? "0" : "") + std::to_string(o[4]); } else if(c == 115) { rep = n == 1 ? std::to_string(o[5]) : (o[5] < 10 ? "0" : "") + std::to_string(o[5]); } else if(c == 103) { rep = o[0] <= 0 ? "B.C." : "A.D."; } else { rep = o[3] < 12 ? (n == 1 ? "A" : "AM") : (n == 1 ? "P" : "PM"); } out += rep; i = j; } return out; }')
end

func ParseLambda()
  return('[](const std::string &fmt, const std::string &s) -> double { long long y = 0, mo = 0, d = 0, hh = 0, mi = 0, ss = 0; bool h12 = false, pm = false; std::size_t fi = 0, si = 0; auto getnum = [&](int maxn) -> long long { long long v = 0; int n = 0; while(si < s.size() && n != maxn && s[si] >= 48 && s[si] <= 57) { v = v * 10 + (s[si] - 48); ++si; ++n; } return v; }; auto pivot = [&](long long v) -> long long { std::time_t now = std::time(nullptr); std::tm *t = std::gmtime(&now); int ny = t ? t->tm_year + 1900 : 2026; bool old = v < 50; v += ny - ny % 100; if(old) v -= 100; return v; }; auto match_name = [&](const char **names, int count, bool full) -> int { for(int k = 0; k < count; ++k) { std::string nm = full ? std::string(names[k]) : std::string(names[k]).substr(0, 3); if(si + nm.size() <= s.size()) { bool eq = true; for(std::size_t q = 0; q < nm.size(); ++q) { char a = nm[q], b = s[si + q]; if(a >= 65 && a <= 90) a += 32; if(b >= 65 && b <= 90) b += 32; if(a != b) { eq = false; break; } } if(eq) { si += nm.size(); return k; } } } return -1; }; static const char *MON[12] = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}; static const char *DOW[7] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}; while(fi < fmt.size() && si < s.size()) { char c = fmt[fi]; bool dig = s[si] >= 48 && s[si] <= 57; bool alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122); if(alpha && dig) { std::size_t j = fi; while(j < fmt.size() && fmt[j] == c) ++j; int n = (int)(j - fi); if(c == 121 || c == 89) { if(n >= 4) y = getnum(4); else if(n == 2) y = pivot(getnum(2)); else y = pivot(getnum(-1)); } else if(c == 100 || c == 68) d = getnum(2); else if(c == 77) mo = getnum(2); else if(c == 72) hh = getnum(2); else if(c == 104) { hh = getnum(2); h12 = true; } else if(c == 109) mi = getnum(2); else if(c == 115) ss = getnum(2); fi = j; } else if(c == 77 || c == 109) { std::size_t j = fi; while(j < fmt.size() && fmt[j] == c) ++j; int n = (int)(j - fi); if(n >= 3) { int k = match_name(MON, 12, n >= 4); mo = k >= 0 ? k + 1 : 1; } fi = j; } else if(c == 100 || c == 68) { std::size_t j = fi; while(j < fmt.size() && fmt[j] == c) ++j; int n = (int)(j - fi); if(n >= 3) match_name(DOW, 7, n >= 4); fi = j; } else if(c == 116 || c == 84) { std::size_t j = fi; while(j < fmt.size() && fmt[j] == c) ++j; int n = (int)(j - fi); static const char *MARK[2] = {"AM", "PM"}; int k = match_name(MARK, 2, n >= 2 || (n == 1 && true)); if(k == 1) pm = true; fi = j; } else { if(c == s[si]) ++fi; ++si; } } if(h12 && pm) hh += 12; if(mo < 1) mo = 1; long long yy = y - (mo <= 2 ? 1 : 0); long long era = (yy >= 0 ? yy : yy - 399) / 400; unsigned yoe = (unsigned)(yy - era * 400); unsigned doy = (153 * (unsigned)(mo + (mo > 2 ? -3 : 9)) + 2) / 5 + (unsigned)(d - 1); unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy; long long days = era * 146097 + (long long)doe - 719468; if(y > 9999 || y < 0 || hh > 23 || mi > 59 || ss > 59) return 0.0; int ml = (mo == 2) ? (((y % 4 == 0 && (y % 100 != 0)) || y % 400 == 0) ? 29 : 28) : ((mo == 4 || mo == 6 || mo == 9 || mo == 11) ? 30 : 31); if(d < 1 || d > ml) return 0.0; return (double)(days + 719163); }')
end

func StoreST(arr)
  println('hiasm_int_state(', _id_, ' * 100 + 1, 0) = static_cast<int>(', arr, '[0]);')
  println('hiasm_int_state(', _id_, ' * 100 + 2, 0) = static_cast<int>(', arr, '[1]);')
  println('hiasm_int_state(', _id_, ' * 100 + 3, 0) = static_cast<int>(', arr, '[2]);')
  println('hiasm_int_state(', _id_, ' * 100 + 4, 0) = static_cast<int>(', arr, '[3]);')
  println('hiasm_int_state(', _id_, ' * 100 + 5, 0) = static_cast<int>(', arr, '[4]);')
  println('hiasm_int_state(', _id_, ' * 100 + 6, 0) = static_cast<int>(', arr, '[5]);')
  println('hiasm_int_state(', _id_, ' * 100 + 7, 0) = static_cast<int>(', arr, '[6]);')
  println('hiasm_int_state(', _id_, ' * 100 + 8, 0) = static_cast<int>(((', _id_, ' == 0 ? 0 : (static_cast<long long>(hiasm_kol', _id_, ') + 6) % 7 + 7) % 7 + 1));')
  println('hiasm_int_state(', _id_, ' * 100 + 9, 0) = ((', arr, '[0] % 4 == 0 && (', arr, '[0] % 100 != 0 || ', arr, '[0] % 400 == 0)) ? 1 : 0);')
end

func ResultReal(expr)
  return('([](double v) { char b[64]; std::snprintf(b, sizeof(b), "%g", v); return std::string(b); }(' && expr && '))')
end

func doConvert(_data)
  println('{')
  block.inclvl()
  fvar(kol, parse)
  switch(get('Mode'))
    case 0:
      kol = RealOf(DataExpr(_data))
      println('const double hiasm_kol', _id_, ' = ', kol, ';')
      println('if(hiasm_kol', _id_, ' <= 202751589.0) {')
      block.inclvl()
      println('long long hiasm_st', _id_, '[7];')
      println(SplitLambda(), '(hiasm_kol', _id_, ', hiasm_st', _id_, ');')
      StoreST('hiasm_st' && _id_)
      println('hiasm_str_state(', _id_, ' * 100) = std::string();')
      event(onResult, 'hiasm_str_state(' && _id_ && ' * 100)')
      block.declvl()
      println('}')
    case 1:
      println('long long hiasm_st', _id_, '[7] = {', FieldOf('DYear'), ', ', FieldOf('DMonth'), ', ', FieldOf('DDay'), ', ', FieldOf('DHour'), ', ', FieldOf('DMinute'), ', ', FieldOf('DSecond'), ', ', FieldOf('DMilliseconds'), '};')
      println('const double hiasm_kol', _id_, ' = ', JoinLambda(), '(', 'hiasm_st', _id_, '[0], hiasm_st', _id_, '[1], hiasm_st', _id_, '[2], hiasm_st', _id_, '[3], hiasm_st', _id_, '[4], hiasm_st', _id_, '[5], hiasm_st', _id_, '[6]);')
      parse = 'hiasm_kol' && _id_
      println('hiasm_str_state(', _id_, ' * 100) = ', ResultReal(parse), ';')
      event(onResult, 'hiasm_str_state(' && _id_ && ' * 100)')
    case 2:
      kol = RealOf(DataExpr(_data)) && ' + 693594.0'
      println('const double hiasm_kol', _id_, ' = ', kol, ';')
      println('if(hiasm_kol', _id_, ' <= 202751589.0) {')
      block.inclvl()
