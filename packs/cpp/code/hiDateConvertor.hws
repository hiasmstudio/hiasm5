    default:
      println('hiasm_str_state(', _id_, ' * 100) = std::to_string((long long)llround((', RealOf(DataExpr(_data)), ' - 693594.0 - 25569.0) * 86400.0));')
      event(onResult, 'hiasm_str_state(' && _id_ && ' * 100)')
  end
  block.declvl()
  println('}')
end

func Result()
  return('hiasm_str_state(' && _id_ && ' * 100)')
end

