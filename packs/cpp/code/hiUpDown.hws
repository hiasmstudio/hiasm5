func doStart
  println('{')
  println('auto *spin = new QSpinBox(widgetParent);')
  println('spin->setObjectName(QStringLiteral("UpDown', _id_, '"));')
  println('spin->setGeometry(', Left, ', ', Top, ', ', Width, ', ', Height, ');')
  println('spin->setRange(', Min, ', ', Max, ');')
  println('spin->setSingleStep(qMax(1, int(', Step, ')));')
  println('spin->setValue(', Position, ');')
  if(linked(onPosition))
    println('QObject::connect(spin, &QSpinBox::valueChanged, &form, [&form](int value) {')
    event(onPosition, 'value')
    println('});')
  end
  println('}')
end

func Position()
  return('qt_widget<QSpinBox>(form, "UpDown' && _id_ && '")->value()')
end

func doPosition(_data)
  println('qt_widget<QSpinBox>(form, "UpDown', _id_, '")->setValue(', Number(_data), ');')
end

func doMin(_data)
  println('qt_widget<QSpinBox>(form, "UpDown', _id_, '")->setMinimum(', Number(_data), ');')
end

func doMax(_data)
  println('qt_widget<QSpinBox>(form, "UpDown', _id_, '")->setMaximum(', Number(_data), ');')
end

func doStep(_data)
  println('qt_widget<QSpinBox>(form, "UpDown', _id_, '")->setSingleStep(qMax(1, ', Number(_data), '));')
end

func Number(value)
  if(len(value) > 0)
    return('qt_text(' && value && ').toInt()')
  end
  return('0')
end
