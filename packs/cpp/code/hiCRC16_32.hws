func Data(value)
  if(linked('Data'))
    return(d('Data'))
  end
  if(len(value) > 0)
    return(value)
  end
  return('""')
end

func HexData()
  if(get('Type') == 1)
    return(1)
  else
    return(0)
  end
end

func MetodParam(poly, init, fin)
  if(get('Metod') == 0)
    return('0xA001, ' && init && ', ' && fin && ', 1')
  else
    if(get('Metod') == 1)
      return('0x8408, ' && init && ', ' && fin && ', 1')
    else
      if(get('Metod') == 2)
        return('0xA6BC, ' && init && ', ' && fin && ', 1')
      else
        if(get('Metod') == 3)
          return('0x1021, ' && init && ', ' && fin && ', 0')
        else
          if(get('Metod') == 4)
            return('0xEDB88320, ' && init && ', ' && fin && ', 1')
          else
            return('0xA001, ' && init && ', ' && fin && ', 1')
          end
        end
      end
    end
  end
end

func doCalcCRC(_data)
  fvar(poly, init, fin, refl)
  if(get('Metod') == 4)
    init = '0xFFFFFFFF'
    fin = '0xFFFFFFFF'
  else
    if(get('Metod') == 3)
      init = '0xFFFF'
      fin = '0x0000'
    else
      init = '0x0000'
      fin = '0x0000'
    end
  end
  fvar(revert)
  if(get('Revert') == 'True')
    revert = 1
  else
    revert = 0
  end
  println('hiasm_ll_state(', _id_, ') = hiasm_crc(std::string(', Data(_data), '), ', MetodParam(poly, init, fin), ', ', HexData(), ');')
  if(get('Metod') != 4)
    if(revert == 1)
      println('hiasm_ll_state(', _id_, ') = ((hiasm_ll_state(', _id_, ') & 0xFF) << 8) | ((hiasm_ll_state(', _id_, ') >> 8) & 0xFF);')
    end
  end
  event(onResult, 'hiasm_text(hiasm_ll_state(' && _id_ && '))')
end
