func doDiff(_data)
  println('{')
  println('const auto series = [&form](const char *name) -> HiasmPlotLines * {')
  println('  return *name ? dynamic_cast<HiasmPlotLines *>(form.findChild<QObject *>(qt_text(name))) : nullptr;')
  println('};')
  println('auto *left = series(', cstr(get('qtPlotFirst')), ');')
  println('auto *right = series(', cstr(get('qtPlotSecond')), ');')
  println('auto *result = series(', cstr(get('qtPlotResult')), ');')
  println('if (left && right && result) {')
  println('  const auto leftPoints = left->points, rightPoints = right->points;')
  println('  result->clear();')
  println('  for (qsizetype i = 0; i < qMin(leftPoints.size(), rightPoints.size()); ++i) {')
  println('    const double first = leftPoints[i].y(), second = rightPoints[i].y();')
  println('    result->add(', code(get('qtPlotExpression')), ', leftPoints[i].x());')
  println('  }')
  event(onDiff)
  println('} }')
end
