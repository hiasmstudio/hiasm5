func doStart
  block.reg("result")
  block.select("result")
  println('#if defined(_WIN32)')
  println('#include <windows.h>')
  println('#endif')
  println('#include <string>')
  println('#include <vector>')
  println('#include <cmath>')
  println('#include <cctype>')
  println('#include <algorithm>')
  println('#include <cstdio>')
  println('#include <cstdlib>')

  if(TargetPlatform > 1)
    println('#error "WinService is a Windows-only project type; select the Windows target"')
  end
  println('#include <windows.h>')
  println('')
  println('static const char *hiasm_service_name = ', ServiceName, ';')
  println('static SERVICE_STATUS_HANDLE hiasm_service_handle = NULL;')
  println('static SERVICE_STATUS hiasm_service_status = {};')
  println('')
  println('static void hiasm_report(DWORD state)')
  println('{')
  println('  hiasm_service_status.dwServiceType = SERVICE_WIN32_OWN_PROCESS;')
  println('  hiasm_service_status.dwCurrentState = state;')
  println('  hiasm_service_status.dwControlsAccepted = state == SERVICE_RUNNING ? SERVICE_ACCEPT_STOP : 0;')
  println('  hiasm_service_status.dwWin32ExitCode = NO_ERROR;')
  println('  hiasm_service_status.dwCheckPoint = 0;')
  println('  hiasm_service_status.dwWaitHint = state == SERVICE_RUNNING ? 0 : 3000;')
  println('  if(hiasm_service_handle) SetServiceStatus(hiasm_service_handle, &hiasm_service_status);')
  println('}')
  println('')
  println('static void WINAPI hiasm_service_control(DWORD control)')
  println('{')
  println('  if(control == SERVICE_CONTROL_STOP) hiasm_report(SERVICE_STOP_PENDING);')
  println('}')
  println('')
  println('static void WINAPI hiasm_service_main(DWORD argc, LPSTR *argv)')
  println('{')
  println('  (void)argc; (void)argv;')
  println('  hiasm_service_handle = RegisterServiceCtrlHandlerA(hiasm_service_name, hiasm_service_control);')
  println('  if(!hiasm_service_handle) return;')
  println('  hiasm_report(SERVICE_START_PENDING);')
  println('  hiasm_report(SERVICE_RUNNING);')
  block.inclvl()
  event(onStart)
  block.declvl()
  println('  hiasm_report(SERVICE_STOPPED);')
  println('}')
  println('')
  println('int WINAPI WinMain(HINSTANCE instance, HINSTANCE previous, LPSTR command, int show)')
  println('{')
  println('  (void)instance; (void)previous; (void)command; (void)show;')
  println('  SERVICE_TABLE_ENTRYA table[] = {')
  println('    { const_cast<LPSTR>(hiasm_service_name), hiasm_service_main },')
  println('    { NULL, NULL }')
  println('  };')
  println('  if(!StartServiceCtrlDispatcherA(table)) return 1;')
  println('  return 0;')
  println('}')
end
