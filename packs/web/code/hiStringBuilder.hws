func doBuild(_data):php,java,html
  fvar(s, r, p, pname, i, t)
  
  if(issec("php") or issec("java"))
    r = '""'
  end
  s = Mask
  i = pos(s, '%')
  while(i >= 0)
    p = copy(s,0,i) 
    if(p)
      r &= p
    end 
    s = delete(s,1,i + 1)
    t = pos(s, '%')
    if(t < 0)
      error("Unclosed placeholder in Mask")
      return()
    end
    pname = copy(s,0,t)
    if(not cgt.get_point_id(pname))
      error("Точка "  + pname + " не найдена")
    end
    r &= point(pname)
    s = delete(s,1,t + 1)
    i = pos(s, '%')
  end
  if(s)
    r &= s
  end

  if(linked(Result))
    println('$str' && _id_, ' = ', r, ';')
    event(onBuild, '$str' && _id_)
  else
    event(onBuild, r)
  end
end

func Result():php,java,html
  return('$str' && _id_)
end

