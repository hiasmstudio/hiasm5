{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "HiAsm: build Qt Debug",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/build_qt_windows.ps1",
                "-Configuration",
                "Debug",
                "-SkipTests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "HiAsm: build Qt Release",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/build_qt_windows.ps1",
                "-Configuration",
                "Release",
                "-SkipTests"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": "build"
        },
        {
            "label": "HiAsm: run Qt Debug",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "tools\\build_windows_run-debug.bat",
                "qt"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
