{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HiAsm: Debug GTK4",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Windows_MinGW-x64-GTK4-Debug/hiasm.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Windows_MinGW-x64-GTK4-Debug",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;C:/msys64/usr/bin;${env:PATH}"
                },
                {
                    "name": "XDG_DATA_DIRS",
                    "value": "C:/msys64/ucrt64/share;C:/msys64/usr/share;${env:XDG_DATA_DIRS}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "HiAsm: build GTK4 Debug",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "HiAsm: Debug GTK3",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Windows_MinGW-x64-Debug/hiasm.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Windows_MinGW-x64-Debug",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;C:/msys64/usr/bin;${env:PATH}"
                },
                {
                    "name": "XDG_DATA_DIRS",
                    "value": "C:/msys64/ucrt64/share;C:/msys64/usr/share;${env:XDG_DATA_DIRS}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "preLaunchTask": "HiAsm: build GTK3 Debug",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
