if(NOT DEFINED HIASM_BINARY_DIR OR NOT DEFINED HIASM_RESOURCES_DIR OR NOT DEFINED HIASM_PACKS_DIR)
    message(FATAL_ERROR "StageRuntime.cmake requires HIASM_BINARY_DIR, HIASM_RESOURCES_DIR and HIASM_PACKS_DIR")
endif()

file(MAKE_DIRECTORY "${HIASM_BINARY_DIR}")
# Remove the pre-packs runtime directory from older staging runs.
if(EXISTS "${HIASM_BINARY_DIR}/elements")
    file(REMOVE_RECURSE "${HIASM_BINARY_DIR}/elements")
endif()

function(copy_tree source destination)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E copy_directory "${source}" "${destination}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Failed to copy ${source} to ${destination}")
    endif()
endfunction()

function(copy_file source destination)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${destination}"
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Failed to copy ${source} to ${destination}")
    endif()
endfunction()

# The runtime's auxiliary tree is assembled from the complete Core package.
# Drop a previous staged tree first so removed/renamed Core resources cannot
# survive (for example a former legacy Core resource layout).
if(EXISTS "${HIASM_BINARY_DIR}/int")
    file(REMOVE_RECURSE "${HIASM_BINARY_DIR}/int")
endif()
# Top-level resources are kept outside the Core package and overlaid below.
file(MAKE_DIRECTORY "${HIASM_BINARY_DIR}/int")
if(EXISTS "${HIASM_PACKS_DIR}/_base/cur")
    copy_tree("${HIASM_PACKS_DIR}/_base/cur" "${HIASM_BINARY_DIR}/int/cur")
endif()
if(EXISTS "${HIASM_PACKS_DIR}/_base/icon")
    copy_tree("${HIASM_PACKS_DIR}/_base/icon" "${HIASM_BINARY_DIR}/int/icons")
endif()
if(EXISTS "${HIASM_PACKS_DIR}/_base/lang")
    copy_tree("${HIASM_PACKS_DIR}/_base/lang" "${HIASM_BINARY_DIR}/int/lang")
endif()
foreach(resource hiasm.sql hiasm.db license)
    if(NOT EXISTS "${HIASM_RESOURCES_DIR}/${resource}")
        message(FATAL_ERROR "Required top-level resource is missing: ${resource}")
    endif()
    copy_file("${HIASM_RESOURCES_DIR}/${resource}" "${HIASM_BINARY_DIR}/int/${resource}")
endforeach()
foreach(icon close.png hiasm.png)
    copy_file("${HIASM_RESOURCES_DIR}/icons/${icon}" "${HIASM_BINARY_DIR}/int/${icon}")
endforeach()
if(EXISTS "${HIASM_RESOURCES_DIR}/language-specs")
    if(EXISTS "${HIASM_BINARY_DIR}/int/language-specs")
        file(REMOVE_RECURSE "${HIASM_BINARY_DIR}/int/language-specs")
    endif()
    copy_tree("${HIASM_RESOURCES_DIR}/language-specs" "${HIASM_BINARY_DIR}/int/language-specs")
endif()
get_filename_component(hiasm_source "${HIASM_PACKS_DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${HIASM_BINARY_DIR}/tools")
foreach(tool cpp_wine_tool.sh cpp_wine_gxx.sh cpp_wine_pkg_config.sh package_cpp_windows.py)
    copy_file("${hiasm_source}/tools/${tool}" "${HIASM_BINARY_DIR}/tools/${tool}")
endforeach()
if(HIASM_GTK_VERSION STREQUAL "4")
    copy_file("${HIASM_RESOURCES_DIR}/hiasm.css" "${HIASM_BINARY_DIR}/hiasm.css")
else()
    copy_file("${HIASM_RESOURCES_DIR}/gtkrc" "${HIASM_BINARY_DIR}/gtkrc")
endif()
set(splash "${HIASM_RESOURCES_DIR}/splash.png")
if(NOT EXISTS "${splash}")
    set(splash "${HIASM_RESOURCES_DIR}/icons/hiasm.png")
endif()
copy_file("${splash}" "${HIASM_BINARY_DIR}/splash.png")

# Clear the maintained Core destination before copying it so directories
# renamed in the source package (for example the former Core `int` tree) do
# not survive. Keep the generated C++ compiler and make modules in place: the
# build graph produces them directly below `packs/cpp/compiler` and `packs/cpp/make`.
if(EXISTS "${HIASM_BINARY_DIR}/packs/_base")
    file(REMOVE_RECURSE "${HIASM_BINARY_DIR}/packs/_base")
endif()
file(MAKE_DIRECTORY "${HIASM_BINARY_DIR}/packs")
# Directories that are plain copies of the sources: drop stale generated files
# after the source packages have been copied. `compiler` and `make` are not
# listed: their binaries are generated by the build itself.
foreach(copied conf code icon new example lang)
    if(EXISTS "${HIASM_BINARY_DIR}/packs/cpp/${copied}")
        file(REMOVE_RECURSE "${HIASM_BINARY_DIR}/packs/cpp/${copied}")
    endif()
endforeach()
# Keep generated example executables out of runtime distributions.
file(COPY "${HIASM_PACKS_DIR}/" DESTINATION "${HIASM_BINARY_DIR}/packs"
    PATTERN ".goutputstream*" EXCLUDE
    REGEX "/(new|example|tutorial|plugs)/build(/|$)" EXCLUDE
    REGEX "/(new|example|tutorial|plugs)/[^/]*[.](exe|o|obj|dll|so)$" EXCLUDE)
# The package-owned registration file stays in the staged packs and is applied
# below; the marked section of hiasm.sql carries the same C++ rows for profiles
# that are migrated from the full dump.
if(HIASM_SQLITE3)
    # Apply only the idempotent C++ section, not the schema and base rows of
    # the full dump. The same section is used to migrate existing profiles.
    file(READ "${HIASM_BINARY_DIR}/int/hiasm.sql" hiasm_sql)
    set(begin_marker "-- BEGIN CPP PACKAGE REGISTRATION")
    set(end_marker "-- END CPP PACKAGE REGISTRATION")
    string(FIND "${hiasm_sql}" "${begin_marker}" migration_marker)
    if(migration_marker EQUAL -1)
        message(FATAL_ERROR "C++ package registration begin marker is missing from hiasm.sql")
    endif()
    string(LENGTH "${begin_marker}" begin_marker_length)
    math(EXPR migration_begin "${migration_marker} + ${begin_marker_length}")
    string(SUBSTRING "${hiasm_sql}" ${migration_begin} -1 migration_tail)
    string(FIND "${migration_tail}" "${end_marker}" migration_end)
    if(migration_end EQUAL -1)
        message(FATAL_ERROR "C++ package registration end marker is missing from hiasm.sql")
    endif()
    string(SUBSTRING "${migration_tail}" 0 ${migration_end} package_migration)
    set(package_migration_file "${HIASM_BINARY_DIR}/int/hiasm-cpp-migration.sql")
    file(WRITE "${package_migration_file}" "${package_migration}")
    execute_process(COMMAND "${HIASM_SQLITE3}" hiasm.db ".read hiasm-cpp-migration.sql"
        WORKING_DIRECTORY "${HIASM_BINARY_DIR}/int" RESULT_VARIABLE result ERROR_VARIABLE error_text)
    file(REMOVE "${package_migration_file}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "C++ package registration failed: ${error_text}")
    endif()
endif()
# The package-owned registration file is the canonical description of the
# project types. It is idempotent and can also be applied to an existing
# profile without the full SQL dump.
if(HIASM_SQLITE3 AND EXISTS "${HIASM_BINARY_DIR}/packs/cpp/cpp_package.sql")
    execute_process(COMMAND "${HIASM_SQLITE3}" hiasm.db
        ".read ${HIASM_BINARY_DIR}/packs/cpp/cpp_package.sql"
        WORKING_DIRECTORY "${HIASM_BINARY_DIR}/int" RESULT_VARIABLE result ERROR_VARIABLE error_text)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "C++ package registration file failed: ${error_text}")
    endif()
endif()
# Recreate the compatibility resources, then overlay the maintained Core
# lessons. Never replace them with the C++ package or legacy v4 configs.
if(NOT EXISTS "${HIASM_PACKS_DIR}/_base/elements.db" AND EXISTS "${HIASM_BINARY_DIR}/packs/_base")
    file(REMOVE_RECURSE "${HIASM_BINARY_DIR}/packs/_base")
endif()
if(NOT EXISTS "${HIASM_PACKS_DIR}/_base/elements.db")
    copy_tree("${HIASM_BINARY_DIR}/packs/cpp" "${HIASM_BINARY_DIR}/packs/_base")
    file(COPY "${HIASM_PACKS_DIR}/_base/" DESTINATION "${HIASM_BINARY_DIR}/packs/_base"
        PATTERN ".goutputstream*" EXCLUDE
        REGEX "/(tutorial|plugs)/build(/|$)" EXCLUDE
        REGEX "/(tutorial|plugs)/[^/]*[.](exe|o|obj|dll|so)$" EXCLUDE)
endif()
# Clean only the staged copies left by older staging scripts.
file(GLOB pack_dirs LIST_DIRECTORIES true "${HIASM_BINARY_DIR}/packs/*")
foreach(pack_dir IN LISTS pack_dirs)
    foreach(kind new example)
        if(EXISTS "${pack_dir}/${kind}/build")
            file(REMOVE_RECURSE "${pack_dir}/${kind}/build")
        endif()
        file(GLOB generated_files "${pack_dir}/${kind}/*.exe" "${pack_dir}/${kind}/*.o"
            "${pack_dir}/${kind}/*.obj" "${pack_dir}/${kind}/*.dll" "${pack_dir}/${kind}/*.so")
        if(generated_files)
            file(REMOVE ${generated_files})
        endif()
    endforeach()
endforeach()
if(HIASM_SQLITE3)
    set(cpp_dir "${HIASM_BINARY_DIR}/packs/cpp")
    file(REMOVE "${cpp_dir}/elements.db")
    execute_process(COMMAND "${HIASM_SQLITE3}" elements.db ".read elements.sql"
        WORKING_DIRECTORY "${cpp_dir}" RESULT_VARIABLE result ERROR_VARIABLE error_text)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "C++ element database failed: ${error_text}")
    endif()
    if(NOT EXISTS "${HIASM_PACKS_DIR}/_base/elements.db")
        copy_file("${cpp_dir}/elements.db" "${HIASM_BINARY_DIR}/packs/_base/elements.db")
    endif()
endif()
if(CMAKE_HOST_WIN32 AND HIASM_GTK_VERSION STREQUAL "4" AND
   EXISTS "${HIASM_GTK4_RUNTIME_DIR}/libgtk-4-1.dll")
    copy_file("${HIASM_GTK4_RUNTIME_DIR}/libgtk-4-1.dll" "${HIASM_BINARY_DIR}/libgtk-4-1.dll")
    if(NOT EXISTS "${HIASM_GTK4_RUNTIME_DIR}/libaccesskit-c-0.18.dll")
        message(FATAL_ERROR "Local GTK4 runtime needs AccessKit; run tools/build_gtk4_runtime.ps1")
    endif()
    copy_file("${HIASM_GTK4_RUNTIME_DIR}/libaccesskit-c-0.18.dll" "${HIASM_BINARY_DIR}/libaccesskit-c-0.18.dll")
endif()

# The editor can leave GIO atomic-write droppings in pack folders if it is
# interrupted. They are not part of a pack and must not reach an installer.
file(GLOB_RECURSE stale_pack_files "${HIASM_BINARY_DIR}/packs/.goutputstream*")
if(stale_pack_files)
    file(REMOVE ${stale_pack_files})
endif()

